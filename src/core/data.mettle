//! MpSeries, the old chart engine's growable (x, y) columns, and extent helpers over it
//! (MpExtent itself lives in core/extent). A series copies its name; push and set never
//! leave it half grown. xs and ys move when a push grows the series, so re-read them after
//! every push. Uses core/buf (error codes), core/extent, std/mem and std/conv.

import "std/mem";
import "std/conv";
import "mistplot/core/buf";
import "mistplot/core/extent";

/// A named pair of growable float64 columns.
///
/// @mem Owns name, xs and ys; mp_series_free releases them. xs and ys are reallocated when
///   a push grows the series.
export struct MpSeries {
  name: string;   /// owned copy of the series name
  xs: float64*;   /// x column, n used of cap
  ys: float64*;   /// y column, n used of cap
  n: int64;       /// samples in use
  cap: int64;     /// samples allocated
}

const MP_SERIES_DEFAULT_CAP: int64 = 16;

/// A new empty series.
///
/// @param name Series name. Valid: any; copied.
/// @param cap Initial capacity. Units: samples. Valid: <= MP_MAX_COUNT; <= 0 uses 16.
/// @return The series, or 0 when cap is too large or an allocation failed.
/// @mem The caller owns the series and releases it with mp_series_free; name is copied.
/// @thread Safe from any thread.
export fn mp_series_new(name: string, cap: int64) -> MpSeries* {
  if (cap > MP_MAX_COUNT) { return 0; }
  var c: int64 = cap;
  if (c <= 0) { c = MP_SERIES_DEFAULT_CAP; }
  var s: MpSeries* = (MpSeries*)malloc(sizeof(MpSeries));
  if (s == 0) { return 0; }
  var xs: float64* = (float64*)malloc(c * 8);
  if (xs == 0) {
    free(s);
    return 0;
  }
  var ys: float64* = (float64*)malloc(c * 8);
  if (ys == 0) {
    free(xs);
    free(s);
    return 0;
  }
  s->xs = xs;
  s->ys = ys;
  s->n = 0;
  s->cap = c;
  var len: int64 = (int64)name.length;
  if (len == 0) {
    s->name = "";
  } else {
    var nb: uint8* = (uint8*)malloc(len);
    if (nb == 0) {
      free(xs);
      free(ys);
      free(s);
      return 0;
    }
    var i: int64 = 0;
    while (i < len) {
      nb[i] = name.chars[i];
      i = i + 1;
    }
    s->name = str_from_bytes((cstring)nb, len);
  }
  return s;
}

/// A new series holding a copy of the first n pairs of two columns.
///
/// @param name Series name. Valid: any; copied.
/// @param xs x column. Valid: n readable values; may be 0 when n is 0.
/// @param ys y column. Valid: n readable values; may be 0 when n is 0.
/// @param n Pairs to copy. Valid: 0 .. MP_MAX_COUNT; otherwise 0 is returned.
/// @return The series, or 0 on a bad argument or allocation failure.
/// @mem The caller owns the series (free with mp_series_free); the columns stay the caller's.
/// @thread Safe from any thread.
/// @cost O(n).
export fn mp_series_from_columns(name: string, xs: float64*, ys: float64*,
                                 n: int64) -> MpSeries* {
  if (n < 0 || n > MP_MAX_COUNT) { return 0; }
  if (n > 0 && (xs == 0 || ys == 0)) { return 0; }
  var s: MpSeries* = mp_series_new(name, n);
  if (s == 0) { return 0; }
  var i: int64 = 0;
  while (i < n) {
    s->xs[i] = xs[i];
    s->ys[i] = ys[i];
    i = i + 1;
  }
  s->n = n;
  return s;
}

/// Releases a series, its columns and its name.
///
/// @param s The series. Valid: from mp_series_new / mp_series_from_columns, or 0.
/// @mem s is invalid afterwards.
/// @thread One thread at a time per series.
export fn mp_series_free(s: MpSeries*) {
  if (s == 0) { return; }
  if (s->xs != 0) { free(s->xs); }
  if (s->ys != 0) { free(s->ys); }
  if ((int64)s->name.length > 0) { free(s->name.chars); }
  free(s);
}

/// Releases the contents of an array of series values (not the array itself).
///
/// @param list The array. Valid: n initialised series values, or 0 (ignored).
/// @param n Entries. Valid: >= 0.
/// @mem Every entry's columns and name are freed; the array stays the caller's.
/// @thread One thread at a time per array.
export fn mp_series_free_all(list: MpSeries*, n: int32) {
  if (list == 0) { return; }
  var i: int32 = 0;
  while (i < n) {
    var it: MpSeries = list[(int64)i];
    if (it.xs != 0) { free(it.xs); }
    if (it.ys != 0) { free(it.ys); }
    if ((int64)it.name.length > 0) { free(it.name.chars); }
    i = i + 1;
  }
}

// Grows to hold `need` more points. Two `realloc`s would leave the series half
// grown when the second column fails, so both columns are allocated with
// malloc first and the old ones are released only after both succeeded: a
// failed push leaves n, cap and both column contents exactly as they were.
// Growth past MP_MAX_COUNT points is MP_ERR_ALLOC (the doubling and the byte
// count could otherwise wrap).
fn mp_series_grow(s: MpSeries*, need: int64) -> int32 {
  if (need < 0) { return MP_ERR_ARG; }
  if (need > MP_MAX_COUNT - s->n) { return MP_ERR_ALLOC; }
  if (s->n + need <= s->cap) { return MP_OK; }
  var ncap: int64 = s->cap;
  if (ncap < MP_SERIES_DEFAULT_CAP) { ncap = MP_SERIES_DEFAULT_CAP; }
  while (ncap < s->n + need) { ncap = ncap * 2; }
  if (ncap > MP_MAX_COUNT) { ncap = MP_MAX_COUNT; }
  var nx: float64* = (float64*)malloc(ncap * 8);
  if (nx == 0) { return MP_ERR_ALLOC; }
  var ny: float64* = (float64*)malloc(ncap * 8);
  if (ny == 0) {
    free(nx);
    return MP_ERR_ALLOC;
  }
  var i: int64 = 0;
  while (i < s->n) {
    nx[i] = s->xs[i];
    ny[i] = s->ys[i];
    i = i + 1;
  }
  if (s->xs != 0) { free(s->xs); }
  if (s->ys != 0) { free(s->ys); }
  s->xs = nx;
  s->ys = ny;
  s->cap = ncap;
  return MP_OK;
}

/// Appends one sample.
///
/// @param s The series. Valid: non-zero.
/// @param x Sample x. Units: data units. Valid: any.
/// @param y Sample y. Units: data units. Valid: any.
/// @return MP_OK, or an error code.
/// @error MP_ERR_ARG s is 0; nothing changes.
/// @error MP_ERR_ALLOC growth failed or would pass MP_MAX_COUNT; the series is unchanged.
/// @mem May move xs and ys.
/// @thread One thread at a time per series.
/// @cost Amortized O(1).
export fn mp_series_push(s: MpSeries*, x: float64, y: float64) -> int32 {
  if (s == 0) { return MP_ERR_ARG; }
  var rc: int32 = mp_series_grow(s, 1);
  if (rc != MP_OK) { return rc; }
  s->xs[s->n] = x;
  s->ys[s->n] = y;
  s->n = s->n + 1;
  return MP_OK;
}

/// Overwrites sample i.
///
/// @param s The series. Valid: non-zero.
/// @param i Sample index. Valid: 0 .. n-1.
/// @param x New x. Units: data units. Valid: any.
/// @param y New y. Units: data units. Valid: any.
/// @return MP_OK, or an error code.
/// @error MP_ERR_ARG s is 0 or i is out of range; nothing changes.
/// @mem Nothing is retained.
/// @thread One thread at a time per series.
export fn mp_series_set(s: MpSeries*, i: int64, x: float64,
                        y: float64) -> int32 {
  if (s == 0) { return MP_ERR_ARG; }
  if (i < 0 || i >= s->n) { return MP_ERR_ARG; }
  s->xs[i] = x;
  s->ys[i] = y;
  return MP_OK;
}

/// An extent widened on each side by a fraction of its span (zero spans stay put).
///
/// @param e The extent. Valid: any; an invalid extent is returned unchanged.
/// @param frac Fraction of the span added on each side. Valid: >= 0.
/// @return The padded extent.
export fn mp_extent_pad(e: MpExtent, frac: float64) -> MpExtent {
  var r: MpExtent = e;
  if (!e.valid) { return r; }
  var sx: float64 = e.max_x - e.min_x;
  var sy: float64 = e.max_y - e.min_y;
  if (sx > 0.0) {
    r.min_x = e.min_x - frac * sx;
    r.max_x = e.max_x + frac * sx;
  }
  if (sy > 0.0) {
    r.min_y = e.min_y - frac * sy;
    r.max_y = e.max_y + frac * sy;
  }
  return r;
}

/// The extent of a series' finite samples.
///
/// @param s The series. Valid: any; 0 gives an invalid extent.
/// @return The extent.
/// @mem s is only read.
/// @thread Safe while no thread writes s.
/// @cost O(n).
export fn mp_series_extent(s: MpSeries*) -> MpExtent {
  var e: MpExtent = mp_extent_empty();
  if (s == 0) { return e; }
  var i: int64 = 0;
  while (i < s->n) {
    mp_extent_add(&e, s->xs[i], s->ys[i]);
    i = i + 1;
  }
  return e;
}
