// core/text — the text measurement seam.
//
// Dependencies: none (pure arithmetic; no std import, no allocation). Layout
// measures through this module only, so a real font backend (mythic) can be
// injected later without touching chart/layout.
//
// Default heuristic (docs/02-seams.md §1): width = length * size * 0.58,
// height = size * 1.2. An injected measurer replaces the *width* only; it is a
// bare fn pointer plus an opaque context — no closures, no allocation. The
// seam is process-global by design (there is one render at a time) and
// mp_text_set_measure(0, 0) restores the default.

var mp_text_fn: fn(rawptr, string, float64) -> float64 = 0;
var mp_text_ctx: rawptr = 0;

export fn mp_text_width(s: string, size: float64) -> float64 {
  if (mp_text_fn != 0) { return mp_text_fn(mp_text_ctx, s, size); }
  return (float64)s.length * size * 0.58;
}

export fn mp_text_height(size: float64) -> float64 {
  return size * 1.2;
}

export fn mp_text_set_measure(f: fn(rawptr, string, float64) -> float64,
                              ctx: rawptr) {
  mp_text_fn = f;
  mp_text_ctx = ctx;
}

export fn mp_text_measure_active() -> bool {
  return mp_text_fn != 0;
}
