// core/text — the text measurement seam.
//
// Dependencies: none (pure arithmetic; no std import, no allocation). Layout
// measures through this module only, so a real font backend (mythic) can be
// injected later without touching chart/layout.
//
// Default heuristic: width = length * size * 0.58, height = size * 1.2. An
// injected measurer replaces the *width* only; it is a bare fn pointer plus an
// opaque context — no closures, no allocation. The measurer is process-global
// by design (there is one render at a time).
// mp_text_reset_measure restores the default (a literal 0 does not type-check
// as a fn argument, so mp_text_set_measure(0, 0) is not the way). A host that
// installs its own measurer for one render saves the previous one with
// mp_text_measure_fn / mp_text_measure_ctx and puts it back afterwards with
// mp_text_set_measure, so nested or foreign measurers survive.

var mp_text_fn: fn(rawptr, string, float64) -> float64 = 0;
var mp_text_ctx: rawptr = 0;

export fn mp_text_width(s: string, size: float64) -> float64 {
  if (mp_text_fn != 0) { return mp_text_fn(mp_text_ctx, s, size); }
  return (float64)s.length * size * 0.58;
}

export fn mp_text_height(size: float64) -> float64 {
  return size * 1.2;
}

export fn mp_text_set_measure(f: fn(rawptr, string, float64) -> float64,
                              ctx: rawptr) {
  mp_text_fn = f;
  mp_text_ctx = ctx;
}

export fn mp_text_measure_active() -> bool {
  return mp_text_fn != 0;
}

// Restores the default heuristic.
export fn mp_text_reset_measure() {
  mp_text_fn = 0;
  mp_text_ctx = 0;
}

// The installed measurer (a zero fn value when the default is active) and its
// context, for save / restore around a render.
export fn mp_text_measure_fn() -> fn(rawptr, string, float64) -> float64 {
  return mp_text_fn;
}

export fn mp_text_measure_ctx() -> rawptr {
  return mp_text_ctx;
}
