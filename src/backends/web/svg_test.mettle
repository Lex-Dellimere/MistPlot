// backends/web/svg_test — the serialization contract of backends/web/svg.
//
// Pure: scenes are built directly with mp_scene_* (chart/ is not imported: the
// backend's input is the display list). Every fixture asserts a whole
// document, not a substring, wherever the whole document is knowable; the
// injection/escaping test asserts both the escaped form's presence and the
// payload's absence, so a serializer that dropped the text instead of
// escaping it still fails.
//
// Expected documents are assembled in an MpBuf (`wp`/`wo`/`wc`) instead of
// built with `+`, because `mettle test` runs in the compile-time interpreter
// and a runtime string concatenation puts `mettle_string_free` in the call
// graph, which makes it skip the whole test. A long expected line is split
// across two `wp` calls where the 100-column limit demands it; the bytes in
// the buffer are the same either way.
//
// The determinism check renders one scene twice into two separately allocated
// buffers (initial capacities 64 and 8192, so the growth history differs) and
// compares the strings with `==`: the golden file depends on byte identity.

import "std/math";
import "std/conv";
import "mistplot/harness";
import "mistplot/core/buf";
import "mistplot/core/color";
import "mistplot/core/geom";
import "mistplot/renderer/scene";
import "mistplot/renderer/backend";
import "mistplot/backends/web/svg";

// `str_find(s, needle) == None` is the natural spelling of an absence, but
// this compiler build ICEs on Option equality at codegen ("Direct object
// backend cannot compile function ... (indirect_agg_byname)"), so the same
// predicate is written with a match, which builds and interprets cleanly.
fn absent(hay: string, needle: string) -> bool {
  var at: Option<int64> = str_find(hay, needle);
  var found: bool = false;
  match (at) {
    case Some(_pos): { found = true; }
    case None: { found = false; }
  }
  return !found;
}

fn new_scene() -> MpScene* {
  var sc: MpScene* = mp_scene_new();
  mp_expect("scene allocated", sc != 0);
  return sc;
}

fn new_buf(cap: int64) -> MpBuf* {
  var b: MpBuf* = mp_buf_new(cap);
  mp_expect("buffer allocated", b != 0);
  return b;
}

// ------------------------------------------------- expected-document builder

fn wp(b: MpBuf*, s: string) {
  if (mp_buf_puts(b, s) != MP_OK) {
    mp_expect("expected document append", false);
  }
}

fn wo(b: MpBuf*, w: string, h: string) {
  wp(b, "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ");
  wp(b, w);
  wp(b, " ");
  wp(b, h);
  wp(b, "\" width=\"");
  wp(b, w);
  wp(b, "\" height=\"");
  wp(b, h);
  wp(b, "\" role=\"img\">\n");
}

fn wc(b: MpBuf*) {
  wp(b, "</svg>\n");
}

// Renders sc and returns the document (borrowed from b).
fn rd(sc: MpScene*, w: float64, h: float64, b: MpBuf*) -> string {
  var o: MpRenderOpts = mp_render_opts(w, h, mp_theme_light());
  var rc: int32 = mp_svg_render(sc, &o, b);
  mp_expect_i64("mp_svg_render returns MP_OK", (int64)rc, (int64)MP_OK);
  return mp_buf_str(b);
}

fn add_rect(sc: MpScene*, x: float64, y: float64, w: float64, h: float64,
            fill: MpColor, stroke: MpColor, stroke_w: float64, cls: int32) {
  var rc: int32 = mp_scene_rect(sc, mp_rect(x, y, w, h), fill, stroke,
                                stroke_w, cls);
  mp_expect_i64("scene rect added", (int64)rc, (int64)MP_OK);
}

fn add_text(sc: MpScene*, x: float64, y: float64, s: string, size: float64,
            align: int32, cls: int32) {
  var rc: int32 = mp_scene_text(sc, x, y, s, size, mp_theme_light().fg, align,
                                cls);
  mp_expect_i64("scene text added", (int64)rc, (int64)MP_OK);
}

// `  <rect x="0" y="0" width="1" height="1" fill="#010203" class="mp-c-<cls>"`.
fn cls_rect(b: MpBuf*, cls: string) {
  wp(b, "  <rect x=\"0\" y=\"0\" width=\"1\" height=\"1\" fill=\"#010203\"");
  wp(b, " class=\"mp-c-");
  wp(b, cls);
  wp(b, "\" />\n");
}

// `  <rect x="<x>" y="0" width="1" height="1" fill="#010203" class="mp-c-plot"`.
fn plot_rect(b: MpBuf*, x: string) {
  wp(b, "  <rect x=\"");
  wp(b, x);
  wp(b, "\" y=\"0\" width=\"1\" height=\"1\" fill=\"#010203\"");
  wp(b, " class=\"mp-c-plot\" />\n");
}

// `  <rect x="<x>" y="0" width="1" height="1" fill="#ff0000" class="<cls>"`.
fn red_rect(b: MpBuf*, x: string, cls: string) {
  wp(b, "  <rect x=\"");
  wp(b, x);
  wp(b, "\" y=\"0\" width=\"1\" height=\"1\" fill=\"#ff0000\" class=\"");
  wp(b, cls);
  wp(b, "\" />\n");
}

// A 1x1 rect line with a caller-supplied paint clause, for colour fixtures.
fn paint_rect(b: MpBuf*, x: string, paint: string) {
  wp(b, "  <rect x=\"");
  wp(b, x);
  wp(b, "\" y=\"0\" width=\"1\" height=\"1\"");
  wp(b, paint);
  wp(b, " class=\"mp-c-tick\" />\n");
}

// ---------------------------------------------------------------- root

fn check_empty_document() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(256);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  mp_expect_i64("empty scene has no nodes", mp_scene_count(sc), (int64)0);
  wo(wb, "10", "10");
  wc(wb);
  // Prefill: mp_svg_render owns `out` and must start from an empty buffer.
  mp_expect_i64("prefill", (int64)mp_buf_puts(b, "STALE BYTES"),
                (int64)MP_OK);
  var doc: string = rd(sc, 10.0, 10.0, b);
  mp_expect_str("empty document is one empty root", doc, mp_buf_str(wb));
  mp_expect_i64("empty document has two newlines", str_count(doc, "\n"),
                (int64)2);
  mp_expect("empty document drops stale bytes", absent(doc, "STALE"));
  mp_expect_i64("root is the only svg start", str_count(doc, "<svg"),
                (int64)1);
  mp_expect_i64("root is closed exactly once", str_count(doc, "</svg>"),
                (int64)1);
}

fn check_viewport() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(256);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);

  // Fractional logical size: width/height and the viewBox share a formatter.
  wo(wb, "640.5", "400.25");
  wc(wb);
  mp_expect_str("fractional viewport", rd(sc, 640.5, 400.25, b),
                mp_buf_str(wb));

  mp_buf_clear(wb);
  wo(wb, "0", "0");
  wc(wb);
  mp_expect_str("non-finite viewport clamps to 0", rd(sc, NAN(), INF(), b),
                mp_buf_str(wb));

  mp_buf_clear(wb);
  wo(wb, "-12.5", "8");
  wc(wb);
  mp_expect_str("negative viewport keeps its sign", rd(sc, -12.5, 8.0, b),
                mp_buf_str(wb));
}

// ---------------------------------------------------------------- classes

fn check_base_classes() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(1024);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  var k: int32 = 0;
  while (k < 8) {
    add_rect(sc, 0.0, 0.0, 1.0, 1.0, mp_color(1, 2, 3), mp_color_a(0, 0, 0, 0),
             0.0, k);
    k = k + 1;
  }
  wo(wb, "8", "8");
  cls_rect(wb, "bg");
  cls_rect(wb, "plot");
  cls_rect(wb, "grid");
  cls_rect(wb, "axis");
  cls_rect(wb, "tick");
  cls_rect(wb, "label");
  cls_rect(wb, "title");
  cls_rect(wb, "legend");
  wc(wb);
  mp_expect_str("eight base classes in painter order",
                rd(sc, 8.0, 8.0, b), mp_buf_str(wb));
  mp_expect_i64("root plus one line per node plus close",
                str_count(mp_buf_str(wb), "\n"), (int64)10);
}

fn check_series_classes() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(1024);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  var red: MpColor = mp_color(255, 0, 0);
  var none: MpColor = mp_color_a(0, 0, 0, 0);
  add_rect(sc, 0.0, 0.0, 1.0, 1.0, red, none, 0.0, MP_CLS_SERIES);
  add_rect(sc, 1.0, 0.0, 1.0, 1.0, red, none, 0.0, MP_CLS_SERIES + 3);
  add_rect(sc, 2.0, 0.0, 1.0, 1.0, red, none, 0.0, MP_CLS_SERIES + 100);
  // A class below the base range (the chart layer never emits one) keeps its
  // number instead of being renamed onto a base class.
  add_rect(sc, 3.0, 0.0, 1.0, 1.0, red, none, 0.0, -1);
  wo(wb, "5", "5");
  red_rect(wb, "0", "mp-c-series mp-s-0");
  red_rect(wb, "1", "mp-c-series mp-s-3");
  red_rect(wb, "2", "mp-c-series mp-s-100");
  red_rect(wb, "3", "mp-c--1");
  wc(wb);
  mp_expect_str("series class encoding", rd(sc, 5.0, 5.0, b),
                mp_buf_str(wb));
}

// ---------------------------------------------------------------- numbers

fn check_numbers() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(2048);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  var fill: MpColor = mp_color(1, 2, 3);
  var none: MpColor = mp_color_a(0, 0, 0, 0);
  add_rect(sc, 1.23456, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, -0.0, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 1e-9, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 0.0005, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, -3.5, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 123456789012345.0, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 1e15, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 0.0 - 1e15, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, NAN(), 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, INF(), 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 0.0 - INF(), 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  add_rect(sc, 2.5, 0.0, 1.0, 1.0, fill, none, 0.0, MP_CLS_PLOT);
  wo(wb, "12", "12");
  plot_rect(wb, "1.235");
  plot_rect(wb, "0");
  plot_rect(wb, "0");
  plot_rect(wb, "0.001");
  plot_rect(wb, "-3.5");
  plot_rect(wb, "123456789012345");
  plot_rect(wb, "0");
  plot_rect(wb, "0");
  plot_rect(wb, "0");
  plot_rect(wb, "0");
  plot_rect(wb, "0");
  plot_rect(wb, "2.5");
  wc(wb);
  var doc: string = rd(sc, 12.0, 12.0, b);
  mp_expect_str("number formatting", doc, mp_buf_str(wb));
  mp_expect("no scientific notation", absent(doc, "e+"));
  mp_expect("no scientific notation either", absent(doc, "e-"));
  mp_expect("no NaN token", absent(doc, "NaN"));
  mp_expect("no inf token", absent(doc, "inf"));
  mp_expect("no negative zero", absent(doc, "x=\"-0\""));
}

// ---------------------------------------------------------------- paint

fn check_paint_order() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(512);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  add_rect(sc, 4.0, 5.0, 6.0, 7.0, mp_color_a(255, 0, 0, 200),
           mp_color_a(0, 255, 0, 51), 2.0, MP_CLS_SERIES + 3);
  var nd: MpNode* = mp_scene_node(sc, 0);
  mp_expect("paint fixture node borrowed", nd != 0);
  if (nd == 0) { return; }
  nd->opacity = 0.5;
  wo(wb, "16", "16");
  wp(wb, "  <rect x=\"4\" y=\"5\" width=\"6\" height=\"7\"");
  wp(wb, " fill=\"rgba(255,0,0,0.784)\"");
  wp(wb, " stroke=\"rgba(0,255,0,0.200)\" stroke-width=\"2\"");
  wp(wb, " opacity=\"0.5\" class=\"mp-c-series mp-s-3\" />\n");
  wc(wb);
  mp_expect_str("fill stroke stroke-width opacity order",
                rd(sc, 16.0, 16.0, b), mp_buf_str(wb));
}

fn check_omissions() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(512);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  // stroke_w == 0 hides a stroke colour that is otherwise present.
  add_rect(sc, 0.0, 0.0, 1.0, 1.0, mp_color(255, 0, 0), mp_color(0, 255, 0),
           0.0, MP_CLS_PLOT);
  // fill.a == 0 is written fill="none" (an SVG rect's default fill is black);
  // the stroke survives.
  add_rect(sc, 1.0, 1.0, 1.0, 1.0, mp_color_a(0, 0, 0, 0),
           mp_color(0, 255, 0), 1.0, MP_CLS_AXIS);
  // opacity == 0 is not 1.0, so it is emitted.
  add_rect(sc, 2.0, 2.0, 1.0, 1.0, mp_color(255, 0, 0), mp_color_a(0, 0, 0, 0),
           0.0, MP_CLS_PLOT);
  var nd: MpNode* = mp_scene_node(sc, 2);
  mp_expect("omission fixture node borrowed", nd != 0);
  if (nd == 0) { return; }
  nd->opacity = 0.0;
  wo(wb, "12", "12");
  wp(wb, "  <rect x=\"0\" y=\"0\" width=\"1\" height=\"1\" fill=\"#ff0000\"");
  wp(wb, " class=\"mp-c-plot\" />\n");
  wp(wb, "  <rect x=\"1\" y=\"1\" width=\"1\" height=\"1\" fill=\"none\"");
  wp(wb, " stroke=\"#00ff00\" stroke-width=\"1\" class=\"mp-c-axis\" />\n");
  wp(wb, "  <rect x=\"2\" y=\"2\" width=\"1\" height=\"1\" fill=\"#ff0000\"");
  wp(wb, " opacity=\"0\" class=\"mp-c-plot\" />\n");
  wc(wb);
  var doc: string = rd(sc, 12.0, 12.0, b);
  mp_expect_str("stroke/fill/opacity omissions", doc, mp_buf_str(wb));
  mp_expect("zero stroke width never reaches the markup",
            absent(doc, "stroke-width=\"0\""));
  mp_expect("full opacity is omitted", absent(doc, "opacity=\"1\""));
}

fn check_colors() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(1024);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  var none: MpColor = mp_color_a(0, 0, 0, 0);
  add_rect(sc, 0.0, 0.0, 1.0, 1.0, mp_color_a(255, 0, 0, 200), none, 0.0, 4);
  add_rect(sc, 1.0, 0.0, 1.0, 1.0, mp_color_a(255, 0, 0, 51), none, 0.0, 4);
  add_rect(sc, 2.0, 0.0, 1.0, 1.0, mp_color_a(255, 0, 0, 128), none, 0.0, 4);
  add_rect(sc, 3.0, 0.0, 1.0, 1.0, mp_color_a(255, 0, 0, 1), none, 0.0, 4);
  add_rect(sc, 4.0, 0.0, 1.0, 1.0, mp_color_a(255, 0, 0, 255), none, 0.0, 4);
  wo(wb, "5", "5");
  paint_rect(wb, "0", " fill=\"rgba(255,0,0,0.784)\"");
  paint_rect(wb, "1", " fill=\"rgba(255,0,0,0.200)\"");
  paint_rect(wb, "2", " fill=\"rgba(255,0,0,0.502)\"");
  paint_rect(wb, "3", " fill=\"rgba(255,0,0,0.004)\"");
  paint_rect(wb, "4", " fill=\"#ff0000\"");
  wc(wb);
  mp_expect_str("colour alpha serialization", rd(sc, 5.0, 5.0, b),
                mp_buf_str(wb));

  // The stroke path uses the same colour writer.
  var sc2: MpScene* = new_scene();
  var wb2: MpBuf* = new_buf(512);
  var b2: MpBuf* = new_buf(64);
  if (sc2 == 0 || wb2 == 0 || b2 == 0) { return; }
  defer mp_scene_free(sc2);
  defer mp_buf_free(wb2);
  defer mp_buf_free(b2);
  add_rect(sc2, 0.0, 1.0, 1.0, 1.0, none, mp_color_a(0, 0, 0, 200), 1.0, 4);
  wo(wb2, "5", "5");
  wp(wb2, "  <rect x=\"0\" y=\"1\" width=\"1\" height=\"1\" fill=\"none\"");
  wp(wb2, " stroke=\"rgba(0,0,0,0.784)\" stroke-width=\"1\"");
  wp(wb2, " class=\"mp-c-tick\" />\n");
  wc(wb2);
  mp_expect_str("stroke alpha serialization", rd(sc2, 5.0, 5.0, b2),
                mp_buf_str(wb2));
}

// ---------------------------------------------------------------- text

fn check_text() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(1024);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  add_text(sc, 100.0, 20.0, "A & B <script>alert(\"x\")&'", 12.0,
           MP_ALIGN_CENTER, MP_CLS_TITLE);
  add_text(sc, 0.0, 100.0, "ok", 11.5, MP_ALIGN_START, MP_CLS_TICK);
  add_text(sc, 10.0, 0.0, "", 12.0, MP_ALIGN_END, MP_CLS_LEGEND);
  wo(wb, "200", "40");
  // Baseline is top + size*0.8: 20 + 9.6 = 29.6.
  wp(wb, "  <text x=\"100\" y=\"29.6\" fill=\"#1f2933\"");
  wp(wb, " font-family=\"system-ui, sans-serif\" font-size=\"12\"");
  wp(wb, " text-anchor=\"middle\" class=\"mp-c-title\">");
  wp(wb, "A &amp; B &lt;script&gt;alert(&quot;x&quot;)&amp;&#39;");
  wp(wb, "</text>\n");
  wp(wb, "  <text x=\"0\" y=\"109.2\" fill=\"#1f2933\"");
  wp(wb, " font-family=\"system-ui, sans-serif\" font-size=\"11.5\"");
  wp(wb, " text-anchor=\"start\" class=\"mp-c-tick\">ok</text>\n");
  wp(wb, "  <text x=\"10\" y=\"9.6\" fill=\"#1f2933\"");
  wp(wb, " font-family=\"system-ui, sans-serif\" font-size=\"12\"");
  wp(wb, " text-anchor=\"end\" class=\"mp-c-legend\"></text>\n");
  wc(wb);
  mp_expect_str("text escaping, anchors and baseline", rd(sc, 200.0, 40.0, b),
                mp_buf_str(wb));
}

fn check_injection() {
  var sc: MpScene* = new_scene();
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(b);
  add_text(sc, 0.0, 0.0, "<script>alert('pwn')</script>", 12.0, MP_ALIGN_START,
           MP_CLS_TITLE);
  add_text(sc, 0.0, 20.0, "&amp; stays an entity", 12.0, MP_ALIGN_START,
           MP_CLS_TICK);
  add_text(sc, 0.0, 40.0, "a&b>c\"d'e", 12.0, MP_ALIGN_START, MP_CLS_LABEL);
  var doc: string = rd(sc, 120.0, 60.0, b);
  // Negatives: no live markup, no attribute escape, no script, no ids.
  mp_expect("no script element", absent(doc, "<script"));
  mp_expect("no closing script", absent(doc, "</script"));
  mp_expect("no bare attribute quote", absent(doc, "\"><svg"));
  mp_expect("no id attribute", absent(doc, "id=\""));
  mp_expect("no style attribute", absent(doc, "style="));
  mp_expect("no javascript scheme", absent(doc, "javascript:"));
  mp_expect("no onload handler", absent(doc, "onload="));
  // Positives: the payload is present, inert and byte-exact.
  mp_expect("single-quoted script payload escaped",
            !absent(doc, "&lt;script&gt;alert(&#39;pwn&#39;)&lt;/script&gt;"));
  mp_expect("literal entity is double-escaped",
            !absent(doc, "&amp;amp; stays an entity"));
  mp_expect("five entities escaped",
            !absent(doc, "a&amp;b&gt;c&quot;d&#39;e"));
  mp_expect_i64("text element count is three", str_count(doc, "<text"),
                (int64)3);
}

// ---------------------------------------------------------------- shapes

fn check_shapes() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(1024);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  var rc: int32 = mp_scene_line(sc, 0.0, 0.0, 10.0, 40.0,
                                mp_color(156, 163, 175), 2.0, MP_CLS_AXIS);
  mp_expect_i64("line added", (int64)rc, (int64)MP_OK);
  rc = mp_scene_circle(sc, 5.0, 6.0, 3.0, mp_palette_color(0),
                       mp_color_a(0, 0, 0, 0), 0.0, MP_CLS_SERIES);
  mp_expect_i64("circle added", (int64)rc, (int64)MP_OK);
  var xs: float64[3];
  var ys: float64[3];
  xs[0] = 0.0;
  ys[0] = 10.0;
  xs[1] = 5.0;
  ys[1] = 0.0;
  xs[2] = 10.0;
  ys[2] = 10.0;
  rc = mp_scene_poly(sc, &xs[0], &ys[0], 3, mp_palette_color(1), 1.5,
                     MP_CLS_SERIES + 1);
  mp_expect_i64("poly added", (int64)rc, (int64)MP_OK);
  wo(wb, "20", "20");
  wp(wb, "  <line x1=\"0\" y1=\"0\" x2=\"10\" y2=\"40\" stroke=\"#9ca3af\"");
  wp(wb, " stroke-width=\"2\" class=\"mp-c-axis\" />\n");
  wp(wb, "  <circle cx=\"5\" cy=\"6\" r=\"3\" fill=\"#4e79a7\"");
  wp(wb, " class=\"mp-c-series mp-s-0\" />\n");
  // A polyline's default fill is black: a stroke-only series says fill="none".
  wp(wb, "  <polyline points=\"0,10 5,0 10,10\" fill=\"none\" stroke=\"#f28e2b\"");
  wp(wb, " stroke-width=\"1.5\" class=\"mp-c-series mp-s-1\" />\n");
  wc(wb);
  mp_expect_str("line, circle and polyline", rd(sc, 20.0, 20.0, b),
                mp_buf_str(wb));
}

fn check_degenerate_shapes() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(512);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  // A one-point polyline is legal in the scene: one coordinate pair.
  var xs: float64[1];
  var ys: float64[1];
  xs[0] = 7.5;
  ys[0] = 8.25;
  var rc: int32 = mp_scene_poly(sc, &xs[0], &ys[0], 1, mp_color(1, 2, 3), 1.0,
                                MP_CLS_SERIES);
  mp_expect_i64("one point poly added", (int64)rc, (int64)MP_OK);
  // An empty polyline has no point range and is skipped, not fatal.
  rc = mp_scene_poly(sc, 0, 0, 0, mp_color(1, 2, 3), 1.0, MP_CLS_SERIES);
  mp_expect_i64("empty poly added", (int64)rc, (int64)MP_OK);
  wo(wb, "10", "10");
  wp(wb, "  <polyline points=\"7.5,8.25\" fill=\"none\" stroke=\"#010203\"");
  wp(wb, " stroke-width=\"1\" class=\"mp-c-series mp-s-0\" />\n");
  wc(wb);
  mp_expect_str("degenerate polylines", rd(sc, 10.0, 10.0, b),
                mp_buf_str(wb));
}

// SVG's initial fill is black, so a shape with a transparent fill must say
// fill="none"; otherwise every line chart's polyline fills its implied polygon
// black. A LINE has no interior and keeps omitting fill.
fn check_transparent_fill() {
  var sc: MpScene* = new_scene();
  var wb: MpBuf* = new_buf(512);
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || wb == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(wb);
  defer mp_buf_free(b);
  var none: MpColor = mp_color_a(0, 0, 0, 0);
  var rc: int32 = mp_scene_circle(sc, 5.0, 5.0, 2.0, none, mp_color(1, 2, 3),
                                  1.0, MP_CLS_SERIES);
  mp_expect_i64("transparent circle added", (int64)rc, (int64)MP_OK);
  rc = mp_scene_line(sc, 0.0, 0.0, 9.0, 9.0, mp_color(1, 2, 3), 1.0,
                     MP_CLS_AXIS);
  mp_expect_i64("line added", (int64)rc, (int64)MP_OK);
  wo(wb, "10", "10");
  wp(wb, "  <circle cx=\"5\" cy=\"5\" r=\"2\" fill=\"none\" stroke=\"#010203\"");
  wp(wb, " stroke-width=\"1\" class=\"mp-c-series mp-s-0\" />\n");
  wp(wb, "  <line x1=\"0\" y1=\"0\" x2=\"9\" y2=\"9\" stroke=\"#010203\"");
  wp(wb, " stroke-width=\"1\" class=\"mp-c-axis\" />\n");
  wc(wb);
  mp_expect_str("transparent circle fill is none, line has no fill",
                rd(sc, 10.0, 10.0, b), mp_buf_str(wb));
}

// ---------------------------------------------------------------- errors

fn check_argument_errors() {
  var sc: MpScene* = new_scene();
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(b);
  var o: MpRenderOpts = mp_render_opts(10.0, 10.0, mp_theme_light());
  mp_expect_i64("null out is an argument error",
                (int64)mp_svg_render(sc, &o, 0), (int64)MP_ERR_ARG);
  mp_expect_i64("null scene is an argument error",
                (int64)mp_svg_render(0, &o, b), (int64)MP_ERR_ARG);
  mp_expect_i64("null scene clears out", mp_buf_len(b), (int64)0);
  mp_expect_i64("null opts is an argument error",
                (int64)mp_svg_render(sc, 0, b), (int64)MP_ERR_ARG);
  mp_expect_i64("null opts clears out", mp_buf_len(b), (int64)0);
}

// ---------------------------------------------------------------- determinism

fn build_wide_scene(sc: MpScene*) {
  var i: int32 = 0;
  while (i < 20) {
    var x: float64 = (float64)i * 3.5 + 0.125;
    add_rect(sc, x, 2.0, 2.25, 1.75, mp_color_a(10, 20, 30, 180),
             mp_color(200, 100, 50), 1.25, MP_CLS_SERIES + i % 3);
    i = i + 1;
  }
  var xs: float64[4];
  var ys: float64[4];
  xs[0] = 0.0;
  ys[0] = 0.0;
  xs[1] = 1.0 / 3.0;
  ys[1] = 2.0 / 3.0;
  xs[2] = 10.0 / 7.0;
  ys[2] = 100.0 / 9.0;
  xs[3] = 5.0;
  ys[3] = 0.0;
  var rc: int32 = mp_scene_poly(sc, &xs[0], &ys[0], 4, mp_palette_color(2),
                                2.0, MP_CLS_SERIES);
  mp_expect_i64("wide poly added", (int64)rc, (int64)MP_OK);
  add_text(sc, 12.0, 30.0, "Requests / minute & more", 12.0, MP_ALIGN_CENTER,
           MP_CLS_TITLE);
}

fn check_determinism() {
  var sc: MpScene* = new_scene();
  var b1: MpBuf* = new_buf(64);
  var b2: MpBuf* = new_buf(8192);
  if (sc == 0 || b1 == 0 || b2 == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(b1);
  defer mp_buf_free(b2);
  build_wide_scene(sc);
  var o: MpRenderOpts = mp_render_opts(720.25, 360.0, mp_theme_light());
  var rc1: int32 = mp_svg_render(sc, &o, b1);
  var rc2: int32 = mp_svg_render(sc, &o, b2);
  mp_expect_i64("first render rc", (int64)rc1, (int64)MP_OK);
  mp_expect_i64("second render rc", (int64)rc2, (int64)MP_OK);
  var s1: string = mp_buf_str(b1);
  var s2: string = mp_buf_str(b2);
  mp_expect("two buffers agree", s1 == s2);
  mp_expect_i64("same byte count", (int64)s1.length, (int64)s2.length);
  mp_expect_i64("one document only", str_count(s1, "<svg"), (int64)1);
  mp_expect_i64("root plus 22 nodes plus close", str_count(s1, "\n"),
                (int64)24);
  mp_expect("the wide scene really has many nodes", mp_scene_count(sc) > 20);
  // Re-rendering into the buffer that already holds a document must produce
  // the same bytes (the clear is not a truncate-late).
  var rc3: int32 = mp_svg_render(sc, &o, b1);
  mp_expect_i64("re-render rc", (int64)rc3, (int64)MP_OK);
  mp_expect("re-render is byte identical", mp_buf_str(b1) == s2);
  // Distinct allocation histories (64 vs 8192, three renders vs one) agree.
  mp_expect_i64("growth history does not leak into the bytes",
                mp_buf_len(b1), mp_buf_len(b2));
}

// ---------------------------------------------------------------- structure

fn check_structure() {
  var sc: MpScene* = new_scene();
  var b: MpBuf* = new_buf(64);
  if (sc == 0 || b == 0) { return; }
  defer mp_scene_free(sc);
  defer mp_buf_free(b);
  add_rect(sc, 0.0, 0.0, 4.0, 4.0, mp_color(255, 255, 255),
           mp_color_a(0, 0, 0, 0), 0.0, MP_CLS_BG);
  var rc: int32 = mp_scene_line(sc, 0.0, 4.0, 4.0, 4.0, mp_color(0, 0, 0), 1.0,
                                MP_CLS_AXIS);
  mp_expect_i64("structure line added", (int64)rc, (int64)MP_OK);
  add_text(sc, 0.0, 0.0, "t", 12.0, MP_ALIGN_START, MP_CLS_TICK);
  var doc: string = rd(sc, 4.0, 4.0, b);
  mp_expect("starts with the root element",
            str_starts_with(doc, "<svg ") != 0);
  mp_expect("ends with the closing tag", str_ends_with(doc, "</svg>\n") != 0);
  mp_expect("no xml declaration", absent(doc, "<?xml"));
  mp_expect("no doctype", absent(doc, "<!DOCTYPE"));
  mp_expect("no external stylesheet", absent(doc, "<style"));
  mp_expect("no xlink", absent(doc, "xlink"));
  mp_expect("no href", absent(doc, "href"));
  mp_expect("no comment", absent(doc, "<!--"));
  mp_expect_i64("root plus three nodes plus close", str_count(doc, "\n"),
                (int64)5);
  mp_expect_i64("every node line starts at depth 1",
                str_count(doc, "\n  <"), (int64)3);
  mp_expect_i64("two self-closing primitives", str_count(doc, " />\n"),
                (int64)2);
}

fn run_all() {
  check_empty_document();
  check_viewport();
  check_base_classes();
  check_series_classes();
  check_numbers();
  check_paint_order();
  check_omissions();
  check_colors();
  check_text();
  check_injection();
  check_shapes();
  check_degenerate_shapes();
  check_transparent_fill();
  check_argument_errors();
  check_determinism();
  check_structure();
}

export fn main() -> int32 {
  run_all();
  return mp_summary();
}

@test fn t_web_svg() -> int32 {
  run_all();
  if (mp_fails != 0) { return 1; }
  return 0;
}
