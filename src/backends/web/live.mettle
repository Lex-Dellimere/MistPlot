// backends/web/live — live charts on the web: the SVG of an MpLive's current
// frame, and the browser snippet that polls for it.
//
// Dependencies: live/stream + renderer/{scene,backend} + core/buf +
// backends/web/svg. This file and page.mettle are the only web modules that
// may import above the renderer.
//
// Ownership: every entry point clears `out` and writes only into it; nothing is
// allocated here. mp_live_svg updates the MpLive (which owns its scenes) and
// serializes the cached scene; the MpLive itself stays the caller's.
//
// Server renders, browser swaps: mp_live_embed writes
//   <div class="mp-live" data-src="URL" data-interval="N"></div>
//   <script>...</script>
// and the script reads both values back from its *own* preceding element
// (document.currentScript.previousElementSibling), so several embeds on one
// page never share state and the page needs no ids. mp_live_embed_with puts an
// initial SVG inside the div so the first paint is not blank. That SVG is
// inserted RAW (not escaped): it must be MistPlot output (mp_live_svg /
// mp_svg_render), never caller-supplied markup. The script text is one
// constant: the URL is never interpolated into JavaScript, only written once
// as an HTML-escaped attribute value (& < > " ' become entities, so a URL can
// neither close the attribute nor open a tag). Polling sends If-None-Match
// with the last ETag it saw, swaps the div's innerHTML on 200, does nothing
// on 304, and doubles its delay on an error, going back to the interval after
// the next success. Rules the script keeps:
//   * the ETag is remembered only after the body arrived and was swapped in,
//     so a failed body read never leaves the client claiming a frame it does
//     not show (it would then get 304s for it forever);
//   * the error delay is min(2 * delay, 32 * interval, 60000 ms) but never
//     below the interval: setTimeout treats a delay above 2^31-1 ms as 0,
//     so an unbounded backoff over a long interval would become a tight loop;
//   * polling stops once the div is no longer in the document (isConnected),
//     so a page that replaced the embed does not keep a timer per old copy.
// interval_ms is limited to 1..MP_LIVE_MAX_INTERVAL_MS (one hour) by the
// server side; the script clamps it the same way.
//
// Push: mp_live_embed_ws adds data-ws and data-topic (escaped the same way)
// and a longer script that joins the topic over a Phoenix v2 socket
// (`?vsn=2.0.0`, frames [join_ref, ref, topic, event, payload], a heartbeat on
// topic "phoenix" every 30 s). The server sends no frames over it, only tags:
// the join reply's response and each "frame" event carry {"tag": "<t>"}, where
// `"<t>"` (quoted) is the live endpoint's current ETag. When that differs from
// the ETag of the frame on screen, the script fetches `url` with If-None-Match
// exactly as a poll does. Extra rules:
//   * one fetch in flight at a time; a tag that arrives during a fetch is
//     remembered and fetched after it if the new frame does not already
//     carry it;
//   * while the socket is not joined (connecting, refused, closed, errored)
//     the polling loop runs with the same backoff; a successful join stops it,
//     and a failed fetch while joined is retried after the backoff delay;
//   * reconnects back off from 1 s to 30 s; a removed div closes the socket
//     and clears every timer.
//
// This is the only MistPlot output that contains <script>; svg.mettle and
// page.mettle stay script-free. Output is deterministic: a pure function of
// the arguments.

import "mistplot/core/buf";
import "mistplot/renderer/scene";
import "mistplot/renderer/backend";
import "mistplot/backends/web/svg";
import "mistplot/live/stream";

// Largest accepted poll interval (one hour). Larger values are MP_ERR_ARG:
// they are almost certainly a unit mistake (seconds vs ms), and the browser's
// timer cannot represent much more than 24 days anyway.
export const MP_LIVE_MAX_INTERVAL_MS: int32 = 3600000;

// The polling script, one entry per line (each written followed by "\n").
// It is a constant and must never contain a value from the caller. In a
// Mettle literal `{{` is one literal `{` (a lone `{` would interpolate) and `}`
// is literal as it stands.
const MP_WLIVE_LINES: int32 = 32;
const MP_WLIVE_SCRIPT: string[32] = [
  "<script>",
  "(function () {{",
  "  var el = document.currentScript.previousElementSibling;",
  "  var src = el.getAttribute(\"data-src\");",
  "  var base = parseInt(el.getAttribute(\"data-interval\"), 10) || 1000;",
  "  base = Math.max(1, Math.min(base, 3600000));",
  "  var wait = base;",
  "  var tag = null;",
  "  function tick() {{",
  "    if (!el.isConnected) {{ return; }",
  "    var h = {{};",
  "    if (tag !== null) {{ h[\"If-None-Match\"] = tag; }",
  "    fetch(src, {{ headers: h, cache: \"no-store\" }).then(function (r) {{",
  "      if (r.status === 304) {{ return null; }",
  "      if (!r.ok) {{ throw new Error(\"HTTP \" + r.status); }",
  "      var et = r.headers.get(\"ETag\");",
  "      return r.text().then(function (t) {{ return {{ t: t, et: et }; });",
  "    }).then(function (res) {{",
  "      if (res !== null) {{",
  "        el.innerHTML = res.t;",
  "        tag = res.et;",
  "      }",
  "      wait = base;",
  "    }).catch(function () {{",
  "      wait = Math.max(base, Math.min(wait * 2, base * 32, 60000));",
  "    }).then(function () {{",
  "      if (el.isConnected) {{ setTimeout(tick, wait); }",
  "    });",
  "  }",
  "  tick();",
  "})();",
  "</script>"
];

// The channel-driven script for mp_live_embed_ws, same layout as above. It
// keeps the polling script's rules and adds the socket (see the header).
const MP_WLIVE_WS_LINES: int32 = 118;
const MP_WLIVE_WS_SCRIPT: string[118] = [
  "<script>",
  "(function () {{",
  "  var el = document.currentScript.previousElementSibling;",
  "  var src = el.getAttribute(\"data-src\");",
  "  var base = parseInt(el.getAttribute(\"data-interval\"), 10) || 1000;",
  "  base = Math.max(1, Math.min(base, 3600000));",
  "  var topic = el.getAttribute(\"data-topic\");",
  "  var wsu = new URL(el.getAttribute(\"data-ws\"), location.href);",
  "  wsu.protocol = wsu.protocol.replace(/^http/, \"ws\");",
  "  wsu.searchParams.set(\"vsn\", \"2.0.0\");",
  "  var wait = base, tag = null, busy = false, again = null, live = false;",
  "  var timer = null, ws = null, hb = null, rt = null;",
  "  var rwait = 1000, ref = 0, jref = null;",
  "  function stop() {{",
  "    clearTimeout(timer);",
  "    clearTimeout(rt);",
  "    clearInterval(hb);",
  "    var s = ws;",
  "    ws = null;",
  "    live = false;",
  "    if (s !== null) {{ s.close(); }",
  "  }",
  "  function arm(ms) {{",
  "    clearTimeout(timer);",
  "    timer = setTimeout(function () {{ timer = null; kick(); }, ms);",
  "  }",
  "  function stale(t) {{",
  "    return typeof t === \"string\" && '\"' + t + '\"' !== tag;",
  "  }",
  "  function want(t) {{",
  "    if (!stale(t)) {{ return; }",
  "    if (busy) {{ again = t; } else {{ kick(); }",
  "  }",
  "  function kick() {{",
  "    if (!el.isConnected) {{ stop(); return; }",
  "    if (busy) {{ return; }",
  "    busy = true;",
  "    again = null;",
  "    var ok = true;",
  "    var h = {{};",
  "    if (tag !== null) {{ h[\"If-None-Match\"] = tag; }",
  "    fetch(src, {{ headers: h, cache: \"no-store\" }).then(function (r) {{",
  "      if (r.status === 304) {{ return null; }",
  "      if (!r.ok) {{ throw new Error(\"HTTP \" + r.status); }",
  "      var et = r.headers.get(\"ETag\");",
  "      return r.text().then(function (t) {{ return {{ t: t, et: et }; });",
  "    }).then(function (res) {{",
  "      if (res !== null) {{",
  "        el.innerHTML = res.t;",
  "        tag = res.et;",
  "      }",
  "      wait = base;",
  "    }).catch(function () {{",
  "      ok = false;",
  "      wait = Math.max(base, Math.min(wait * 2, base * 32, 60000));",
  "    }).then(function () {{",
  "      busy = false;",
  "      if (!el.isConnected) {{ stop(); return; }",
  "      if (!ok || !live) {{ arm(wait); return; }",
  "      if (again !== null) {{ want(again); }",
  "    });",
  "  }",
  "  function retry() {{",
  "    rt = setTimeout(connect, rwait);",
  "    rwait = Math.min(rwait * 2, 30000);",
  "  }",
  "  function down(s) {{",
  "    if (ws !== s) {{ return; }",
  "    ws = null;",
  "    live = false;",
  "    clearInterval(hb);",
  "    s.close();",
  "    if (!el.isConnected) {{ stop(); return; }",
  "    if (!busy && timer === null) {{ arm(wait); }",
  "    retry();",
  "  }",
  "  function send(s, m) {{ s.send(JSON.stringify(m)); }",
  "  function connect() {{",
  "    rt = null;",
  "    if (!el.isConnected) {{ stop(); return; }",
  "    var s;",
  "    try {{ s = new WebSocket(wsu.href); } catch (e) {{ retry(); return; }",
  "    ws = s;",
  "    s.onopen = function () {{",
  "      if (ws !== s) {{ return; }",
  "      jref = String(++ref);",
  "      send(s, [jref, jref, topic, \"phx_join\", {{}]);",
  "      hb = setInterval(function () {{",
  "        if (!el.isConnected) {{ stop(); return; }",
  "        send(s, [null, String(++ref), \"phoenix\", \"heartbeat\", {{}]);",
  "      }, 30000);",
  "    };",
  "    s.onmessage = function (e) {{",
  "      if (ws !== s) {{ return; }",
  "      if (!el.isConnected) {{ stop(); return; }",
  "      var m = JSON.parse(e.data);",
  "      if (m[2] !== topic) {{ return; }",
  "      var p = m[4] || {{};",
  "      if (m[3] === \"phx_reply\" && m[1] === jref) {{",
  "        if (p.status !== \"ok\") {{ down(s); return; }",
  "        live = true;",
  "        rwait = 1000;",
  "        clearTimeout(timer);",
  "        timer = null;",
  "        want((p.response || {{}).tag);",
  "      } else if (m[3] === \"frame\" && live) {{",
  "        want(p.tag);",
  "      } else if (m[3] === \"phx_error\" || m[3] === \"phx_close\") {{",
  "        down(s);",
  "      }",
  "    };",
  "    s.onclose = function () {{ down(s); };",
  "    s.onerror = function () {{ down(s); };",
  "  }",
  "  kick();",
  "  connect();",
  "})();",
  "</script>"
];

fn wlive_script(out: MpBuf*) -> int32 {
  var i: int32 = 0;
  while (i < MP_WLIVE_LINES) {
    var rc: int32 = mp_buf_puts(out, MP_WLIVE_SCRIPT[i]);
    if (rc != MP_OK) { return rc; }
    rc = mp_buf_putc(out, 10);
    if (rc != MP_OK) { return rc; }
    i = i + 1;
  }
  return MP_OK;
}

fn wlive_ws_script(out: MpBuf*) -> int32 {
  var i: int32 = 0;
  while (i < MP_WLIVE_WS_LINES) {
    var rc: int32 = mp_buf_puts(out, MP_WLIVE_WS_SCRIPT[i]);
    if (rc != MP_OK) { return rc; }
    rc = mp_buf_putc(out, 10);
    if (rc != MP_OK) { return rc; }
    i = i + 1;
  }
  return MP_OK;
}

// Updates the live chart if it changed, then writes its current frame as one
// SVG document. A failed rebuild returns that error (mp_live_error) and writes
// nothing, even though an older frame is still cached.
export fn mp_live_svg(lv: MpLive*, o: MpRenderOpts*, out: MpBuf*) -> int32 {
  if (out == 0) { return MP_ERR_ARG; }
  mp_buf_clear(out);
  if (lv == 0 || o == 0) { return MP_ERR_ARG; }
  mp_live_update(lv);
  var rc: int32 = mp_live_error(lv);
  if (rc != MP_OK) { return rc; }
  return mp_svg_render(mp_live_scene(lv), o, out);
}

// The browser embed for a live endpoint at `url`, polled every `interval_ms`
// milliseconds, with an empty div until the first poll answers. An empty url
// or interval_ms outside 1..MP_LIVE_MAX_INTERVAL_MS is MP_ERR_ARG.
export fn mp_live_embed(url: string, interval_ms: int32, out: MpBuf*) -> int32 {
  return mp_live_embed_with(url, interval_ms, "", out);
}

// Writes `<div class="mp-live" data-src="URL" data-interval="N"` plus, when
// ws_url is not empty, ` data-ws="WS" data-topic="T"`, then `>`, the initial
// SVG and `</div>\n`. Every value is HTML-escaped.
fn wlive_div(url: string, interval_ms: int32, ws_url: string, topic: string,
             initial_svg: string, out: MpBuf*) -> int32 {
  var rc: int32 = mp_buf_puts(out, "<div class=\"mp-live\" data-src=\"");
  if (rc != MP_OK) { return rc; }
  rc = mp_buf_put_esc(out, url);
  if (rc != MP_OK) { return rc; }
  rc = mp_buf_puts(out, "\" data-interval=\"");
  if (rc != MP_OK) { return rc; }
  rc = mp_buf_put_i64(out, (int64)interval_ms);
  if (rc != MP_OK) { return rc; }
  if ((int64)ws_url.length > 0) {
    rc = mp_buf_puts(out, "\" data-ws=\"");
    if (rc != MP_OK) { return rc; }
    rc = mp_buf_put_esc(out, ws_url);
    if (rc != MP_OK) { return rc; }
    rc = mp_buf_puts(out, "\" data-topic=\"");
    if (rc != MP_OK) { return rc; }
    rc = mp_buf_put_esc(out, topic);
    if (rc != MP_OK) { return rc; }
  }
  rc = mp_buf_puts(out, "\">");
  if (rc != MP_OK) { return rc; }
  rc = mp_buf_puts(out, initial_svg);
  if (rc != MP_OK) { return rc; }
  return mp_buf_puts(out, "</div>\n");
}

fn wlive_args_ok(url: string, interval_ms: int32) -> bool {
  if ((int64)url.length == 0) { return false; }
  if (interval_ms <= 0 || interval_ms > MP_LIVE_MAX_INTERVAL_MS) { return false; }
  return true;
}

// mp_live_embed with `initial_svg` written inside the div, so the chart
// paints before the first poll. The bytes are inserted RAW: pass only
// MistPlot output (e.g. mp_live_svg's buffer), never untrusted markup. ""
// gives exactly mp_live_embed's output.
export fn mp_live_embed_with(url: string, interval_ms: int32,
                             initial_svg: string, out: MpBuf*) -> int32 {
  if (out == 0) { return MP_ERR_ARG; }
  mp_buf_clear(out);
  if (!wlive_args_ok(url, interval_ms)) { return MP_ERR_ARG; }
  var rc: int32 = wlive_div(url, interval_ms, "", "", initial_svg, out);
  if (rc != MP_OK) { return rc; }
  return wlive_script(out);
}

// The embed for a live endpoint at `url` that is told about new frames over a
// Phoenix channel: the script joins `topic` on the socket at `ws_url` (a
// relative path such as "/socket/websocket" is resolved against the page) and
// polls `url` every `interval_ms` only while the socket is down.
// `initial_svg` is as for mp_live_embed_with (raw, MistPlot output only; ""
// for an empty div). An empty url, ws_url or topic, or interval_ms outside
// 1..MP_LIVE_MAX_INTERVAL_MS, is MP_ERR_ARG.
export fn mp_live_embed_ws(url: string, ws_url: string, topic: string,
                           interval_ms: int32, initial_svg: string,
                           out: MpBuf*) -> int32 {
  if (out == 0) { return MP_ERR_ARG; }
  mp_buf_clear(out);
  if (!wlive_args_ok(url, interval_ms)) { return MP_ERR_ARG; }
  if ((int64)ws_url.length == 0 || (int64)topic.length == 0) { return MP_ERR_ARG; }
  var rc: int32 = wlive_div(url, interval_ms, ws_url, topic, initial_svg, out);
  if (rc != MP_OK) { return rc; }
  return wlive_ws_script(out);
}
