// live/decimate — min/max decimation of a ring into caller columns, so a frame
// costs O(plot width) points no matter how many samples the ring holds.
//
// Dependencies: live/ring + std/math. No allocation: the output columns and
// their capacity are the caller's (live/stream sizes them to 4 * plot width),
// and the per-bucket bookkeeping lives in out_xs itself (see below).
//
// mp_decimate_minmax(r, x0, x1, buckets, out_xs, out_ys, cap) -> n:
//   * only samples with finite x and y inside [x0, x1] (inclusive) take part;
//   * when at most `cap` samples take part they are copied as they are, oldest
//     first, and n is their count;
//   * otherwise [x0, x1] is split into `b` equal buckets, where b = buckets
//     lowered to cap / 4 so every bucket's four points fit (and at least 1).
//     A sample's bucket is computed from its x alone, so ring order does not
//     matter: one pass records, per bucket, the ring positions of its first,
//     min-y, max-y and last sample; a second pass emits the buckets in x
//     order, each bucket's distinct samples sorted by (x, ring position).
//     Peaks therefore survive whatever the push order: the extremes of every
//     bucket are drawn, n <= 4 * b <= cap, and no sample is dropped for lack
//     of room;
//   * nothing is ever written at or past out[cap]; when cap < 4 the single
//     bucket's points are truncated to the first `cap` of them.
//
// Sorted input (nondecreasing x, the normal case): every bucket is one
// contiguous run of the ring, so the output is exactly what a single in-order
// pass would emit — first, min, max, last of each run in ring order.
//
// Scratch: the bookkeeping pass stores bucket k's four ring positions (as
// float64, exact for any ring <= MP_MAX_COUNT) in out_xs[4k .. 4k+3], -1 for an
// empty bucket. The emit pass reads bucket k's four positions into locals
// before writing any output, and bucket k's output starts at an index
// <= 4k (each earlier bucket emitted at most four points), so a write only
// ever lands on bookkeeping that has already been read.

import "std/math";
import "mistplot/live/ring";

// Sorts up to four ring positions ascending and drops repeats in place;
// returns the number of distinct positions.
fn dec_sort_unique(p: int64*, n: int32) -> int32 {
  var i: int32 = 1;
  while (i < n) {
    var v: int64 = p[(int64)i];
    var j: int32 = i - 1;
    while (j >= 0 && p[(int64)j] > v) {
      p[(int64)j + 1] = p[(int64)j];
      j = j - 1;
    }
    p[(int64)j + 1] = v;
    i = i + 1;
  }
  if (n == 0) { return 0; }
  var m: int32 = 1;
  var k: int32 = 1;
  while (k < n) {
    if (p[(int64)k] != p[(int64)m - 1]) {
      p[(int64)m] = p[(int64)k];
      m = m + 1;
    }
    k = k + 1;
  }
  return m;
}

// Sorts up to four ring positions by (x, position) and drops repeats in place;
// returns the number of distinct positions. Every position is a valid index.
fn dec_sort_xpos(r: MpRing*, p: int64*, n: int32) -> int32 {
  var m: int32 = dec_sort_unique(p, n);
  var i: int32 = 1;
  while (i < m) {
    var v: int64 = p[(int64)i];
    var vx: float64 = mp_ring_x(r, v);
    var j: int32 = i - 1;
    while (j >= 0 && mp_ring_x(r, p[(int64)j]) > vx) {
      p[(int64)j + 1] = p[(int64)j];
      j = j - 1;
    }
    p[(int64)j + 1] = v;
    i = i + 1;
  }
  return m;
}

fn dec_usable(x: float64, y: float64, x0: float64, x1: float64) -> bool {
  if (is_finite(x) == 0 || is_finite(y) == 0) { return false; }
  if (x < x0 || x > x1) { return false; }
  return true;
}

export fn mp_decimate_minmax(r: MpRing*, x0: float64, x1: float64,
                             buckets: int32, out_xs: float64*,
                             out_ys: float64*, cap: int64) -> int64 {
  if (r == 0 || out_xs == 0 || out_ys == 0 || cap <= 0) { return 0; }
  if (is_finite(x0) == 0 || is_finite(x1) == 0) { return 0; }
  if (x1 < x0) { return 0; }
  var len: int64 = mp_ring_len(r);

  // 1. how many samples take part; few enough are copied verbatim.
  var m: int64 = 0;
  var i: int64 = 0;
  while (i < len) {
    if (dec_usable(mp_ring_x(r, i), mp_ring_y(r, i), x0, x1)) { m = m + 1; }
    i = i + 1;
  }
  if (m <= cap) {
    var n0: int64 = 0;
    i = 0;
    while (i < len && n0 < cap) {
      var cx: float64 = mp_ring_x(r, i);
      var cy: float64 = mp_ring_y(r, i);
      if (dec_usable(cx, cy, x0, x1)) {
        out_xs[n0] = cx;
        out_ys[n0] = cy;
        n0 = n0 + 1;
      }
      i = i + 1;
    }
    return n0;
  }

  // 2. bucket count: four points per bucket must fit in cap.
  var b: int64 = (int64)buckets;
  if (b > cap / 4) { b = cap / 4; }
  if (b < 1) { b = 1; }
  var span: float64 = x1 - x0;

  // 3. bookkeeping: bkp[4k + {0,1,2,3}] = first, min, max, last position
  // of bucket k (-1 = empty), filled in one pass in ring order.
  // cap < 4 leaves no room for one bucket's four slots in out_xs, so that
  // single bucket keeps its bookkeeping in a local instead.
  var tiny: float64[4];
  var bkp: float64* = out_xs;
  if (b * 4 > cap) { bkp = &tiny[0]; }
  var j: int64 = 0;
  while (j < b * 4) {
    bkp[j] = -1.0;
    j = j + 1;
  }
  i = 0;
  while (i < len) {
    var x: float64 = mp_ring_x(r, i);
    var y: float64 = mp_ring_y(r, i);
    if (dec_usable(x, y, x0, x1)) {
      var k: int64 = 0;
      if (span > 0.0) {
        k = (int64)((x - x0) / span * (float64)b);
        if (k < 0) { k = 0; }
        if (k > b - 1) { k = b - 1; }
      }
      var o: int64 = k * 4;
      if (bkp[o] < 0.0) {
        bkp[o] = (float64)i;
        bkp[o + 1] = (float64)i;
        bkp[o + 2] = (float64)i;
      } else {
        if (y < mp_ring_y(r, (int64)bkp[o + 1])) { bkp[o + 1] = (float64)i; }
        if (y > mp_ring_y(r, (int64)bkp[o + 2])) { bkp[o + 2] = (float64)i; }
      }
      bkp[o + 3] = (float64)i;
    }
    i = i + 1;
  }

  // 4. emit the buckets in x order; bucket k's positions are read before its
  // first write (which lands at an index <= 4k).
  var n: int64 = 0;
  var bk: int64 = 0;
  while (bk < b && n < cap) {
    var q: int64 = bk * 4;
    if (bkp[q] >= 0.0) {
      var p: int64[4];
      p[0] = (int64)bkp[q];
      p[1] = (int64)bkp[q + 1];
      p[2] = (int64)bkp[q + 2];
      p[3] = (int64)bkp[q + 3];
      var m2: int32 = dec_sort_xpos(r, &p[0], 4);
      var t: int32 = 0;
      while (t < m2 && n < cap) {
        out_xs[n] = mp_ring_x(r, p[(int64)t]);
        out_ys[n] = mp_ring_y(r, p[(int64)t]);
        n = n + 1;
        t = t + 1;
      }
    }
    bk = bk + 1;
  }
  return n;
}
