// live/live_test — MpRing, min/max decimation, mp_series_from_columns and the
// MpLive change-tracking / window / render contract.
//
// Pure: no files, no externs, no clocks, so `mbuild test` runs it in the
// compile-time interpreter and the compiled program (debug and release) runs
// the same checks. The interpreter has a fixed step budget, so the largest
// fixture is a 3000-sample ring rendered 100 px wide.
//
// Expected strings are literals or borrowed scene text; nothing here builds a
// string with runtime `+` (that puts mettle_string_free in the call graph and
// makes `mettle test` skip the file).

import "std/math";
import "std/mem";
import "mistplot/harness";
import "mistplot/core/buf";
import "mistplot/core/data";
import "mistplot/core/geom";
import "mistplot/renderer/scene";
import "mistplot/chart/spec";
import "mistplot/chart/resolve";
import "mistplot/live/ring";
import "mistplot/live/decimate";
import "mistplot/live/stream";

// ------------------------------------------------------------ scene walks

fn lt_count_kind(s: MpScene*, kind: int32) -> int64 {
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < mp_scene_count(s)) {
    var nd: MpNode* = mp_scene_node(s, i);
    if (nd->kind == kind) { n = n + 1; }
    i = i + 1;
  }
  return n;
}

fn lt_first_poly(s: MpScene*) -> MpNode* {
  var i: int64 = 0;
  while (i < mp_scene_count(s)) {
    var nd: MpNode* = mp_scene_node(s, i);
    if (nd->kind == MP_NODE_POLY) { return nd; }
    i = i + 1;
  }
  return 0;
}

fn lt_plot_rect(s: MpScene*) -> MpRect {
  var i: int64 = 0;
  while (i < mp_scene_count(s)) {
    var nd: MpNode* = mp_scene_node(s, i);
    if (nd->kind == MP_NODE_RECT && nd->cls == MP_CLS_PLOT) {
      return mp_rect(nd->x, nd->y, nd->w, nd->h);
    }
    i = i + 1;
  }
  return mp_rect(0.0, 0.0, 0.0, 0.0);
}

// The x tick labels (centre-aligned TICK text), as borrowed views.
fn lt_x_labels(s: MpScene*, arr: string*, cap: int32) -> int32 {
  var n: int32 = 0;
  var i: int64 = 0;
  while (i < mp_scene_count(s) && n < cap) {
    var nd: MpNode* = mp_scene_node(s, i);
    if (nd->kind == MP_NODE_TEXT && nd->cls == MP_CLS_TICK &&
        nd->align == MP_ALIGN_CENTER) {
      arr[(int64)n] = mp_scene_node_text(s, nd);
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

// ---------------------------------------------------------------- ring

fn check_ring() {
  mp_expect("ring cap 0 is refused", mp_ring_new(0) == 0);
  mp_expect("ring negative cap is refused", mp_ring_new(-3) == 0);
  mp_expect_i64("push to null ring", (int64)mp_ring_push(0, 1.0, 1.0),
                (int64)MP_ERR_ARG);
  mp_expect_i64("null ring len", mp_ring_len(0), (int64)0);

  var r: MpRing* = mp_ring_new(4);
  mp_expect("ring allocated", r != 0);
  if (r == 0) { return; }
  defer mp_ring_free(r);
  mp_expect_i64("new ring is empty", mp_ring_len(r), (int64)0);
  mp_expect_i64("ring cap", mp_ring_cap(r), (int64)4);
  mp_expect("empty ring extent is invalid", !mp_ring_extent(r).valid);
  mp_expect("empty ring read is NaN", is_nan(mp_ring_x(r, 0)) != 0);

  var i: int32 = 1;
  while (i <= 6) {
    mp_expect_i64("ring push rc", (int64)mp_ring_push(r, (float64)i,
                  (float64)(i * 10)), (int64)MP_OK);
    i = i + 1;
  }
  // Six pushes into four slots: 1 and 2 were overwritten, 3 is the oldest.
  mp_expect_i64("full ring len", mp_ring_len(r), (int64)4);
  mp_expect_near("oldest x after wrap", mp_ring_x(r, 0), 3.0, 0.0);
  mp_expect_near("x 1 after wrap", mp_ring_x(r, 1), 4.0, 0.0);
  mp_expect_near("x 2 after wrap", mp_ring_x(r, 2), 5.0, 0.0);
  mp_expect_near("newest x after wrap", mp_ring_x(r, 3), 6.0, 0.0);
  mp_expect_near("oldest y after wrap", mp_ring_y(r, 0), 30.0, 0.0);
  mp_expect_near("newest y after wrap", mp_ring_y(r, 3), 60.0, 0.0);
  mp_expect("read past newest is NaN", is_nan(mp_ring_y(r, 4)) != 0);
  mp_expect("negative read is NaN", is_nan(mp_ring_x(r, -1)) != 0);

  var e: MpExtent = mp_ring_extent(r);
  mp_expect("wrapped extent valid", e.valid);
  mp_expect_near("extent min x", e.min_x, 3.0, 0.0);
  mp_expect_near("extent max x", e.max_x, 6.0, 0.0);
  mp_expect_near("extent min y", e.min_y, 30.0, 0.0);
  mp_expect_near("extent max y", e.max_y, 60.0, 0.0);

  // A non-finite sample is stored (the ring does not judge) but the extent
  // skips it; it overwrote x=3, so the extent's min moves to 4.
  mp_ring_push(r, 7.0, NAN());
  mp_expect_i64("nan sample stored", mp_ring_len(r), (int64)4);
  mp_expect("nan sample readable", is_nan(mp_ring_y(r, 3)) != 0);
  e = mp_ring_extent(r);
  mp_expect_near("extent skips nan sample (max x)", e.max_x, 6.0, 0.0);
  mp_expect_near("extent min x after overwrite", e.min_x, 4.0, 0.0);

  mp_ring_clear(r);
  mp_expect_i64("cleared ring len", mp_ring_len(r), (int64)0);
  mp_expect_i64("clear keeps cap", mp_ring_cap(r), (int64)4);
  mp_ring_push(r, 9.0, 1.0);
  mp_expect_near("push after clear is oldest", mp_ring_x(r, 0), 9.0, 0.0);
}

// ------------------------------------------------------------ decimation

fn check_decimate_copy() {
  var r: MpRing* = mp_ring_new(16);
  if (r == 0) {
    mp_expect("decimate ring", false);
    return;
  }
  defer mp_ring_free(r);
  var i: int32 = 0;
  while (i < 10) {
    mp_ring_push(r, (float64)i, (float64)(i * i));
    i = i + 1;
  }
  mp_ring_push(r, 4.5, INF());   // non-finite: never emitted
  var xs: float64[16];
  var ys: float64[16];
  var n: int64 = mp_decimate_minmax(r, 2.0, 7.0, 100, &xs[0], &ys[0], 16);
  mp_expect_i64("in-range samples are copied", n, (int64)6);
  mp_expect_near("copy starts at x0", xs[0], 2.0, 0.0);
  mp_expect_near("copy y", ys[0], 4.0, 0.0);
  mp_expect_near("copy ends at x1 (inclusive)", xs[5], 7.0, 0.0);
  mp_expect_near("copy skips the inf sample", ys[3], 25.0, 0.0);

  mp_expect_i64("reversed range is empty",
                mp_decimate_minmax(r, 7.0, 2.0, 10, &xs[0], &ys[0], 16),
                (int64)0);
  mp_expect_i64("nan range is empty",
                mp_decimate_minmax(r, NAN(), 2.0, 10, &xs[0], &ys[0], 16),
                (int64)0);
  mp_expect_i64("null ring is empty",
                mp_decimate_minmax(0, 0.0, 9.0, 10, &xs[0], &ys[0], 16),
                (int64)0);
  mp_expect_i64("zero cap is empty",
                mp_decimate_minmax(r, 0.0, 9.0, 10, &xs[0], &ys[0], 0),
                (int64)0);
  // A zero-width range keeps exactly the samples on it.
  mp_expect_i64("point range", mp_decimate_minmax(r, 3.0, 3.0, 10, &xs[0],
                &ys[0], 16), (int64)1);
}

// y of the peak fixture: a sawtooth with one spike up and one spike down.
fn lt_peak_y(i: int32) -> float64 {
  if (i == 537) { return 100.0; }
  if (i == 211) { return -50.0; }
  return (float64)(i % 7);
}

fn check_decimate_peaks() {
  var r: MpRing* = mp_ring_new(1000);
  if (r == 0) {
    mp_expect("peak ring", false);
    return;
  }
  defer mp_ring_free(r);
  var i: int32 = 0;
  while (i < 1000) {
    mp_ring_push(r, (float64)i, lt_peak_y(i));
    i = i + 1;
  }
  var xs: float64[41];
  var ys: float64[41];
  xs[40] = 12345.0;   // sentinel just past cap
  var n: int64 = mp_decimate_minmax(r, 0.0, 999.0, 10, &xs[0], &ys[0], 40);
  mp_expect("decimated count is within cap", n > 0 && n <= 40);
  mp_expect_near("nothing written past cap", xs[40], 12345.0, 0.0);
  mp_expect_near("first sample kept", xs[0], 0.0, 0.0);
  mp_expect_near("last sample kept", xs[n - 1], 999.0, 0.0);
  var inc: bool = true;
  var real: bool = true;
  var up: bool = false;
  var down: bool = false;
  var k: int64 = 0;
  while (k < n) {
    if (k > 0 && !(xs[k] > xs[k - 1])) { inc = false; }
    if (ys[k] != lt_peak_y((int32)xs[k])) { real = false; }
    if (ys[k] == 100.0) { up = true; }
    if (ys[k] == -50.0) { down = true; }
    k = k + 1;
  }
  mp_expect("decimated x strictly increasing (no duplicates)", inc);
  mp_expect("every decimated point is a real sample", real);
  mp_expect("the upward peak survives", up);
  mp_expect("the downward peak survives", down);

  // More buckets than cap/4: lowered so every bucket still fits.
  var n2: int64 = mp_decimate_minmax(r, 0.0, 999.0, 1000, &xs[0], &ys[0], 40);
  mp_expect("bucket count lowered to fit cap", n2 > 0 && n2 <= 40);
  mp_expect_near("still nothing past cap", xs[40], 12345.0, 0.0);

  // cap < 4: one bucket truncated to cap.
  var sx: float64[4];
  var sy: float64[4];
  sx[3] = 777.0;
  var n3: int64 = mp_decimate_minmax(r, 0.0, 999.0, 10, &sx[0], &sy[0], 3);
  mp_expect_i64("tiny cap fills exactly", n3, (int64)3);
  mp_expect_near("tiny cap sentinel", sx[3], 777.0, 0.0);
  mp_expect_near("tiny cap keeps first", sx[0], 0.0, 0.0);
  mp_expect_near("tiny cap keeps the min next", sy[1], -50.0, 0.0);

  // A sub-range: samples outside [x0, x1] never appear.
  var n4: int64 = mp_decimate_minmax(r, 500.0, 599.0, 4, &xs[0], &ys[0], 16);
  var inside: bool = n4 > 0 && n4 <= 16;
  var peak: bool = false;
  k = 0;
  while (k < n4) {
    if (xs[k] < 500.0 || xs[k] > 599.0) { inside = false; }
    if (ys[k] == 100.0) { peak = true; }
    k = k + 1;
  }
  mp_expect("sub-range output stays in range", inside);
  mp_expect("sub-range keeps its peak", peak);
}

// Samples pushed out of x order: the output is untidy but bounded and safe.
fn check_decimate_unordered() {
  var r: MpRing* = mp_ring_new(200);
  if (r == 0) {
    mp_expect("unordered ring", false);
    return;
  }
  defer mp_ring_free(r);
  var i: int32 = 0;
  while (i < 200) {
    var x: float64 = (float64)((i * 37) % 200);
    mp_ring_push(r, x, (float64)i);
    i = i + 1;
  }
  var xs: float64[21];
  var ys: float64[21];
  xs[20] = -1.0;
  var n: int64 = mp_decimate_minmax(r, 0.0, 199.0, 5, &xs[0], &ys[0], 20);
  mp_expect("unordered input stays within cap", n > 0 && n <= 20);
  mp_expect_near("unordered input writes nothing past cap", xs[20], -1.0, 0.0);
}

// ------------------------------------------------------------ data

fn check_from_columns() {
  var xs: float64[3];
  var ys: float64[3];
  xs[0] = 1.0;
  ys[0] = 10.0;
  xs[1] = 2.0;
  ys[1] = 20.0;
  xs[2] = 3.0;
  ys[2] = 30.0;
  var s: MpSeries* = mp_series_from_columns("cpu", &xs[0], &ys[0], 3);
  mp_expect("from_columns allocated", s != 0);
  if (s == 0) { return; }
  // The columns are copies: changing the caller's arrays changes nothing.
  xs[1] = 99.0;
  mp_expect_i64("from_columns n", s->n, (int64)3);
  mp_expect_near("from_columns copies x", s->xs[1], 2.0, 0.0);
  mp_expect_near("from_columns copies y", s->ys[2], 30.0, 0.0);
  mp_expect_str("from_columns copies the name", s->name, "cpu");
  mp_expect_i64("from_columns push still works", (int64)mp_series_push(s, 4.0,
                40.0), (int64)MP_OK);
  mp_expect_i64("from_columns grows", s->n, (int64)4);
  mp_series_free(s);

  var e: MpSeries* = mp_series_from_columns("", 0, 0, 0);
  mp_expect("empty from_columns allocated", e != 0);
  if (e != 0) {
    mp_expect_i64("empty from_columns n", e->n, (int64)0);
    mp_series_free(e);
  }
  mp_expect("negative n refused", mp_series_from_columns("x", &xs[0], &ys[0],
            -1) == 0);
  mp_expect("missing column refused", mp_series_from_columns("x", &xs[0], 0,
            2) == 0);
}

// ------------------------------------------------------------ MpLive

fn check_live_args() {
  mp_expect("invalid kind refused", mp_live_new(7, 1, 16) == 0);
  mp_expect("zero series refused", mp_live_new(MP_CHART_LINE, 0, 16) == 0);
  mp_expect("too many series refused",
            mp_live_new(MP_CHART_LINE, MP_CHART_MAX_SERIES + 1, 16) == 0);
  mp_expect("zero ring cap refused", mp_live_new(MP_CHART_LINE, 1, 0) == 0);
  mp_expect_i64("null push", (int64)mp_live_push(0, 0, 1.0, 1.0),
                (int64)MP_ERR_ARG);
  mp_expect("null update", !mp_live_update(0));
  mp_expect("null scene", mp_live_scene(0) == 0);
  mp_expect("null spec", mp_live_spec(0) == 0);
  mp_live_free(0);
}

fn check_live_seq() {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 2, 64);
  mp_expect("live allocated", lv != 0);
  if (lv == 0) { return; }
  defer mp_live_free(lv);
  mp_expect_i64("seq starts at 0", mp_live_seq(lv), (int64)0);
  mp_expect("new live is dirty", mp_live_dirty(lv));
  mp_expect_i64("scene empty before the first update",
                mp_scene_count(mp_live_scene(lv)), (int64)0);
  mp_expect("first update builds", mp_live_update(lv));
  mp_expect_i64("first update rc", (int64)mp_live_error(lv), (int64)MP_OK);
  mp_expect("clean after update", !mp_live_dirty(lv));
  mp_expect("no rebuild without a change", !mp_live_update(lv));
  // No data yet: background only (no title), not an error.
  mp_expect_i64("empty live renders the background",
                mp_scene_count(mp_live_scene(lv)), (int64)1);

  mp_expect_i64("push rc", (int64)mp_live_push(lv, 0, 1.0, 2.0),
                (int64)MP_OK);
  mp_expect_i64("push bumps seq", mp_live_seq(lv), (int64)1);
  mp_expect("push makes dirty", mp_live_dirty(lv));
  mp_expect_i64("push to a missing series", (int64)mp_live_push(lv, 2, 1.0,
                2.0), (int64)MP_ERR_ARG);
  mp_expect_i64("refused push keeps seq", mp_live_seq(lv), (int64)1);
  mp_expect_i64("name rc", (int64)mp_live_series_name(lv, 1, "mem"),
                (int64)MP_OK);
  mp_expect_i64("rename bumps seq", mp_live_seq(lv), (int64)2);
  mp_expect_i64("rename replaces (frees) the old copy",
                (int64)mp_live_series_name(lv, 1, "memory"), (int64)MP_OK);
  mp_expect_i64("rename to empty", (int64)mp_live_series_name(lv, 0, ""),
                (int64)MP_OK);
  mp_expect_i64("rename of a missing series",
                (int64)mp_live_series_name(lv, -1, "x"), (int64)MP_ERR_ARG);
  mp_live_touch(lv);
  mp_expect_i64("touch bumps seq", mp_live_seq(lv), (int64)5);
  mp_expect_i64("negative window refused", (int64)mp_live_window(lv, -1.0),
                (int64)MP_ERR_ARG);
  mp_expect_i64("nan window refused", (int64)mp_live_window(lv, NAN()),
                (int64)MP_ERR_ARG);
  mp_expect_i64("refused window keeps seq", mp_live_seq(lv), (int64)5);
  mp_expect_i64("window rc", (int64)mp_live_window(lv, 30.0), (int64)MP_OK);
  mp_expect_i64("window bumps seq", mp_live_seq(lv), (int64)6);
  mp_expect("several changes, one rebuild", mp_live_update(lv));
  mp_expect("clean again", !mp_live_dirty(lv));
  mp_expect_i64("update does not move seq", mp_live_seq(lv), (int64)6);
}

// The window slides with the newest x and the x ticks follow it.
fn check_live_window() {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 1, 256);
  if (lv == 0) {
    mp_expect("window live", false);
    return;
  }
  defer mp_live_free(lv);
  var sp: MpChartSpec* = mp_live_spec(lv);
  sp->width = 200.0;
  sp->height = 120.0;
  sp->legend = MP_LEGEND_NONE;
  mp_live_touch(lv);
  var i: int32 = 0;
  while (i < 100) {
    mp_live_push(lv, 0, (float64)i, (float64)i);
    i = i + 1;
  }
  mp_live_window(lv, 10.0);
  mp_expect("window update builds", mp_live_update(lv));
  var sc: MpScene* = mp_live_scene(lv);
  var labels: string[16];
  var n: int32 = lt_x_labels(sc, &labels[0], 16);
  mp_expect_i64("window [89,99] x label count", (int64)n, (int64)5);
  if (n == 5) {
    mp_expect_str("window label 0", labels[0], "90");
    mp_expect_str("window label 1", labels[1], "92");
    mp_expect_str("window label 2", labels[2], "94");
    mp_expect_str("window label 3", labels[3], "96");
    mp_expect_str("window label 4", labels[4], "98");
  }
  // The 11 in-window samples (89..99) plus the last one before the window
  // (88, clamped onto the left edge) are drawn, and they span the plot.
  var pl: MpNode* = lt_first_poly(sc);
  var plot: MpRect = lt_plot_rect(sc);
  mp_expect("window poly exists", pl != 0);
  if (pl != 0) {
    mp_expect_i64("window poly has the in-window samples + one before",
                  (int64)pl->pts_len, (int64)24);
    var p: float64* = mp_scene_node_pts(sc, pl);
    mp_expect_near("window starts at the plot's left edge", p[0], plot.x,
                   1e-9);
    mp_expect_near("window ends at the plot's right edge", p[22],
                   plot.x + plot.w, 1e-9);
  }
  // The template is never modified by the window.
  mp_expect("template x_fixed untouched", !sp->x_fixed);

  i = 100;
  while (i < 110) {
    mp_live_push(lv, 0, (float64)i, (float64)i);
    i = i + 1;
  }
  mp_expect("slide rebuilds", mp_live_update(lv));
  sc = mp_live_scene(lv);
  n = lt_x_labels(sc, &labels[0], 16);
  mp_expect_i64("window [99,109] x label count", (int64)n, (int64)5);
  if (n == 5) {
    mp_expect_str("slid label 0", labels[0], "100");
    mp_expect_str("slid label 4", labels[4], "108");
  }

  // span 0 shows everything again: x ticks cover 0..109.
  mp_live_window(lv, 0.0);
  mp_expect("window 0 rebuilds", mp_live_update(lv));
  sc = mp_live_scene(lv);
  n = lt_x_labels(sc, &labels[0], 16);
  mp_expect("full view has labels", n > 0);
  if (n > 0) { mp_expect_str("full view starts at 0", labels[0], "0"); }
  pl = lt_first_poly(sc);
  if (pl != 0) {
    mp_expect_i64("full view draws every sample", (int64)pl->pts_len,
                  (int64)220);
  }
}

// A render error keeps the last good frame and the dirty flag.
fn check_live_error() {
  var lv: MpLive* = mp_live_new(MP_CHART_SCATTER, 1, 16);
  if (lv == 0) {
    mp_expect("error live", false);
    return;
  }
  defer mp_live_free(lv);
  mp_live_push(lv, 0, 1.0, 1.0);
  mp_live_push(lv, 0, 2.0, 3.0);
  mp_expect("good frame", mp_live_update(lv));
  var good: int64 = mp_scene_count(mp_live_scene(lv));
  mp_expect_i64("scatter frame has two circles",
                lt_count_kind(mp_live_scene(lv), MP_NODE_CIRCLE), (int64)2);
  var sp: MpChartSpec* = mp_live_spec(lv);
  sp->width = -1.0;
  mp_live_touch(lv);
  mp_expect("bad spec does not build", !mp_live_update(lv));
  mp_expect_i64("error recorded", (int64)mp_live_error(lv),
                (int64)MP_ERR_ARG);
  mp_expect("still dirty after the error", mp_live_dirty(lv));
  mp_expect_i64("last good frame kept", mp_scene_count(mp_live_scene(lv)),
                good);
  sp->width = 640.0;
  mp_expect("fixed spec builds without another touch", mp_live_update(lv));
  mp_expect_i64("error cleared", (int64)mp_live_error(lv), (int64)MP_OK);
  mp_expect("clean after recovery", !mp_live_dirty(lv));
}

// A ring much larger than the plot is decimated to <= 4 points per column and
// the global peak still reaches the top of the plot.
fn check_live_decimation() {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 1, 4096);
  if (lv == 0) {
    mp_expect("decimation live", false);
    return;
  }
  defer mp_live_free(lv);
  var sp: MpChartSpec* = mp_live_spec(lv);
  sp->width = 100.0;
  sp->height = 80.0;
  sp->legend = MP_LEGEND_NONE;
  sp->grid = false;
  var i: int32 = 0;
  while (i < 3000) {
    var y: float64 = (float64)(i % 5);
    if (i == 1777) { y = 50.0; }
    mp_live_push(lv, 0, (float64)i, y);
    i = i + 1;
  }
  mp_expect("decimated update builds", mp_live_update(lv));
  var sc: MpScene* = mp_live_scene(lv);
  var pl: MpNode* = lt_first_poly(sc);
  mp_expect("decimated poly exists", pl != 0);
  if (pl == 0) { return; }
  var npts: int64 = (int64)pl->pts_len / 2;
  mp_expect("decimated to at most 4 * width points", npts > 0 && npts <= 400);
  var plot: MpRect = lt_plot_rect(sc);
  var p: float64* = mp_scene_node_pts(sc, pl);
  var top: float64 = INF();
  var k: int64 = 0;
  while (k < npts) {
    if (p[k * 2 + 1] < top) { top = p[k * 2 + 1]; }
    k = k + 1;
  }
  mp_expect_near("the peak reaches the top of the plot", top, plot.y, 1e-9);
}

// Two MpLive fed the same samples build the same scene, node for node.
fn check_live_deterministic() {
  var a: MpLive* = mp_live_new(MP_CHART_LINE, 2, 32);
  var b: MpLive* = mp_live_new(MP_CHART_LINE, 2, 64);
  if (a == 0 || b == 0) {
    mp_expect("deterministic lives", false);
    mp_live_free(a);
    mp_live_free(b);
    return;
  }
  defer mp_live_free(a);
  defer mp_live_free(b);
  var i: int32 = 0;
  while (i < 40) {
    var x: float64 = (float64)i * 0.5;
    mp_live_push(a, i % 2, x, sin(x));
    mp_live_push(b, i % 2, x, sin(x));
    i = i + 1;
  }
  mp_live_window(a, 8.0);
  mp_live_window(b, 8.0);
  mp_live_update(a);
  mp_live_update(b);
  var sa: MpScene* = mp_live_scene(a);
  var sb: MpScene* = mp_live_scene(b);
  mp_expect_i64("same node count", mp_scene_count(sa), mp_scene_count(sb));
  mp_expect_i64("same point count", sa->npts, sb->npts);
  var same: bool = mp_scene_count(sa) == mp_scene_count(sb) &&
                   sa->npts == sb->npts;
  var k: int64 = 0;
  while (same && k < sa->npts) {
    if (sa->pts[k] != sb->pts[k]) { same = false; }
    k = k + 1;
  }
  mp_expect("same points", same);
  mp_expect("same text bytes", mp_buf_str(sa->text) == mp_buf_str(sb->text));
}

// ----------------------------------------------------------------- regressions

// Samples pushed out of x order straddling a bucket boundary must not fill the
// cap early and drop the newest samples, including the global peak (19, 1000).
// Buckets come from x alone.
fn check_decimate_unsorted_peak() {
  var r: MpRing* = mp_ring_new(64);
  if (r == 0) {
    mp_expect("unsorted peak ring", false);
    return;
  }
  defer mp_ring_free(r);
  var i: int32 = 0;
  while (i <= 8) {
    mp_ring_push(r, (float64)i, 1.0);
    i = i + 1;
  }
  mp_ring_push(r, 10.0, 1.0);
  mp_ring_push(r, 9.0, 1.0);
  mp_ring_push(r, 11.0, 1.0);
  mp_ring_push(r, 9.4, 1.0);
  mp_ring_push(r, 11.5, 1.0);
  mp_ring_push(r, 9.3, 1.0);
  i = 12;
  while (i <= 19) {
    var yy: float64 = 1.0;
    if (i == 19) { yy = 1000.0; }
    mp_ring_push(r, (float64)i, yy);
    i = i + 1;
  }
  var ox: float64[9];
  var oy: float64[9];
  ox[8] = -7.0;
  var n: int64 = mp_decimate_minmax(r, 0.0, 19.0, 2, &ox[0], &oy[0], 8);
  mp_expect("unsorted peak: within cap", n > 0 && n <= 8);
  mp_expect_near("unsorted peak: nothing past cap", ox[8], -7.0, 0.0);
  var maxy: float64 = 0.0;
  var maxx: float64 = 0.0;
  var inc: bool = true;
  var k: int64 = 0;
  while (k < n) {
    if (oy[k] > maxy) { maxy = oy[k]; }
    if (ox[k] > maxx) { maxx = ox[k]; }
    if (k > 0 && ox[k] < ox[k - 1]) { inc = false; }
    k = k + 1;
  }
  mp_expect_near("unsorted peak: the global max survives", maxy, 1000.0, 0.0);
  mp_expect_near("unsorted peak: the newest x survives", maxx, 19.0, 0.0);
  mp_expect("unsorted peak: buckets emitted in x order", inc);
  mp_expect_i64("unsorted peak: exact count", n, (int64)4);
  if (n == 4) {
    mp_expect_near("unsorted peak: bucket 0 first", ox[0], 0.0, 0.0);
    mp_expect_near("unsorted peak: bucket 0 last (pushed last)", ox[1], 9.3,
                   0.0);
    mp_expect_near("unsorted peak: bucket 1 first", ox[2], 10.0, 0.0);
    mp_expect_near("unsorted peak: bucket 1 max/last", ox[3], 19.0, 0.0);
  }
}

// cap * 8 wraps for cap = 2^61; the ring must refuse it rather than take a tiny
// allocation that pushes overrun.
fn check_ring_cap_overflow() {
  var huge: int64 = (int64)2305843009213693952;
  mp_expect("ring cap 2^61 is refused", mp_ring_new(huge) == 0);
  mp_expect("ring cap above MP_MAX_COUNT is refused",
            mp_ring_new(MP_MAX_COUNT + 1) == 0);
  mp_expect("live ring cap 2^61 is refused",
            mp_live_new(MP_CHART_LINE, 1, huge) == 0);
}

fn lt_poly_points(s: MpScene*) -> int64 {
  var tot: int64 = 0;
  var i: int64 = 0;
  while (i < mp_scene_count(s)) {
    var nd: MpNode* = mp_scene_node(s, i);
    if (nd->kind == MP_NODE_POLY) { tot = tot + (int64)nd->pts_len / 2; }
    i = i + 1;
  }
  return tot;
}

// The decimation cap is 4 * this frame's width, not the scratch size (which
// only grows), so a chart that was once wider keeps decimating after it
// shrinks.
fn check_live_shrink() {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 1, 2048);
  if (lv == 0) {
    mp_expect("shrink live", false);
    return;
  }
  defer mp_live_free(lv);
  var sp: MpChartSpec* = mp_live_spec(lv);
  sp->legend = MP_LEGEND_NONE;
  sp->width = 600.0;
  mp_live_touch(lv);
  mp_live_update(lv);   // one empty frame at 600 px grows the scratch
  sp->width = 50.0;
  mp_live_touch(lv);
  var i: int32 = 0;
  while (i < 2000) {
    mp_live_push(lv, 0, (float64)i, (float64)(i % 9));
    i = i + 1;
  }
  mp_expect("shrunk update builds", mp_live_update(lv));
  var pts: int64 = lt_poly_points(mp_live_scene(lv));
  mp_expect("after shrinking, still at most 4 * width points",
            pts > 0 && pts <= 200);
}

fn lt_window_ok(x: float64, span: float64) -> bool {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 1, 16);
  if (lv == 0) { return false; }
  mp_live_push(lv, 0, x - span * 0.5, 1.0);
  mp_live_push(lv, 0, x, 2.0);
  mp_live_window(lv, span);
  var ok: bool = mp_live_update(lv) && mp_live_error(lv) == MP_OK;
  mp_live_push(lv, 0, x, 3.0);
  ok = ok && mp_live_update(lv) && mp_live_error(lv) == MP_OK;
  mp_live_free(lv);
  return ok;
}

// A window whose start rounds to latest_x (epoch nanoseconds, span of seconds)
// or overflows must not fail every update with MP_ERR_ARG; such a frame falls
// back to the data extent.
fn check_live_window_degenerate() {
  mp_expect("normal window renders", lt_window_ok(100.0, 10.0));
  mp_expect("epoch-ns window renders", lt_window_ok(1.7e18, 60.0));
  mp_expect("1e16 / 1 window renders", lt_window_ok(1.0e16, 1.0));
  mp_expect("-1e308 / 1e308 window renders", lt_window_ok(-1.0e308, 1.0e308));
}

// Startup: the data covers less than the window, so the window starts at the
// earliest sample (no negative times) and keeps the full span once covered.
fn check_live_window_startup() {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 1, 256);
  if (lv == 0) {
    mp_expect("startup live", false);
    return;
  }
  defer mp_live_free(lv);
  var sp: MpChartSpec* = mp_live_spec(lv);
  sp->legend = MP_LEGEND_NONE;
  sp->x_format = MP_FMT_TIME;
  mp_live_touch(lv);
  mp_live_window(lv, 60.0);
  mp_live_push(lv, 0, 5.0, 1.0);
  mp_expect("single sample frame", mp_live_update(lv));
  var inf: MpChartInfo* = mp_live_info(lv);
  mp_expect("single sample info valid", inf != 0 && inf->valid);
  if (inf != 0) {
    mp_expect_near("single sample: window starts at the sample", inf->x0, 5.0,
                   0.0);
    mp_expect_near("single sample: window is span wide", inf->x1, 65.0, 0.0);
  }
  var i: int32 = 6;
  while (i <= 20) {
    mp_live_push(lv, 0, (float64)i, 1.0);
    i = i + 1;
  }
  mp_expect("startup frame", mp_live_update(lv));
  inf = mp_live_info(lv);
  mp_expect_near("startup: window clamped to the earliest sample", inf->x0,
                 5.0, 0.0);
  mp_expect_near("startup: window ends at the newest sample", inf->x1, 20.0,
                 0.0);
  var labels: string[16];
  var n: int32 = lt_x_labels(mp_live_scene(lv), &labels[0], 16);
  mp_expect("startup labels exist", n > 0);
  var neg: bool = false;
  var k: int32 = 0;
  while (k < n) {
    if (labels[(int64)k].length > (uint64)0 && labels[(int64)k].chars[0] == 45) {
      neg = true;
    }
    k = k + 1;
  }
  mp_expect("startup: no negative time label", !neg);
  while (i <= 100) {
    mp_live_push(lv, 0, (float64)i, 1.0);
    i = i + 1;
  }
  mp_live_update(lv);
  inf = mp_live_info(lv);
  mp_expect_near("covered: window keeps the full span", inf->x1 - inf->x0,
                 60.0, 0.0);
  mp_expect_near("covered: window slides", inf->x0, 40.0, 0.0);
}

// mp_live_clear, generation, info and views.
fn check_live_clear_info() {
  var lv: MpLive* = mp_live_new(MP_CHART_LINE, 2, 32);
  if (lv == 0) {
    mp_expect("clear live", false);
    return;
  }
  defer mp_live_free(lv);
  mp_expect("info before any frame is invalid", !mp_live_info(lv)->valid);
  mp_expect_i64("generation defaults to 0", mp_live_generation(lv), (int64)0);
  var seq0: int64 = mp_live_seq(lv);
  mp_live_set_generation(lv, (int64)1730000000123456);
  mp_expect_i64("generation set", mp_live_generation(lv),
                (int64)1730000000123456);
  mp_expect_i64("generation leaves seq alone", mp_live_seq(lv), seq0);
  mp_live_window(lv, 10.0);
  var i: int32 = 0;
  while (i < 30) {
    mp_live_push(lv, 0, 1000.0 + (float64)i, (float64)i);
    i = i + 1;
  }
  mp_expect("pre-clear frame", mp_live_update(lv));
  var inf: MpChartInfo* = mp_live_info(lv);
  mp_expect("info valid after a frame", inf->valid);
  mp_expect_near("info x1 is latest_x", inf->x1, 1029.0, 0.0);
  var plot: MpRect = lt_plot_rect(mp_live_scene(lv));
  mp_expect_near("info plot matches the scene", inf->plot.w, plot.w, 0.0);
  var v: MpSeries* = mp_live_view(lv, 0);
  mp_expect("view 0 exists", v != 0);
  if (v != 0) {
    mp_expect_i64("view holds the window + one before", v->n, (int64)12);
    mp_expect_near("view's last sample", v->xs[v->n - 1], 1029.0, 0.0);
  }
  mp_expect("view of a missing series", mp_live_view(lv, 2) == 0);
  mp_expect("view of a negative series", mp_live_view(lv, -1) == 0);
  mp_expect("view of null", mp_live_view(0, 0) == 0);

  var seq1: int64 = mp_live_seq(lv);
  mp_live_clear(lv);
  mp_expect_i64("clear bumps seq", mp_live_seq(lv), seq1 + 1);
  mp_expect("clear makes dirty", mp_live_dirty(lv));
  mp_expect("cleared frame builds", mp_live_update(lv));
  mp_expect_i64("cleared frame is background only",
                mp_scene_count(mp_live_scene(lv)), (int64)1);
  // Timestamps restart at 0: the window follows them, not the old 1029.
  mp_live_push(lv, 0, 0.0, 1.0);
  mp_live_push(lv, 0, 4.0, 2.0);
  mp_expect("restarted frame builds", mp_live_update(lv));
  mp_expect_near("restarted window starts at 0", mp_live_info(lv)->x0, 0.0,
                 0.0);
  mp_expect_near("restarted window ends at 4", mp_live_info(lv)->x1, 4.0,
                 0.0);
  mp_live_clear(0);
}

fn run_all() {
  check_ring();
  check_decimate_copy();
  check_decimate_peaks();
  check_decimate_unordered();
  check_from_columns();
  check_live_args();
  check_live_seq();
  check_live_window();
  check_live_error();
  check_live_decimation();
  check_live_deterministic();
  check_decimate_unsorted_peak();
  check_ring_cap_overflow();
  check_live_shrink();
  check_live_window_degenerate();
  check_live_window_startup();
  check_live_clear_info();
}

export fn main() -> int32 {
  run_all();
  return mp_summary();
}

@test fn t_live() -> int32 {
  run_all();
  if (mp_fails != 0) { return 1; }
  return 0;
}
