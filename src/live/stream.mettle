// live/stream — MpLive, the realtime chart object: rings in, a cached scene
// out, rebuilt only when something changed.
//
// Dependencies: live/{ring,decimate} + chart/{spec,resolve} + renderer/scene +
// core/{buf,data,color} + std/mem, std/math, std/conv. No backend import: web
// and MythicUI read the cached scene through mp_live_scene.
//
// Ownership: mp_live_new returns an MpLive owned by the caller; mp_live_free
// releases, in one path, the rings, the series-name copies, the view array,
// the two scratch columns and both scenes. Everything else is borrowed:
//   * mp_live_spec returns a pointer into the MpLive (the template). Its
//     strings (title, labels) are borrowed from the caller exactly like any
//     MpChartSpec's; its `series` / `n_series` are ignored, because every
//     frame renders a copy that points at the MpLive's own views;
//   * the views are MpSeries *borrowed* over the scratch columns and the name
//     copies. They are never passed to mp_series_free;
//   * mp_live_scene returns the cached scene, valid until the next update;
//   * mp_live_info returns the MpChartInfo of that same frame (a pointer into
//     the MpLive, updated only by a successful update);
//   * mp_live_view(lv, i) returns series i's view (borrowed, rebuilt by every
//     update attempt) for hosts that look up the samples the frame drew.
//
// Change tracking: `seq` (int64) starts at 0 and grows by one on every push,
// series rename, window change, mp_live_clear and mp_live_touch (call that
// after editing the template). `generation` is an opaque 64-bit value the
// caller may set (mp_live_set_generation, e.g. the process start time) so
// that "generation-seq" identifies a frame across process restarts, where seq
// alone starts again at 0; MistPlot never interprets it. `built_seq` is the
// seq the cached scene was built from; dirty is "no frame yet, or seq moved".
// mp_live_update renders into a back scene and swaps it in only on success, so
// a failed render keeps the last good frame, leaves the object dirty and
// records the code for mp_live_error.
//
// Window: span > 0 shows [x0, latest_x], where latest_x is the largest finite
// x pushed to any series and x0 = latest_x - span clamped up to the earliest
// retained sample. So at startup, while the data covers less than the span,
// the axis starts at the first sample (no negative times) and widens until
// it is `span` wide, then slides at that fixed width. When every retained
// sample has the same x the window is [latest_x, latest_x + span]. The
// per-frame spec copy gets x_fixed = true with that range (the caller's
// template is never modified), so the x axis slides with the data instead of
// jumping with the extent. Each series also draws its last sample before x0
// (if any), which the line rule clamps onto the left edge, so the line
// reaches the plot's left side. A window that cannot be represented — x0 or
// the span not finite, or latest_x - span rounding to latest_x (epoch
// nanoseconds with a span of seconds) — does not fail the frame: that frame
// falls back to the span == 0 rule below.
// span == 0 shows everything: the decimation range is the template's fixed x
// domain when it has one, else the union of the rings' extents.
//
// Decimation: each series is decimated (live/decimate) into its own slice of
// two scratch columns sized 4 * ceil(width) per series (width clamped to
// [1, MP_LIVE_MAX_COLUMNS]), with ceil(width) buckets and an output cap of
// 4 * ceil(width) for *this* frame's width. The scratch grows when the
// template's width grows and is never shrunk (a cap from the scratch size
// would stop decimating after the chart was once wider).
//
// Threads: an MpLive is not thread-safe by itself. A producer that pushes and
// a renderer that updates must share it under the application's lock.

import "std/mem";
import "std/math";
import "std/conv";
import "mistplot/core/buf";
import "mistplot/core/data";
import "mistplot/renderer/scene";
import "mistplot/chart/spec";
import "mistplot/chart/resolve";
import "mistplot/live/ring";
import "mistplot/live/decimate";

// Upper bound on the bucket count per series (a 64k-pixel-wide chart), so a
// silly width cannot turn into a multi-gigabyte scratch allocation.
export const MP_LIVE_MAX_COLUMNS: int64 = 65536;

export struct MpLive {
  kind: int32;
  n_series: int32;
  rings: MpRing**;      // owned, n_series rings
  names: string*;       // owned copies ("" = no allocation)
  views: MpSeries*;     // borrowed views over scratch + names
  scratch_xs: float64*; // owned, n_series * per
  scratch_ys: float64*;
  per: int64;           // scratch capacity per series
  spec: MpChartSpec;    // the caller's template
  info: MpChartInfo;    // geometry of the cached frame (valid = false before)
  generation: int64;    // caller-chosen, never interpreted (default 0)
  span: float64;
  latest_x: float64;
  has_latest: bool;
  scene: MpScene*;      // last good frame
  back: MpScene*;       // render target, swapped in on success
  seq: int64;
  built_seq: int64;
  built: bool;
  err: int32;
}

fn live_free_parts(lv: MpLive*) {
  if (lv->rings != 0) {
    var i: int32 = 0;
    while (i < lv->n_series) {
      mp_ring_free(lv->rings[(int64)i]);
      i = i + 1;
    }
    free(lv->rings);
  }
  if (lv->names != 0) {
    var j: int32 = 0;
    while (j < lv->n_series) {
      if ((int64)lv->names[(int64)j].length > 0) {
        free(lv->names[(int64)j].chars);
      }
      j = j + 1;
    }
    free(lv->names);
  }
  if (lv->views != 0) { free(lv->views); }
  if (lv->scratch_xs != 0) { free(lv->scratch_xs); }
  if (lv->scratch_ys != 0) { free(lv->scratch_ys); }
  if (lv->scene != 0) { mp_scene_free(lv->scene); }
  if (lv->back != 0) { mp_scene_free(lv->back); }
}

// A live chart of `kind` with `n_series` rings of `ring_cap` samples each.
// Returns 0 on an invalid kind, n_series outside 1..MP_CHART_MAX_SERIES,
// ring_cap <= 0, ring_cap > MP_MAX_COUNT, or an allocation failure (nothing
// is leaked).
export fn mp_live_new(kind: int32, n_series: int32,
                      ring_cap: int64) -> MpLive* {
  if (!mp_chart_kind_valid(kind)) { return 0; }
  if (n_series < 1 || n_series > MP_CHART_MAX_SERIES) { return 0; }
  if (ring_cap <= 0 || ring_cap > MP_MAX_COUNT) { return 0; }
  var lv: MpLive* = (MpLive*)malloc(sizeof(MpLive));
  if (lv == 0) { return 0; }
  var n: int64 = (int64)n_series;
  lv->kind = kind;
  lv->n_series = n_series;
  lv->rings = 0;
  lv->names = 0;
  lv->views = 0;
  lv->scratch_xs = 0;
  lv->scratch_ys = 0;
  lv->per = 0;
  lv->info = mp_chart_info_empty();
  lv->generation = 0;
  lv->span = 0.0;
  lv->latest_x = 0.0;
  lv->has_latest = false;
  lv->scene = 0;
  lv->back = 0;
  lv->seq = 0;
  lv->built_seq = 0;
  lv->built = false;
  lv->err = MP_OK;
  lv->rings = (MpRing**)malloc(n * 8);
  lv->names = (string*)malloc(n * sizeof(string));
  lv->views = (MpSeries*)malloc(n * sizeof(MpSeries));
  lv->scene = mp_scene_new();
  lv->back = mp_scene_new();
  if (lv->rings == 0 || lv->names == 0 || lv->views == 0 || lv->scene == 0 ||
      lv->back == 0) {
    // live_free_parts walks rings/names, so zero the arrays it may read.
    if (lv->rings != 0) {
      free(lv->rings);
      lv->rings = 0;
    }
    if (lv->names != 0) {
      free(lv->names);
      lv->names = 0;
    }
    live_free_parts(lv);
    free(lv);
    return 0;
  }
  var i: int64 = 0;
  while (i < n) {
    lv->rings[i] = 0;
    lv->names[i] = "";
    lv->views[i].name = "";
    lv->views[i].xs = 0;
    lv->views[i].ys = 0;
    lv->views[i].n = 0;
    lv->views[i].cap = 0;
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    lv->rings[i] = mp_ring_new(ring_cap);
    if (lv->rings[i] == 0) {
      live_free_parts(lv);
      free(lv);
      return 0;
    }
    i = i + 1;
  }
  lv->spec = mp_chart_spec(kind, lv->views, n_series);
  return lv;
}

export fn mp_live_free(lv: MpLive*) {
  if (lv == 0) { return; }
  live_free_parts(lv);
  free(lv);
}

// The template spec (borrowed, lives as long as lv). After editing it, call
// mp_live_touch so the next update rebuilds.
export fn mp_live_spec(lv: MpLive*) -> MpChartSpec* {
  if (lv == 0) { return 0; }
  return &lv->spec;
}

// Copies `name` as series i's legend label, freeing the previous copy.
export fn mp_live_series_name(lv: MpLive*, i: int32, name: string) -> int32 {
  if (lv == 0) { return MP_ERR_ARG; }
  if (i < 0 || i >= lv->n_series) { return MP_ERR_ARG; }
  var len: int64 = (int64)name.length;
  var copy: string = "";
  if (len > 0) {
    var nb: uint8* = (uint8*)malloc(len);
    if (nb == 0) { return MP_ERR_ALLOC; }
    var k: int64 = 0;
    while (k < len) {
      nb[k] = name.chars[k];
      k = k + 1;
    }
    copy = str_from_bytes((cstring)nb, len);
  }
  var old: string = lv->names[(int64)i];
  if ((int64)old.length > 0) { free(old.chars); }
  lv->names[(int64)i] = copy;
  lv->seq = lv->seq + 1;
  return MP_OK;
}

// Shows the last `span` x-units (0 = everything). A negative or non-finite
// span is MP_ERR_ARG and changes nothing.
export fn mp_live_window(lv: MpLive*, span: float64) -> int32 {
  if (lv == 0) { return MP_ERR_ARG; }
  if (is_finite(span) == 0 || span < 0.0) { return MP_ERR_ARG; }
  lv->span = span;
  lv->seq = lv->seq + 1;
  return MP_OK;
}

// Appends (x, y) to series i; O(1), overwrites the oldest sample when full.
export fn mp_live_push(lv: MpLive*, i: int32, x: float64,
                       y: float64) -> int32 {
  if (lv == 0) { return MP_ERR_ARG; }
  if (i < 0 || i >= lv->n_series) { return MP_ERR_ARG; }
  var rc: int32 = mp_ring_push(lv->rings[(int64)i], x, y);
  if (rc != MP_OK) { return rc; }
  if (is_finite(x) != 0) {
    if (!lv->has_latest || x > lv->latest_x) { lv->latest_x = x; }
    lv->has_latest = true;
  }
  lv->seq = lv->seq + 1;
  return MP_OK;
}

// Empties every ring and forgets latest_x (for a data source whose
// timestamps restarted); names, window, template and the cached frame stay.
// Bumps seq, so the next update renders the empty chart.
export fn mp_live_clear(lv: MpLive*) {
  if (lv == 0) { return; }
  var i: int32 = 0;
  while (i < lv->n_series) {
    mp_ring_clear(lv->rings[(int64)i]);
    i = i + 1;
  }
  lv->latest_x = 0.0;
  lv->has_latest = false;
  lv->seq = lv->seq + 1;
}

// Caller-chosen frame generation (see the header); seq is unchanged.
export fn mp_live_set_generation(lv: MpLive*, g: int64) {
  if (lv == 0) { return; }
  lv->generation = g;
}

export fn mp_live_generation(lv: MpLive*) -> int64 {
  if (lv == 0) { return 0; }
  return lv->generation;
}

// Marks the chart changed (after the caller edited the template spec).
export fn mp_live_touch(lv: MpLive*) {
  if (lv == 0) { return; }
  lv->seq = lv->seq + 1;
}

export fn mp_live_seq(lv: MpLive*) -> int64 {
  if (lv == 0) { return 0; }
  return lv->seq;
}

export fn mp_live_dirty(lv: MpLive*) -> bool {
  if (lv == 0) { return false; }
  if (!lv->built) { return true; }
  return lv->seq != lv->built_seq;
}

// The code of the last build attempt (MP_OK before the first one).
export fn mp_live_error(lv: MpLive*) -> int32 {
  if (lv == 0) { return MP_ERR_ARG; }
  return lv->err;
}

// The cached scene (borrowed; valid until the next mp_live_update). Empty
// until the first successful update.
export fn mp_live_scene(lv: MpLive*) -> MpScene* {
  if (lv == 0) { return 0; }
  return lv->scene;
}

// Geometry of the cached frame (borrowed, lives as long as lv; overwritten by
// the next successful update). info->valid is false before the first frame
// with data.
export fn mp_live_info(lv: MpLive*) -> MpChartInfo* {
  if (lv == 0) { return 0; }
  return &lv->info;
}

// Series i's view: the (decimated) samples the last update attempt handed to
// the renderer, named like the legend. Borrowed; valid until the next update.
// 0 for a bad index.
export fn mp_live_view(lv: MpLive*, i: int32) -> MpSeries* {
  if (lv == 0) { return 0; }
  if (i < 0 || i >= lv->n_series) { return 0; }
  return &lv->views[(int64)i];
}

// Grows the scratch columns to `per` samples per series. Old columns are
// released only after both new ones exist.
fn live_reserve(lv: MpLive*, per: int64) -> int32 {
  if (per <= lv->per) { return MP_OK; }
  var total: int64 = per * (int64)lv->n_series;
  var nx: float64* = (float64*)malloc(total * 8);
  if (nx == 0) { return MP_ERR_ALLOC; }
  var ny: float64* = (float64*)malloc(total * 8);
  if (ny == 0) {
    free(nx);
    return MP_ERR_ALLOC;
  }
  if (lv->scratch_xs != 0) { free(lv->scratch_xs); }
  if (lv->scratch_ys != 0) { free(lv->scratch_ys); }
  lv->scratch_xs = nx;
  lv->scratch_ys = ny;
  lv->per = per;
  return MP_OK;
}

// Bucket count for a spec width: ceil(width), clamped to 1..MAX_COLUMNS. A
// non-finite width gets 1 (the render then rejects the spec anyway).
fn live_columns(width: float64) -> int64 {
  if (is_finite(width) == 0 || !(width > 1.0)) { return 1; }
  if (width >= (float64)MP_LIVE_MAX_COLUMNS) { return MP_LIVE_MAX_COLUMNS; }
  return (int64)ceil(width);
}

// The sliding window for this frame (see the header): [x0, x1] with x0
// clamped up to the earliest retained sample `ext.min_x`. False when it
// cannot be represented, and the frame then uses the span == 0 rule.
fn live_window_range(lv: MpLive*, ext: MpExtent, x0: float64*,
                     x1: float64*) -> bool {
  var b: float64 = lv->latest_x;
  var a: float64 = b - lv->span;
  if (ext.valid && ext.min_x > a) { a = ext.min_x; }
  if (!(b > a)) {
    // every retained sample at one x (or the span rounds away)
    a = b;
    b = a + lv->span;
  }
  if (is_finite(a) == 0 || is_finite(b) == 0) { return false; }
  if (is_finite(b - a) == 0 || !(b > a)) { return false; }
  *x0 = a;
  *x1 = b;
  return true;
}

// The largest finite x below `x0` among r's samples with a finite y, so the
// window's line can start left of the plot (clamped onto its edge); x0 when
// there is none.
fn live_prev_x(r: MpRing*, x0: float64) -> float64 {
  var best: float64 = x0;
  var found: bool = false;
  var n: int64 = mp_ring_len(r);
  var i: int64 = 0;
  while (i < n) {
    var x: float64 = mp_ring_x(r, i);
    var y: float64 = mp_ring_y(r, i);
    if (is_finite(x) != 0 && is_finite(y) != 0 && x < x0) {
      if (!found || x > best) {
        best = x;
        found = true;
      }
    }
    i = i + 1;
  }
  return best;
}

// Fills the views for one frame and renders it into lv->back, reporting the
// frame's geometry into `info`.
fn live_build(lv: MpLive*, info: MpChartInfo*) -> int32 {
  var spec: MpChartSpec = lv->spec;
  spec.series = lv->views;
  spec.n_series = lv->n_series;
  var cols: int64 = live_columns(spec.width);
  var rc: int32 = live_reserve(lv, cols * 4);
  if (rc != MP_OK) { return rc; }

  var ext: MpExtent = mp_extent_empty();
  var k: int32 = 0;
  while (k < lv->n_series) {
    ext = mp_extent_union(ext, mp_ring_extent(lv->rings[(int64)k]));
    k = k + 1;
  }

  // Decimation range: the sliding window, else the fixed template domain,
  // else everything the rings hold.
  var have: bool = false;
  var win: bool = false;
  var x0: float64 = 0.0;
  var x1: float64 = 0.0;
  if (lv->span > 0.0 && lv->has_latest) {
    win = live_window_range(lv, ext, &x0, &x1);
  }
  if (win) {
    spec.x_fixed = true;
    spec.x_min = x0;
    spec.x_max = x1;
    have = true;
  } else if (spec.x_fixed) {
    x0 = spec.x_min;
    x1 = spec.x_max;
    have = true;
  } else if (ext.valid) {
    x0 = ext.min_x;
    x1 = ext.max_x;
    have = true;
  }

  var i: int32 = 0;
  while (i < lv->n_series) {
    var off: int64 = (int64)i * lv->per;
    var n: int64 = 0;
    if (have) {
      var lo: float64 = x0;
      if (win) { lo = live_prev_x(lv->rings[(int64)i], x0); }
      n = mp_decimate_minmax(lv->rings[(int64)i], lo, x1, (int32)cols,
                             lv->scratch_xs + off, lv->scratch_ys + off,
                             cols * 4);
    }
    var v: MpSeries* = &lv->views[(int64)i];
    v->name = lv->names[(int64)i];
    v->xs = lv->scratch_xs + off;
    v->ys = lv->scratch_ys + off;
    v->n = n;
    v->cap = lv->per;
    i = i + 1;
  }
  return mp_chart_render_info(&spec, lv->back, info);
}

// Rebuilds the cached scene when dirty. Returns true when a new frame was
// built; false when nothing changed or the render failed (then the object
// stays dirty, the previous frame stays cached and mp_live_error has the code).
export fn mp_live_update(lv: MpLive*) -> bool {
  if (lv == 0) { return false; }
  if (!mp_live_dirty(lv)) { return false; }
  var info: MpChartInfo = mp_chart_info_empty();
  var rc: int32 = live_build(lv, &info);
  lv->err = rc;
  if (rc != MP_OK) { return false; }
  lv->info = info;
  var t: MpScene* = lv->scene;
  lv->scene = lv->back;
  lv->back = t;
  lv->built_seq = lv->seq;
  lv->built = true;
  return true;
}
