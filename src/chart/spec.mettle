// chart/spec — the chart specification, its kinds/legend/format constants and
// the one constructor with the Phase-1 defaults (docs/02-seams.md §4).
//
// Dependencies: core/{color,geom,data,scale,format} + std/math. No scene and no
// backend: a spec is pure data, so it can be built without a renderer.
//
// Ownership: an MpChartSpec **borrows** every input — the series array, each
// series name, the title/subtitle/axis labels. It never stores an interpolation
// result and never copies a string, so the caller must keep those bytes alive
// while the spec (or a spec copy) is used. `mp_chart_fmt_value` writes into the
// caller's buffer and returns a borrowed view, like core/format does.

import "std/math";
import "mistplot/core/color";
import "mistplot/core/data";
import "mistplot/core/format";
import "mistplot/core/geom";
import "mistplot/core/scale";

export const MP_CHART_LINE: int32 = 0;
export const MP_CHART_BAR: int32 = 1;
export const MP_CHART_SCATTER: int32 = 2;

export const MP_LEGEND_NONE: int32 = 0;
export const MP_LEGEND_RIGHT: int32 = 1;
export const MP_LEGEND_BOTTOM: int32 = 2;

export const MP_FMT_AUTO: int32 = 0;
export const MP_FMT_SI: int32 = 1;
export const MP_FMT_INT: int32 = 2;

// Layout and drawing constants. They live here (not in layout.mettle) because
// both layout and resolve/axis need them and the spec owns the chart's
// appearance policy.
export const MP_CHART_MAX_SERIES: int32 = 32;
export const MP_CHART_TICK_TARGET: int32 = 5;
export const MP_CHART_TICK_MAX: int32 = 64;
// Phase-1 ceiling on the number of bar bands (categories) in one chart, so the
// band index stays a sane int32 and a chart cannot ask for a billion rects.
export const MP_CHART_MAX_BANDS: int32 = 1000000;
export const MP_CHART_TEXT_SIZE: float64 = 12.0;
export const MP_CHART_TITLE_SIZE: float64 = 16.0;
export const MP_CHART_SUBTITLE_SIZE: float64 = 12.0;
export const MP_CHART_LINE_W: float64 = 2.0;
export const MP_CHART_POINT_ALPHA: uint8 = 200;
export const MP_CHART_LEGEND_ROW: float64 = 18.0;
export const MP_CHART_LEGEND_SWATCH: float64 = 12.0;
export const MP_CHART_LEGEND_LABEL: float64 = 16.0;  // label x = swatch x + 16
export const MP_CHART_LEGEND_PAD: float64 = 24.0;    // legend_w = label_w + 24
export const MP_CHART_LEGEND_GAP: float64 = 16.0;    // between bottom items

export struct MpChartSpec {
  kind: int32;
  title: string;
  subtitle: string;
  x_label: string;
  y_label: string;
  width: float64;
  height: float64;
  margins: MpInsets;
  margin_auto: bool;
  x_kind: int32;
  y_kind: int32;
  y_start_at_zero: bool;
  grid: bool;
  legend: int32;
  series: MpSeries*;   // borrowed
  n_series: int32;
  theme: MpTheme;
  point_radius: float64;
  bar_gap: float64;
  x_format: int32;
  y_format: int32;
}

// Defaults (docs/02-seams.md §4): 640x400, auto margins, right legend, grid on,
// y starts at zero, light theme, 3 px points, bar_gap 0.2, linear axes, auto
// label formats. `margins` is zeroed because `margin_auto` is true; a caller
// that sets `margin_auto = false` supplies all four insets itself.
export fn mp_chart_spec(kind: int32, series: MpSeries*,
                        n_series: int32) -> MpChartSpec {
  var s: MpChartSpec;
  s.kind = kind;
  s.title = "";
  s.subtitle = "";
  s.x_label = "";
  s.y_label = "";
  s.width = 640.0;
  s.height = 400.0;
  s.margins = mp_insets(0.0, 0.0, 0.0, 0.0);
  s.margin_auto = true;
  s.x_kind = MP_SCALE_LINEAR;
  s.y_kind = MP_SCALE_LINEAR;
  s.y_start_at_zero = true;
  s.grid = true;
  s.legend = MP_LEGEND_RIGHT;
  s.series = series;
  s.n_series = n_series;
  s.theme = mp_theme_light();
  s.point_radius = 3.0;
  s.bar_gap = 0.2;
  s.x_format = MP_FMT_AUTO;
  s.y_format = MP_FMT_AUTO;
  return s;
}

// One axis label through core/format — the only number -> text path in the
// chart layer (§0). MP_FMT_INT rounds half away from zero, but a non-finite or
// out-of-int64 value is never truncated: it falls back to the auto formatter
// (which prints NaN/inf) instead of casting undefined behaviour into a label.
export fn mp_chart_fmt_value(v: float64, fmt: int32, out: uint8*,
                             cap: int64) -> string {
  if (fmt == MP_FMT_INT) {
    if (is_finite(v) != 0 && fabs(v) < 1e18) {
      return mp_fmt_int((int64)round(v), out, cap);
    }
    return mp_fmt_auto(v, out, cap);
  }
  if (fmt == MP_FMT_SI) { return mp_fmt_si(v, out, cap); }
  return mp_fmt_auto(v, out, cap);
}

export fn mp_chart_kind_valid(kind: int32) -> bool {
  if (kind == MP_CHART_LINE) { return true; }
  if (kind == MP_CHART_BAR) { return true; }
  if (kind == MP_CHART_SCATTER) { return true; }
  return false;
}
