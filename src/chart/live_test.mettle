// Live charts: window ranges (startup, sliding, single x), the lead point clipped onto the
// window start, rings, and the summary path for large sorted series versus the O(n)
// fallback for unsorted ones. check_summary needs more than MP_SUMMARY_MIN_LEN samples,
// which is over the interpreter's step budget, so it runs in the native builds only.

import "std/math";
import "mistplot/test/harness";
import "mistplot/core/error";
import "mistplot/core/mem";
import "mistplot/core/target";
import "mistplot/scene/scene";
import "mistplot/chart/chart";
import "mistplot/chart/samples";
import "mistplot/chart/config";
import "mistplot/chart/frame";

fn frame(c: MpChart*, info: MpChartInfo*) {
  var t: MpTarget = mp_target(200.0, 120.0);
  mp_chart_scene(c, &t);
  mp_chart_info(c, info);
}

fn check_window() {
  var base: int64 = mp_alloc_live();
  var c: MpChart* = mp_chart_new(MP_LINE);
  var s: int32 = mp_chart_series(c, "a");
  mp_chart_window(c, 30.0);
  var i: int32 = 0;
  while (i <= 10) {
    mp_chart_push(c, s, (float64)i, (float64)i);
    i = i + 1;
  }
  var info: MpChartInfo;
  frame(c, &info);
  mp_expect("startup starts at the first sample", info.x0 == 0.0 && info.x1 == 10.0);
  while (i <= 100) {
    mp_chart_push(c, s, (float64)i, (float64)i);
    i = i + 1;
  }
  frame(c, &info);
  mp_expect("slides at the span", info.x0 == 70.0 && info.x1 == 100.0);
  mp_chart_push(c, s, 100.5, 3.0);
  frame(c, &info);
  mp_expect("fractional slide", info.x0 == 70.5 && info.x1 == 100.5);
  var d: MpSeriesData* = &c->series[(int64)s];
  mp_expect("first view point on the window start", d->vx[0] == 70.5);
  mp_expect("lead interpolated", fabs(d->vy[0] - 70.5) < 1e-9);
  mp_chart_free(c);
  mp_expect_i64("leak-free", mp_alloc_live(), base);
}

fn check_single_x() {
  var c: MpChart* = mp_chart_new(MP_LINE);
  var s: int32 = mp_chart_series(c, "a");
  mp_chart_window(c, 5.0);
  mp_chart_push(c, s, 7.0, 1.0);
  mp_chart_push(c, s, 7.0, 2.0);
  var info: MpChartInfo;
  frame(c, &info);
  mp_expect("one x opens the span", info.x0 == 7.0 && info.x1 == 12.0);
  mp_chart_window(c, 0.0);
  frame(c, &info);
  mp_expect("no window widens a single x", info.x0 == 6.0 && info.x1 == 8.0);
  mp_chart_free(c);
}

fn check_ring() {
  var base: int64 = mp_alloc_live();
  var c: MpChart* = mp_chart_new(MP_AREA);
  mp_chart_keep(c, 50);
  var s: int32 = mp_chart_series(c, "a");
  var i: int32 = 0;
  while (i < 120) {
    mp_chart_push(c, s, (float64)i, 1.0);
    i = i + 1;
  }
  mp_expect_i64("ring keeps the newest", mp_chart_len(c, s), 50);
  var info: MpChartInfo;
  frame(c, &info);
  mp_expect("domain is the retained data", info.x0 == 70.0 && info.x1 == 119.0);
  mp_chart_clear(c);
  frame(c, &info);
  mp_expect("cleared chart has no data", !info.valid);
  mp_chart_free(c);
  mp_expect_i64("leak-free", mp_alloc_live(), base);
}

fn check_summary() {
  var base: int64 = mp_alloc_live();
  var c: MpChart* = mp_chart_new(MP_LINE);
  var s: int32 = mp_chart_series(c, "a");
  var i: int32 = 0;
  while (i < 9000) {
    mp_chart_push(c, s, (float64)i, (float64)(i % 17));
    i = i + 1;
  }
  var info: MpChartInfo;
  frame(c, &info);
  var st: MpChartStats;
  mp_chart_stats(c, &st);
  mp_expect_i64("one rebuild", st.summary_rebuilds, 1);
  mp_expect("reduced", c->series[0].vn <= 4 * 200 + 2);
  mp_expect("extremes kept", info.y0 == 0.0 && info.y1 >= 16.0);
  mp_chart_push(c, s, 9000.0, 5.0);
  frame(c, &info);
  mp_chart_stats(c, &st);
  mp_expect_i64("pushes sync without a rebuild", st.summary_rebuilds, 1);
  mp_chart_push(c, s, 10.0, 5.0);
  frame(c, &info);
  mp_chart_stats(c, &st);
  mp_expect_i64("out of order falls back", st.summary_rebuilds, 1);
  mp_expect("still drawn", info.valid && c->series[0].vn > 0);
  mp_chart_free(c);
  mp_expect_i64("leak-free", mp_alloc_live(), base);
}

fn run_all() {
  check_window();
  check_single_x();
  check_ring();
  check_summary();
}

export fn main() -> int32 {
  run_all();
  return mp_summary();
}

@test fn t_window() -> int32 {
  check_window();
  check_single_x();
  if (mp_fails != 0) { return 1; }
  return 0;
}

@test fn t_ring() -> int32 {
  check_ring();
  if (mp_fails != 0) { return 1; }
  return 0;
}
