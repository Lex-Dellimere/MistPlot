// A RaizeWeb app with one static and one live MistPlot chart.
//
//   GET /                  HTML page with the bar chart <figure> ({{{bar}}}) and the
//                          live chart's channel embed ({{{live}}})
//   GET /chart/static.svg  the bar chart as image/svg+xml
//   GET /chart/live.svg    the live line chart, fetched by the embed
//   GET /chart/live.html   the live chart's embed alone, as an HTML fragment
//   GET /chart/poll.html   a polling embed of the bar chart (it is on no channel)
//   GET /socket/websocket  the channel socket (rz_run); topic "chart:live" announces
//                          each new frame's tag
//
// An rz_every tick pushes a 10 s sine plus noise four times a second and calls
// mp_raize_notify, so joined pages fetch the new frame at once; a page whose socket is
// down polls every second instead. x is seconds since start and the chart shows the last
// 60 s. Both charts are shared (mp_chart_share; mp_raize_channel does it for the live
// one), so workers and the tick use them without further locking.
//
// Build and run from the mistplot repo root:
//   mettle --build integrations/raize/examples/dashboard.mettle \
//       -o build/integrations/raize/dashboard
//   ./build/integrations/raize/dashboard                 # :8088, until Ctrl-C
//   ./build/integrations/raize/dashboard --port 8099
//   ./build/integrations/raize/dashboard --run-for 10    # stop cleanly after 10 s
//
// With --run-for N the tick sends the process SIGTERM after N seconds, which rz_run
// takes as a clean stop; the charts are freed after it returns.

import "std/io";
import "std/math";
import "std/bench";
import "raize_core/str/str";
import "raize_core/context/context";
import "raize_template/template";
import "raize_template/vars";
import "raize_app/app";
import "mistplot/mistplot";
import "../mp_raize";

const DASH_INTERVAL_MS: int32 = 1000;
const DASH_PUSH_MS: int64 = 250;
const DASH_WINDOW_S: float64 = 60.0;
const DASH_KEEP: int64 = 4096;
const DASH_W: float64 = 480.0;
const DASH_H: float64 = 300.0;
const DASH_TOPIC: string = "chart:live";
const DASH_SOCKET: string = "/socket/websocket";

// Embedded at compile time. import_str bytes are not interpolated, so the template's
// `{{name}}` is written as is.
const DASH_PAGE: string = import_str "dashboard.html";

// Set before rz_run serves; read-only pointers afterwards.
var g_bar: MpChart* = 0;
var g_live: MpChart* = 0;
var g_tpl: RzTemplate* = 0;
var g_run_for: int64 = 0;    // seconds; 0 = until stopped
var g_t0: int64 = 0;
var g_rng: uint32 = 2463534242;

fn h_index(ctx: RzContext*) -> int32 {
  var vars: RzVarMap;
  rz_vars_init(&vars);
  rz_vars_set(&vars, "title", "MistPlot on RaizeWeb");
  var ibuf: uint8[24];
  rz_vars_set(&vars, "interval", rz_int_buf((int64)DASH_INTERVAL_MS, &ibuf[0], 24));
  var r1: int32 = mp_raize_tpl_figure(ctx, &vars, "bar", g_bar, DASH_W, DASH_H);
  // The embed carries the current frame, so the page paints at once.
  var r2: int32 = mp_raize_tpl_embed(ctx, &vars, "live", g_live, DASH_W, DASH_H,
                                     "/chart/live.svg", DASH_INTERVAL_MS);
  if (r1 != MP_OK || r2 != MP_OK) { return rz_ctx_text(ctx, 500, "chart render failed\n"); }
  if (rz_template_render_into(g_tpl, &vars, ctx->resp->body) != RZ_TPL_OK) {
    return rz_ctx_text(ctx, 500, "template render failed\n");
  }
  if (rz_resp_set_content_type(ctx->resp, RZ_CT_HTML) != 0) { return 500; }
  ctx->resp->status = 200;
  ctx->status = 200;
  return 200;
}

fn h_static_svg(ctx: RzContext*) -> int32 { return mp_raize_svg(ctx, g_bar, DASH_W, DASH_H); }
fn h_live_svg(ctx: RzContext*) -> int32 { return mp_raize_svg(ctx, g_live, DASH_W, DASH_H); }
fn h_live_html(ctx: RzContext*) -> int32 {
  return mp_raize_embed(ctx, g_live, DASH_W, DASH_H, "/chart/live.svg", DASH_INTERVAL_MS);
}
fn h_poll_html(ctx: RzContext*) -> int32 {
  return mp_raize_embed(ctx, g_bar, DASH_W, DASH_H, "/chart/static.svg", DASH_INTERVAL_MS);
}

fn xorshift32(s: uint32*) -> uint32 {
  var x: uint32 = *s;
  x = x ^ (x << (uint32)13);
  x = x ^ (x >> (uint32)17);
  x = x ^ (x << (uint32)5);
  *s = x;
  return x;
}

// Timer thread. kill(getpid(), SIGTERM) by raw syscall: Mettle links no libc, and rz_run
// blocks SIGTERM in every thread and stops cleanly when its watcher takes it.
fn dash_tick(n: int64) {
  var t: float64 = (float64)(bench_time_us() - g_t0) / 1000000.0;
  var u: float64 = (float64)xorshift32(&g_rng) / 4294967296.0;
  mp_chart_push(g_live, 0, t, sin(t * 6.283185307179586 / 10.0) + (u - 0.5) * 0.4);
  // A full mailbox keeps the notice pending for the next tick.
  mp_raize_notify(g_live);
  if (g_run_for > 0 && n == g_run_for * 1000 / DASH_PUSH_MS) {
    syscall(62, syscall(39, 0, 0, 0, 0), 15, 0, 0);
  }
}

fn dash_app(app: RzApp*) {
  rz_default(app, "port", "8088");
  rz_use_logging(app);
  rz_get(app, "/", &h_index);
  rz_get(app, "/chart/static.svg", &h_static_svg);
  rz_get(app, "/chart/live.svg", &h_live_svg);
  rz_get(app, "/chart/live.html", &h_live_html);
  rz_get(app, "/chart/poll.html", &h_poll_html);
  if (mp_raize_channel(app, g_live, DASH_TOPIC, DASH_SOCKET) != MP_OK) {
    println("dashboard: channel registration failed");
  }
  rz_every(app, DASH_PUSH_MS, &dash_tick);
}

fn build_bar() -> bool {
  g_bar = mp_chart_new(MP_BAR);
  if (g_bar == 0) { return false; }
  mp_chart_set_title(g_bar, "Requests by region");
  mp_chart_set_x_label(g_bar, "region");
  mp_chart_set_y_label(g_bar, "req/min");
  mp_chart_set_legend(g_bar, MP_LEGEND_NONE);
  var s: int32 = mp_chart_series(g_bar, "requests");
  mp_chart_set_value(g_bar, s, "north", 420.0);
  mp_chart_set_value(g_bar, s, "south", 310.0);
  mp_chart_set_value(g_bar, s, "east", 515.0);
  mp_chart_set_value(g_bar, s, "west", 180.0);
  mp_chart_set_value(g_bar, s, "central", 260.0);
  mp_chart_set_value(g_bar, s, "islands", 390.0);
  mp_chart_share(g_bar);
  return mp_chart_error(g_bar) == MP_OK;
}

fn build_live() -> bool {
  g_live = mp_chart_new(MP_LINE);
  if (g_live == 0) { return false; }
  mp_chart_set_title(g_live, "sin(2*pi*t/10) + noise");
  mp_chart_set_x_label(g_live, "uptime");
  mp_chart_set_legend(g_live, MP_LEGEND_NONE);
  mp_chart_set_x_format(g_live, MP_FMT_TIME);
  mp_chart_set_y_range(g_live, -1.5, 1.5);
  mp_chart_keep(g_live, DASH_KEEP);
  mp_chart_window(g_live, DASH_WINDOW_S);
  mp_chart_series(g_live, "signal");
  mp_chart_push(g_live, 0, 0.0, 0.0);
  return mp_chart_error(g_live) == MP_OK;
}

fn build_template() -> bool {
  g_tpl = rz_template_new();
  if (g_tpl == 0) { return false; }
  var decls: RzVarMap;
  rz_vars_init(&decls);
  rz_vars_set(&decls, "title", "-");
  rz_vars_set(&decls, "interval", "-");
  rz_vars_set(&decls, "bar", "-");
  rz_vars_set(&decls, "live", "-");
  var trc: int32 = rz_template_from_string(g_tpl, DASH_PAGE, &decls);
  if (trc != RZ_TPL_OK) {
    println("dashboard: template refused: {rz_template_strerror(trc)}");
    return false;
  }
  return true;
}

// `--run-for S` from argv (rz_run reads --port itself).
fn parse_args(argc: int32, argv: cstring*) {
  var i: int32 = 1;
  while (i + 1 < argc) {
    var v: int64 = rz_str_to_int(rz_str_from_c(argv[i + 1]));
    if (rz_str_eq(rz_str_from_c(argv[i]), "--run-for") && v > 0 && v < 86400) { g_run_for = v; }
    i = i + 1;
  }
}

fn main(argc: int32, argv: cstring*) -> int32 {
  parse_args(argc, argv);
  g_t0 = bench_time_us();
  var rc: int32 = 1;
  if (build_bar() && build_live() && build_template()) {
    rc = rz_run("dashboard", &dash_app);
    var cs: MpChartStats;
    var rs: MpRaizeStats;
    mp_chart_stats(g_live, &cs);
    mp_raize_stats(g_live, &rs);
    println("dashboard: stopped; live seq={mp_chart_seq(g_live)} renders={cs.svg_renders} notices={rs.notices}");
  } else {
    println("dashboard: setup failed");
  }
  mp_raize_unregister(g_live);
  rz_template_free(g_tpl);
  mp_chart_free(g_live);
  mp_chart_free(g_bar);
  return rc;
}
