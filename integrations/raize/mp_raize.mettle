//! MistPlot charts served by RaizeWeb: one-line handlers for a chart's SVG, its <figure>
//! fragment and its live embed, template helpers that copy the markup into the request
//! arena, and push over a RaizeWeb channel. Every response carries the ETag
//! "<generation>-<seq>" with Cache-Control: no-cache, so a matching If-None-Match is a
//! bodiless 304 that never renders. The first use of a chart whose generation is 0 sets it
//! to the wall-clock time in microseconds, so a browser polling across a restart never
//! matches an old tag. A channel announces each new frame with the tiny notice
//! {"tag":"<gen>-<seq>"} (rz_broadcast); the page then fetches the SVG through the ETag
//! route, polling only while its socket is down. A RaizeWeb handler must return the HTTP
//! status it built, and every handler helper here returns it. Uses raize/app (rz_channel,
//! rz_broadcast), raize_core (context, vars), raize_realtime (channel callbacks), mistplot
//! (chart, render/svg, render/html, sync/share) and std/thread (the registry lock). The
//! library under src/ never imports this file.

import "std/mem";
import "std/thread";
import "raize_core/str/str";
import "raize_core/core/status";
import "raize_core/context/context";
import "raize_core/template/vars";
import "raize_realtime/channel/channel";
import "raize/app/app";
import "mistplot/core/error";
import "mistplot/core/mem";
import "mistplot/core/str";
import "mistplot/core/buf";
import "mistplot/core/format";
import "mistplot/chart/chart";
import "mistplot/render/svg";
import "mistplot/render/html";
import "mistplot/sync/share";

// Wall clock for the generation (CLOCK_REALTIME = 0 on Linux).
extern fn raize_clock_gettime(clk: int32, ts: cstring) -> int32 = "clock_gettime";

/// Most charts registered on channels at once (mp_raize_channel).
export const MP_RAIZE_MAX_CHANNELS: int32 = 16;

const RAIZE_CT_SVG: string = "image/svg+xml";
const RAIZE_CT_HTML: string = "text/html; charset=utf-8";
const RAIZE_FAIL_BODY: string = "chart render failed\n";
const RAIZE_BUF_CAP: int64 = 8192;
// RaizeWeb refuses longer topics on the wire (RZ_CHAN_MAX_TOPIC).
const RAIZE_MAX_TOPIC: int64 = 256;
const RAIZE_MAX_SOCKET: int64 = 1024;
// Room for "\"<20 digits>-<20 digits>\"" and the JSON around it.
const RAIZE_TAG_CAP: int64 = 96;

/// Counters of one chart registered with mp_raize_channel.
///
/// @mem Plain value; holds no pointers.
export struct MpRaizeStats {
  notices: int64;   /// "frame" notices queued with rz_broadcast
}

// ---------------------------------------------------------------------------
// Tags and responses
// ---------------------------------------------------------------------------

// Microseconds since the Unix epoch (0 when the clock cannot be read).
fn raize_now_us() -> int64 {
  var ts: uint8[16];
  if (raize_clock_gettime(0, (cstring)&ts[0]) != 0) { return 0; }
  var sec: int64 = *((int64*)&ts[0]);
  var nsec: int64 = *((int64*)&ts[8]);
  return sec * 1000000 + nsec / 1000;
}

// The chart's generation, stamped with the wall clock first when it is 0. Caller holds
// the chart lock (or no other thread uses the chart).
fn raize_gen(c: MpChart*) -> int64 {
  var g: int64 = mp_chart_generation(c);
  if (g == 0) {
    g = raize_now_us();
    if (g == 0) { g = 1; }
    mp_chart_set_generation(c, g);
  }
  return g;
}

fn raize_put(out: uint8*, pos: int64, s: string) -> int64 {
  var n: int64 = (int64)s.length;
  if (n > 0) { memcpy((rawptr)(out + pos), (rawptr)s.chars, n); }
  return pos + n;
}

// Writes `"<gen>-<seq>"` (with the quotes) at out[pos..] and returns the new position.
// The generation is written as its unsigned value, a negative seq as 0. Needs 44 bytes.
fn raize_tag_at(gen: int64, seq: int64, out: uint8*, pos: int64) -> int64 {
  var d: uint8[32];
  var s: uint64 = 0;
  if (seq > 0) { s = (uint64)seq; }
  out[pos] = 34;
  var p: int64 = raize_put(out, pos + 1, mp_fmt_u64((uint64)gen, &d[0], 32));
  out[p] = 45;
  p = raize_put(out, p + 1, mp_fmt_u64(s, &d[0], 32));
  out[p] = 34;
  return p + 1;
}

// The ETag for the chart's current frame, written into out (RAIZE_TAG_CAP bytes).
// Caller holds the chart lock.
fn raize_etag(c: MpChart*, out: uint8*) -> string {
  var n: int64 = raize_tag_at(raize_gen(c), mp_chart_seq(c), out, 0);
  return str_from_bytes((cstring)out, n);
}

// `{"tag":"<gen>-<seq>"}` for the chart's current frame. Caller holds the chart lock.
fn raize_tag_json(c: MpChart*, seq: int64, out: uint8*) -> string {
  var p: int64 = raize_put(out, 0, "{{\"tag\":");
  p = raize_tag_at(raize_gen(c), seq, out, p);
  out[p] = 125;
  return str_from_bytes((cstring)out, p + 1);
}

fn raize_ctx_ok(ctx: RzContext*) -> bool {
  if (ctx == 0) { return false; }
  return ctx->resp != 0;
}

// 500 with a fixed short body (the MP_* code is not shown to the client).
fn raize_fail(ctx: RzContext*) -> int32 {
  if (!raize_ctx_ok(ctx)) { return 500; }
  rz_ctx_text(ctx, 500, RAIZE_FAIL_BODY);
  return 500;
}

fn raize_size_ok(w: float64, h: float64) -> bool {
  if (!(w > 0.0) || !(w < 1e9)) { return false; }
  return h > 0.0 && h < 1e9;
}

fn raize_is_ows(c: uint8) -> bool {
  return c == 32 || c == 9;
}

// True when one If-None-Match member equals `tag` (quoted). Accepted spellings: "5"
// (strong), W/"5" (If-None-Match compares weakly, RFC 9110) and a bare 5 (a client that
// dropped the quotes).
fn raize_member_eq(m: string, tag: string) -> bool {
  var n: int64 = (int64)m.length;
  var t: int64 = (int64)tag.length;
  var s: int64 = 0;
  if (n >= 2 && m.chars[0] == 87 && m.chars[1] == 47) { s = 2; }
  var len: int64 = n - s;
  if (len == t) {
    var i: int64 = 0;
    while (i < t) {
      if (m.chars[s + i] != tag.chars[i]) { return false; }
      i = i + 1;
    }
    return true;
  }
  if (t >= 2 && len == t - 2) {
    var k: int64 = 0;
    while (k < len) {
      if (m.chars[s + k] != tag.chars[1 + k]) { return false; }
      k = k + 1;
    }
    return true;
  }
  return false;
}

// True when the request's If-None-Match is `*` or lists `tag`.
fn raize_inm_matches(ctx: RzContext*, tag: string) -> bool {
  if (ctx->req == 0) { return false; }
  var v: string = rz_req_header(ctx->req, "If-None-Match");
  var n: int64 = (int64)v.length;
  var i: int64 = 0;
  while (i < n) {
    while (i < n && (raize_is_ows(v.chars[i]) || v.chars[i] == 44)) { i = i + 1; }
    var start: int64 = i;
    while (i < n && v.chars[i] != 44) { i = i + 1; }
    var end: int64 = i;
    while (end > start && raize_is_ows(v.chars[end - 1])) { end = end - 1; }
    if (end > start) {
      if (end - start == 1 && v.chars[start] == 42) { return true; }
      if (raize_member_eq(str_from_bytes((cstring)&v.chars[start], end - start), tag)) {
        return true;
      }
    }
  }
  return false;
}

fn raize_headers(ctx: RzContext*, tag: string) -> bool {
  if (rz_resp_header_set(ctx->resp, "ETag", tag) != 0) { return false; }
  return rz_resp_header_set(ctx->resp, "Cache-Control", "no-cache") == 0;
}

// The shared body of mp_raize_svg and mp_raize_html, with the chart locked.
fn raize_serve(ctx: RzContext*, c: MpChart*, w: float64, h: float64, html: bool) -> int32 {
  var tb: uint8[96];
  var tag: string = raize_etag(c, &tb[0]);
  if (raize_inm_matches(ctx, tag)) {
    if (!raize_headers(ctx, tag)) { return raize_fail(ctx); }
    rz_ctx_empty(ctx, 304);
    return 304;
  }
  if (!html) {
    var view: string = mp_chart_svg_view(c, w, h);
    if (view.length == 0) { return raize_fail(ctx); }
    if (!raize_headers(ctx, tag)) { return raize_fail(ctx); }
    return rz_ctx_bytes(ctx, 200, RAIZE_CT_SVG, view);
  }
  var b: MpBuf* = mp_buf_new(RAIZE_BUF_CAP);
  if (b == 0) { return raize_fail(ctx); }
  defer mp_buf_free(b);
  if (mp_chart_html(c, w, h, b) != MP_OK || mp_buf_len(b) == 0) { return raize_fail(ctx); }
  if (!raize_headers(ctx, tag)) { return raize_fail(ctx); }
  return rz_ctx_bytes(ctx, 200, RAIZE_CT_HTML, mp_buf_str(b));
}

fn raize_serve_locked(ctx: RzContext*, c: MpChart*, w: float64, h: float64, html: bool) -> int32 {
  if (!raize_ctx_ok(ctx)) { return 500; }
  if (c == 0 || !raize_size_ok(w, h)) { return raize_fail(ctx); }
  mp_chart_lock(c);
  var st: int32 = raize_serve(ctx, c, w, h, html);
  mp_chart_unlock(c);
  return st;
}

/// Handler body: the chart as a standalone image/svg+xml document of w x h px, exactly
/// mp_chart_svg's output. ETag "<gen>-<seq>" with Cache-Control: no-cache; an
/// If-None-Match that lists the tag (strong, weak or bare) or is * answers 304 with no
/// body and no render.
/// Several requests at one seq and size render once (the chart's SVG cache).
///
/// @param ctx The request. Valid: a RaizeWeb handler context; 0 (or no response) gives 500.
/// @param c The chart. Valid: non-zero; 0 answers 500.
/// @param w Width. Units: px. Valid: finite, in (0, 1e9); otherwise 500.
/// @param h Height. Units: px. Valid: finite, in (0, 1e9); otherwise 500.
/// @return The HTTP status the response was built with: 200, 304, or 500 with the body
///   "chart render failed\n" (also when the frame cannot be rendered).
/// @mem Borrows c for the call; the response copies the bytes. Nothing is retained.
/// @thread Worker threads call it concurrently: call mp_chart_share(c) before serving
///   (mp_raize_channel does). The chart stays locked while the bytes are copied.
/// @cost O(1) for a 304 or a cached frame; otherwise one frame plus the SVG.
export fn mp_raize_svg(ctx: RzContext*, c: MpChart*, w: float64, h: float64) -> int32 {
  return raize_serve_locked(ctx, c, w, h, false);
}

/// Handler body: the chart as a text/html <figure class="mp-figure"> fragment of w x h
/// px (mp_chart_html), for partial page swaps. Same ETag and 304 rules as mp_raize_svg.
///
/// @param ctx The request. Valid: a RaizeWeb handler context; 0 (or no response) gives 500.
/// @param c The chart. Valid: non-zero; 0 answers 500.
/// @param w Width. Units: px. Valid: finite, in (0, 1e9); otherwise 500.
/// @param h Height. Units: px. Valid: finite, in (0, 1e9); otherwise 500.
/// @return The HTTP status the response was built with: 200, 304, or 500 with the body
///   "chart render failed\n".
/// @mem Borrows c for the call; the fragment goes through one scratch buffer, freed on
///   return, and the response copies it.
/// @thread As mp_raize_svg: call mp_chart_share(c) before serving.
/// @cost O(1) for a 304; otherwise as mp_chart_html plus one allocation.
export fn mp_raize_html(ctx: RzContext*, c: MpChart*, w: float64, h: float64) -> int32 {
  return raize_serve_locked(ctx, c, w, h, true);
}

// ---------------------------------------------------------------------------
// Channel registry
// ---------------------------------------------------------------------------

// One chart on a channel topic. A channel callback gets no user pointer, so the
// callbacks find the chart by topic in this table.
struct RaizeEntry {
  c: MpChart*;        // borrowed
  topic: string;      // owned copy
  socket: string;     // owned copy: the socket URL the embed joins
  notice_seq: int64;  // seq of the last queued notice, -1 for none
  notices: int64;     // notices queued
}

var g_raize_reg: RaizeEntry*[16];   // MP_RAIZE_MAX_CHANNELS
var g_raize_reg_n: int32 = 0;
// Order: this lock, then the chart's lock; nothing takes them the other way round
// (hence mp_raize_notify must not run under mp_chart_lock).
var g_raize_reg_lock: int32 = 0;

// Caller holds the registry lock.
fn raize_find_chart(c: MpChart*) -> RaizeEntry* {
  var i: int32 = 0;
  while (i < g_raize_reg_n) {
    if (g_raize_reg[i]->c == c) { return g_raize_reg[i]; }
    i = i + 1;
  }
  return 0;
}

// Caller holds the registry lock.
fn raize_find_topic(topic: string) -> RaizeEntry* {
  var i: int32 = 0;
  while (i < g_raize_reg_n) {
    if (rz_str_eq(g_raize_reg[i]->topic, topic)) { return g_raize_reg[i]; }
    i = i + 1;
  }
  return 0;
}

// Channel callbacks (hub thread). Kept private: an exported function with a string
// parameter called through a function pointer gets a garbage string in debug builds.
fn raize_chan_join(ctx: RzChanCtx*, payload: string) -> int32 {
  spin_lock(&g_raize_reg_lock);
  var e: RaizeEntry* = raize_find_topic(ctx->topic);
  if (e == 0) {
    spin_unlock(&g_raize_reg_lock);
    rz_chan_reply_json(ctx, "{{\"reason\":\"unknown chart\"}");
    return 1;
  }
  var jb: uint8[96];
  mp_chart_lock(e->c);
  var j: string = raize_tag_json(e->c, mp_chart_seq(e->c), &jb[0]);
  mp_chart_unlock(e->c);
  spin_unlock(&g_raize_reg_lock);
  rz_chan_reply_json(ctx, j);
  return 0;
}

fn raize_chan_in(ctx: RzChanCtx*, event: string, payload: string) -> int32 {
  if (rz_str_eq(event, "heartbeat")) {
    rz_chan_reply_json(ctx, "{{}");
    return 0;
  }
  rz_chan_reply_json(ctx, "{{\"reason\":\"unknown event\"}");
  return 1;
}

fn raize_chan_leave(ctx: RzChanCtx*) {
}

fn raize_entry_free(e: RaizeEntry*) {
  mp_str_free(e->topic);
  mp_str_free(e->socket);
  mp_free((rawptr)e);
}

// Caller holds the registry lock.
fn raize_reg_add(c: MpChart*, topic: string, socket_path: string) -> int32 {
  if (raize_find_chart(c) != 0 || raize_find_topic(topic) != 0) { return MP_ERR_STATE; }
  if (g_raize_reg_n >= MP_RAIZE_MAX_CHANNELS) { return MP_ERR_LIMIT; }
  var e: RaizeEntry* = (RaizeEntry*)mp_alloc_zero(sizeof(RaizeEntry));
  if (e == 0) { return MP_ERR_ALLOC; }
  e->c = c;
  e->topic = mp_str_dup(topic);
  e->socket = mp_str_dup(socket_path);
  e->notice_seq = -1;
  if (e->topic.length == 0 || e->socket.length == 0) {
    raize_entry_free(e);
    return MP_ERR_ALLOC;
  }
  g_raize_reg[g_raize_reg_n] = e;
  g_raize_reg_n = g_raize_reg_n + 1;
  return MP_OK;
}

/// Puts a chart on a channel topic: declares topic with rz_channel (rz_run then serves it
/// on GET /socket/websocket), records the chart under it and shares the chart
/// (mp_chart_share). A join is answered {"tag":"<gen>-<seq>"} for the current frame, a
/// "heartbeat" event ok and any other event with an error; mp_raize_notify announces new
/// frames, and mp_raize_embed and mp_raize_tpl_embed give the channel embed from then on.
///
/// @param app The app being declared. Valid: the RzApp* rz_run passed to the declaration
///   function.
/// @param c The chart. Valid: non-zero, not registered yet.
/// @param topic The exact topic, e.g. "chart:cpu"; copied. Valid: 1 .. 256 bytes, not
///   registered yet.
/// @param socket_path The socket URL the embed joins, relative to the page or absolute;
///   copied. Valid: 1 .. 1024 bytes; "/socket/websocket" unless a proxy moves it.
/// @return MP_OK, or an error code.
/// @error MP_ERR_ARG app or c is 0, or topic or socket_path is empty or too long; nothing
///   changes.
/// @error MP_ERR_STATE c or topic is already registered; nothing changes.
/// @error MP_ERR_LIMIT MP_RAIZE_MAX_CHANNELS charts are registered; nothing changes.
/// @error MP_ERR_ALLOC the copies could not be made; nothing changes.
/// @mem Copies topic and socket_path. Borrows c until mp_raize_unregister: unregister
///   before mp_chart_free. A full app channel table is reported by rz_run.
/// @thread The declaration function only (rz_channel's rule), before c is used from
///   another thread.
export fn mp_raize_channel(app: RzApp*, c: MpChart*, topic: string, socket_path: string) -> int32 {
  if (app == 0 || c == 0) { return MP_ERR_ARG; }
  var tl: int64 = (int64)topic.length;
  var sl: int64 = (int64)socket_path.length;
  if (tl == 0 || tl > RAIZE_MAX_TOPIC || sl == 0 || sl > RAIZE_MAX_SOCKET) {
    return MP_ERR_ARG;
  }
  spin_lock(&g_raize_reg_lock);
  var rc: int32 = raize_reg_add(c, topic, socket_path);
  spin_unlock(&g_raize_reg_lock);
  if (rc != MP_OK) { return rc; }
  mp_chart_share(c);
  rz_channel(app, topic, &raize_chan_join, &raize_chan_in, &raize_chan_leave);
  return MP_OK;
}

/// Takes a chart off its channel: joins on its topic are refused with
/// {"reason":"unknown chart"} from then on and mp_raize_notify answers MP_ERR_STATE. The
/// topic stays declared in the app; registering a chart under it again revives it.
///
/// @param c The chart. Valid: registered with mp_raize_channel.
/// @return MP_OK, or an error code.
/// @error MP_ERR_ARG c is 0.
/// @error MP_ERR_STATE c is not registered; nothing changes.
/// @mem Frees the copies mp_raize_channel made; c may be freed afterwards.
/// @thread Any thread; not while holding mp_chart_lock(c).
export fn mp_raize_unregister(c: MpChart*) -> int32 {
  if (c == 0) { return MP_ERR_ARG; }
  spin_lock(&g_raize_reg_lock);
  var i: int32 = 0;
  var found: RaizeEntry* = 0;
  while (i < g_raize_reg_n) {
    if (g_raize_reg[i]->c == c) {
      found = g_raize_reg[i];
      var j: int32 = i;
      while (j + 1 < g_raize_reg_n) {
        g_raize_reg[j] = g_raize_reg[j + 1];
        j = j + 1;
      }
      g_raize_reg_n = g_raize_reg_n - 1;
      g_raize_reg[g_raize_reg_n] = 0;
      break;
    }
    i = i + 1;
  }
  spin_unlock(&g_raize_reg_lock);
  if (found == 0) { return MP_ERR_STATE; }
  raize_entry_free(found);
  return MP_OK;
}

/// Announces the chart's current frame on its topic with one "frame" notice
/// {"tag":"<gen>-<seq>"} (rz_broadcast) when seq moved since the last notice; call it
/// after a batch of changes. Many changes between two calls give one notice. A notice
/// that could not be queued stays pending and the next call posts it.
///
/// @param c The chart. Valid: registered with mp_raize_channel.
/// @return MP_OK (also when nothing moved), or an error code.
/// @error MP_ERR_ARG c is 0.
/// @error MP_ERR_STATE c is not registered, or rz_run is not serving yet; the notice stays
///   pending.
/// @error MP_ERR_IO the hub's mailbox is full; the notice stays pending.
/// @mem Nothing is retained; rz_broadcast copies the payload.
/// @thread Any thread (producers, rz_every ticks, handlers); not while holding
///   mp_chart_lock(c).
/// @cost O(1); a few dozen bytes per notice.
export fn mp_raize_notify(c: MpChart*) -> int32 {
  if (c == 0) { return MP_ERR_ARG; }
  spin_lock(&g_raize_reg_lock);
  var e: RaizeEntry* = raize_find_chart(c);
  if (e == 0) {
    spin_unlock(&g_raize_reg_lock);
    return MP_ERR_STATE;
  }
  var jb: uint8[96];
  mp_chart_lock(c);
  var seq: int64 = mp_chart_seq(c);
  var j: string = raize_tag_json(c, seq, &jb[0]);
  mp_chart_unlock(c);
  var rc: int32 = MP_OK;
  if (seq != e->notice_seq) {
    var st: int32 = rz_broadcast(e->topic, "frame", j);
    if (st == RZ_OK) {
      e->notice_seq = seq;
      e->notices = e->notices + 1;
    } else if (st == RZ_E_FULL) {
      rc = MP_ERR_IO;
    } else {
      rc = MP_ERR_STATE;
    }
  }
  spin_unlock(&g_raize_reg_lock);
  return rc;
}

/// Copies the counters of a registered chart.
///
/// @param c The chart. Valid: registered with mp_raize_channel.
/// @param out Receives the counters. Valid: non-zero.
/// @return MP_OK, or an error code.
/// @error MP_ERR_ARG c or out is 0; out is unchanged.
/// @error MP_ERR_STATE c is not registered; *out is zeroed.
/// @mem Writes *out only.
/// @thread Any thread.
export fn mp_raize_stats(c: MpChart*, out: MpRaizeStats*) -> int32 {
  if (c == 0 || out == 0) { return MP_ERR_ARG; }
  out->notices = 0;
  spin_lock(&g_raize_reg_lock);
  var e: RaizeEntry* = raize_find_chart(c);
  var rc: int32 = MP_ERR_STATE;
  if (e != 0) {
    out->notices = e->notices;
    rc = MP_OK;
  }
  spin_unlock(&g_raize_reg_lock);
  return rc;
}

// ---------------------------------------------------------------------------
// Embeds and templates
// ---------------------------------------------------------------------------

// The live embed for c into out: the channel script when c is registered, the polling one
// otherwise, with the current frame inside the div.
fn raize_embed_into(c: MpChart*, w: float64, h: float64, url: string, interval_ms: int32,
                    out: MpBuf*) -> int32 {
  if (c == 0 || out == 0 || !raize_size_ok(w, h)) { return MP_ERR_ARG; }
  spin_lock(&g_raize_reg_lock);
  var e: RaizeEntry* = raize_find_chart(c);
  mp_chart_lock(c);
  raize_gen(c);
  var view: string = mp_chart_svg_view(c, w, h);
  var rc: int32 = MP_OK;
  if (view.length == 0) {
    rc = mp_chart_error(c);
    if (rc == MP_OK) { rc = MP_ERR_STATE; }
  } else if (e != 0) {
    rc = mp_html_live(url, interval_ms, e->socket, e->topic, view, out);
  } else {
    rc = mp_html_live(url, interval_ms, "", "", view, out);
  }
  mp_chart_unlock(c);
  spin_unlock(&g_raize_reg_lock);
  return rc;
}

/// Handler body: the live embed for c as a text/html fragment: <div class="mp-live">
/// holding the current w x h frame, then the script (mp_html_live) that keeps it current
/// from url. When c is on a channel (mp_raize_channel) the script joins its topic and
/// fetches only on a new tag, polling while the socket is down; otherwise it polls.
///
/// @param ctx The request. Valid: a RaizeWeb handler context; 0 (or no response) gives 500.
/// @param c The chart. Valid: non-zero; 0 answers 500.
/// @param w Width of the first frame. Units: px. Valid: finite, in (0, 1e9); otherwise 500.
/// @param h Height of the first frame. Units: px. Valid: finite, in (0, 1e9); otherwise 500.
/// @param url The chart's SVG route (served by mp_raize_svg at the same size). Valid:
///   non-empty; otherwise 500.
/// @param interval_ms Poll interval. Units: ms. Valid: 1 .. MP_LIVE_MAX_INTERVAL_MS;
///   otherwise 500.
/// @return The HTTP status the response was built with: 200, or 500 with the body
///   "chart render failed\n".
/// @mem Borrows c for the call; one scratch buffer, freed on return; the response copies it.
/// @thread As mp_raize_svg: call mp_chart_share(c) before serving.
/// @cost As mp_chart_svg_view plus the script (about 5 KB).
export fn mp_raize_embed(ctx: RzContext*, c: MpChart*, w: float64, h: float64, url: string,
                         interval_ms: int32) -> int32 {
  if (!raize_ctx_ok(ctx)) { return 500; }
  var b: MpBuf* = mp_buf_new(RAIZE_BUF_CAP);
  if (b == 0) { return raize_fail(ctx); }
  defer mp_buf_free(b);
  if (raize_embed_into(c, w, h, url, interval_ms, b) != MP_OK) { return raize_fail(ctx); }
  return rz_ctx_bytes(ctx, 200, RAIZE_CT_HTML, mp_buf_str(b));
}

// Copies b and name into the request arena and binds them in vars.
fn raize_bind(ctx: RzContext*, vars: RzVarMap*, name: string, b: MpBuf*) -> int32 {
  var n: int64 = mp_buf_len(b);
  var v: string = rz_arena_bytes(ctx->arena, b->data, n);
  var k: string = rz_arena_str(ctx->arena, name);
  if ((int64)v.length != n || k.length != name.length) { return MP_ERR_ALLOC; }
  if (rz_vars_set(vars, k, v) != 0) { return MP_ERR_LIMIT; }
  return MP_OK;
}

fn raize_tpl_ok(ctx: RzContext*, vars: RzVarMap*, name: string, c: MpChart*) -> bool {
  if (ctx == 0 || ctx->arena == 0 || vars == 0 || c == 0) { return false; }
  return name.length > 0;
}

/// Template helper: binds name in vars to the chart's <figure> fragment of w x h px
/// (mp_chart_html), for a raw {{{name}}} placeholder.
///
/// @param ctx The request; its arena receives the copy. Valid: a handler context with an
///   arena.
/// @param vars The template variables. Valid: non-zero.
/// @param name The placeholder name; copied. Valid: 1 .. RZ_TEMPLATE_MAX_NAME bytes.
/// @param c The chart. Valid: non-zero.
/// @param w Width. Units: px. Valid: finite, in (0, 1e9).
/// @param h Height. Units: px. Valid: finite, in (0, 1e9).
/// @return MP_OK, or an error code; on an error name is not bound.
/// @error MP_ERR_ARG ctx, its arena, vars or c is 0, or name is empty, or the size is out
///   of range.
/// @error MP_ERR_ALLOC the scratch buffer or the request arena (64 KB per request) is full.
/// @error MP_ERR_LIMIT vars is full or refuses the name.
/// @mem The fragment and the name are copied into ctx->arena (rz_arena_bytes), so they live
///   until the request ends; no caller buffer is involved.
/// @thread As mp_raize_svg: call mp_chart_share(c) before serving.
export fn mp_raize_tpl_figure(ctx: RzContext*, vars: RzVarMap*, name: string, c: MpChart*,
                              w: float64, h: float64) -> int32 {
  if (!raize_tpl_ok(ctx, vars, name, c) || !raize_size_ok(w, h)) { return MP_ERR_ARG; }
  var b: MpBuf* = mp_buf_new(RAIZE_BUF_CAP);
  if (b == 0) { return MP_ERR_ALLOC; }
  defer mp_buf_free(b);
  mp_chart_lock(c);
  raize_gen(c);
  var rc: int32 = mp_chart_html(c, w, h, b);
  mp_chart_unlock(c);
  if (rc != MP_OK) { return rc; }
  return raize_bind(ctx, vars, name, b);
}

/// Template helper: binds name in vars to the chart's live embed, exactly the body of
/// mp_raize_embed with the same arguments, for a raw {{{name}}} placeholder.
///
/// @param ctx The request; its arena receives the copy. Valid: a handler context with an
///   arena.
/// @param vars The template variables. Valid: non-zero.
/// @param name The placeholder name; copied. Valid: 1 .. RZ_TEMPLATE_MAX_NAME bytes.
/// @param c The chart. Valid: non-zero.
/// @param w Width of the first frame. Units: px. Valid: finite, in (0, 1e9).
/// @param h Height of the first frame. Units: px. Valid: finite, in (0, 1e9).
/// @param url The chart's SVG route. Valid: non-empty.
/// @param interval_ms Poll interval. Units: ms. Valid: 1 .. MP_LIVE_MAX_INTERVAL_MS.
/// @return MP_OK, or an error code; on an error name is not bound.
/// @error MP_ERR_ARG ctx, its arena, vars or c is 0, name or url is empty, or the size or
///   interval_ms is out of range.
/// @error MP_ERR_ALLOC the scratch buffer or the request arena (64 KB per request) is full.
/// @error MP_ERR_LIMIT vars is full or refuses the name.
/// @mem The embed and the name are copied into ctx->arena (rz_arena_bytes).
/// @thread As mp_raize_svg: call mp_chart_share(c) before serving.
export fn mp_raize_tpl_embed(ctx: RzContext*, vars: RzVarMap*, name: string, c: MpChart*,
                             w: float64, h: float64, url: string, interval_ms: int32) -> int32 {
  if (!raize_tpl_ok(ctx, vars, name, c)) { return MP_ERR_ARG; }
  var b: MpBuf* = mp_buf_new(RAIZE_BUF_CAP);
  if (b == 0) { return MP_ERR_ALLOC; }
  defer mp_buf_free(b);
  var rc: int32 = raize_embed_into(c, w, h, url, interval_ms, b);
  if (rc != MP_OK) { return rc; }
  return raize_bind(ctx, vars, name, b);
}
