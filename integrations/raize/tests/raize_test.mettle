// The RaizeWeb helpers, driven without a socket.
//
// Each request is built as a RaizeWeb worker builds it (rz_arena_reset, rz_request_init,
// rz_response_reset, rz_ctx_init) and dispatched through a real router, so every check
// also goes through the router's status contract. The channel part declares the topic on
// an app made with rz__app_new, wires the hub and channel router by hand the way rz_run
// does, and calls the callbacks through the router's definition table; the hub never
// gets a socket. Deterministic apart from the generation, which is read once from the
// clock and compared only through mp_chart_generation. Exit code 0 on pass.

import "std/io";
import "std/mem";
import "std/thread";
import "mistplot/test/harness";
import "mistplot/mistplot";
import "mistplot/core/mem";
import "mistplot/core/format";
import "raize_core/str/str";
import "raize_core/core/status";
import "raize_core/context/context";
import "raize_core/router/router";
import "raize_template/template";
import "raize_template/vars";
import "raize_realtime/hub/hub";
import "raize_realtime/channel/channel";
import "raize_app/app";
import "../mp_raize";

var g_rt: RzRouter* = 0;
var g_arena: RzArena* = 0;
var g_resp: RzResponse* = 0;
var g_req: RzRequest;
var g_ctx: RzContext;

var g_bar: MpChart* = 0;
var g_live: MpChart* = 0;

fn h_svg(ctx: RzContext*) -> int32 { return mp_raize_svg(ctx, g_bar, 480.0, 300.0); }
fn h_fig(ctx: RzContext*) -> int32 { return mp_raize_html(ctx, g_bar, 480.0, 300.0); }
fn h_bad(ctx: RzContext*) -> int32 { return mp_raize_svg(ctx, g_bar, 0.0, 300.0); }
fn h_none(ctx: RzContext*) -> int32 { return mp_raize_svg(ctx, 0, 480.0, 300.0); }
fn h_live(ctx: RzContext*) -> int32 { return mp_raize_svg(ctx, g_live, 480.0, 240.0); }
fn h_embed(ctx: RzContext*) -> int32 {
  return mp_raize_embed(ctx, g_live, 480.0, 240.0, "/live.svg", 500);
}
fn h_embed_bad(ctx: RzContext*) -> int32 {
  return mp_raize_embed(ctx, g_live, 480.0, 240.0, "/live.svg", 0);
}

// One request, built as a worker builds it. `inm` empty = no header.
fn run(verb: string, path: string, inm: string) -> int32 {
  rz_arena_reset(g_arena);
  if (!rz_request_init(&g_req, g_arena)) { return -1; }
  g_req.verb = verb;
  g_req.path = path;
  g_req.target = path;
  if (inm.length > 0) {
    g_req.headers[0].name = "If-None-Match";
    g_req.headers[0].value = inm;
    g_req.header_count = 1;
  }
  rz_response_reset(g_resp);
  rz_ctx_init(&g_ctx, &g_req, g_resp, g_arena);
  return rz_router_handle(g_rt, &g_ctx);
}

fn body() -> string { return rz_buf_str(g_resp->body); }
fn hdr(name: string) -> string { return rz_resp_header_get(g_resp, name); }

fn renders(c: MpChart*) -> int64 {
  var st: MpChartStats;
  mp_chart_stats(c, &st);
  return st.svg_renders;
}

fn notices(c: MpChart*) -> int64 {
  var st: MpRaizeStats;
  st.notices = -1;
  mp_raize_stats(c, &st);
  return st.notices;
}

fn put(out: uint8*, pos: int64, s: string) -> int64 {
  var i: int64 = 0;
  while (i < (int64)s.length) {
    out[pos + i] = s.chars[i];
    i = i + 1;
  }
  return pos + (int64)s.length;
}

// `"<gen>-<seq>"` into out (64 bytes); returns the view.
fn seq_tag(gen: int64, seq: int64, out: uint8*) -> string {
  var d: uint8[32];
  out[0] = 34;
  var p: int64 = put(out, 1, mp_fmt_u64((uint64)gen, &d[0], 32));
  out[p] = 45;
  p = put(out, p + 1, mp_fmt_u64((uint64)seq, &d[0], 32));
  out[p] = 34;
  return str_from_bytes((cstring)out, p + 1);
}

// `{"tag":"<gen>-<seq>"}` into out (96 bytes); returns the view.
fn tag_json(gen: int64, seq: int64, out: uint8*) -> string {
  var tb: uint8[64];
  var p: int64 = put(out, 0, "{{\"tag\":");
  p = put(out, p, seq_tag(gen, seq, &tb[0]));
  out[p] = 125;
  return str_from_bytes((cstring)out, p + 1);
}

// ---------------------------------------------------------------------------
// Static
// ---------------------------------------------------------------------------

fn check_static() {
  var want: MpBuf* = mp_buf_new(4096);
  defer mp_buf_free(want);
  mp_expect("chart_svg ok", mp_chart_svg(g_bar, 480.0, 300.0, want) == MP_OK);
  mp_expect_i64("no generation before first use", mp_chart_generation(g_bar), 0);

  var st: int32 = run("GET", "/s.svg", "");
  mp_expect_i64("svg status", (int64)st, 200);
  mp_expect_i64("svg ctx status", (int64)g_ctx.status, 200);
  mp_expect_str("svg content-type", hdr("Content-Type"), "image/svg+xml");
  mp_expect_str("svg cache-control", hdr("Cache-Control"), "no-cache");
  mp_expect("svg body == mp_chart_svg", body() == mp_buf_str(want));
  var gen: int64 = mp_chart_generation(g_bar);
  mp_expect("first use stamps a wall-clock generation", gen > (int64)1600000000000000);
  var tb: uint8[64];
  var tag: string = seq_tag(gen, mp_chart_seq(g_bar), &tb[0]);
  mp_expect_str("etag is quoted gen-seq", hdr("ETag"), tag);

  var r0: int64 = renders(g_bar);
  st = run("GET", "/s.svg", "");
  mp_expect_str("etag stable", hdr("ETag"), tag);
  mp_expect("same body", body() == mp_buf_str(want));
  mp_expect_i64("same seq and size: no render", renders(g_bar), r0);

  st = run("GET", "/s.svg", tag);
  mp_expect_i64("svg 304", (int64)st, 304);
  mp_expect_i64("svg 304 empty body", rz_resp_body_len(g_resp), 0);
  mp_expect_str("svg 304 keeps etag", hdr("ETag"), tag);
  mp_expect_str("svg 304 cache-control", hdr("Cache-Control"), "no-cache");

  var wk: uint8[96];
  var n: int64 = put(&wk[0], 0, "W/");
  n = put(&wk[0], n, tag);
  st = run("GET", "/s.svg", str_from_bytes((cstring)&wk[0], n));
  mp_expect_i64("svg 304 weak", (int64)st, 304);
  var ls: uint8[128];
  n = put(&ls[0], 0, "\"zz\" ,  ");
  n = put(&ls[0], n, tag);
  st = run("GET", "/s.svg", str_from_bytes((cstring)&ls[0], n));
  mp_expect_i64("svg 304 list", (int64)st, 304);
  var bare: string = rz_str_sub(tag, 1, (int64)tag.length - 1);
  st = run("GET", "/s.svg", bare);
  mp_expect_i64("svg 304 bare", (int64)st, 304);
  st = run("GET", "/s.svg", "*");
  mp_expect_i64("svg 304 star", (int64)st, 304);
  mp_expect_i64("304s never render", renders(g_bar), r0);

  st = run("GET", "/s.svg", "\"0-0\"");
  mp_expect_i64("stale tag 200", (int64)st, 200);
  mp_expect("stale body", body() == mp_buf_str(want));
  st = run("HEAD", "/s.svg", "");
  mp_expect_i64("HEAD routed as GET", (int64)st, 200);

  var fig: MpBuf* = mp_buf_new(4096);
  defer mp_buf_free(fig);
  mp_expect("chart_html ok", mp_chart_html(g_bar, 480.0, 300.0, fig) == MP_OK);
  st = run("GET", "/f.html", "");
  mp_expect_i64("fig status", (int64)st, 200);
  mp_expect_str("fig content-type", hdr("Content-Type"), "text/html; charset=utf-8");
  mp_expect("fig body == mp_chart_html", body() == mp_buf_str(fig));
  mp_expect_str("fig etag", hdr("ETag"), tag);
  st = run("GET", "/f.html", tag);
  mp_expect_i64("fig 304", (int64)st, 304);

  st = run("GET", "/bad.svg", "");
  mp_expect_i64("bad size status", (int64)st, 500);
  mp_expect_str("bad content-type", hdr("Content-Type"), "text/plain; charset=utf-8");
  mp_expect_str("bad body", body(), "chart render failed\n");
  mp_expect_i64("bad has no etag", (int64)hdr("ETag").length, 0);
  st = run("GET", "/none.svg", "");
  mp_expect_i64("null chart 500", (int64)st, 500);
  mp_expect_i64("null ctx", (int64)mp_raize_svg(0, g_bar, 480.0, 300.0), 500);
  mp_expect_i64("null ctx html", (int64)mp_raize_html(0, g_bar, 480.0, 300.0), 500);
}

fn check_template() {
  var t: RzTemplate* = rz_template_new();
  defer rz_template_free(t);
  var decls: RzVarMap;
  rz_vars_init(&decls);
  rz_vars_set(&decls, "chart", "-");
  var trc: int32 = rz_template_from_string(t, "<main>{{{{{{chart}}}</main>", &decls);
  mp_expect_i64("template compiles", (int64)trc, (int64)RZ_TPL_OK);

  var fig: MpBuf* = mp_buf_new(4096);
  defer mp_buf_free(fig);
  mp_chart_html(g_bar, 480.0, 300.0, fig);

  run("GET", "/nothing", "");
  var page: RzBuf* = rz_buf_new_cap(256);
  defer rz_buf_free(page);
  var vars: RzVarMap;
  rz_vars_init(&vars);
  var nb: uint8[8];
  put(&nb[0], 0, "chart");
  var name: string = str_from_bytes((cstring)&nb[0], 5);
  var used: int64 = rz_arena_used(g_arena);
  mp_expect("tpl_figure ok", mp_raize_tpl_figure(&g_ctx, &vars, name, g_bar, 480.0, 300.0) == MP_OK);
  mp_expect("tpl_figure copied into the arena", rz_arena_used(g_arena) >= used + mp_buf_len(fig));
  nb[0] = 88;   // the name was copied as well
  mp_expect("tpl_figure bound", rz_vars_get(&vars, "chart") == mp_buf_str(fig));
  var rr: int32 = rz_template_render_into(t, &vars, page);
  mp_expect_i64("template renders", (int64)rr, (int64)RZ_TPL_OK);
  var got: string = rz_buf_str(page);
  var flen: int64 = mp_buf_len(fig);
  mp_expect_i64("template length", (int64)got.length, flen + 13);
  mp_expect("template prefix", rz_str_starts(got, "<main><figure class=\"mp-figure\">"));
  mp_expect("template body == figure (raw)", rz_str_sub(got, 6, 6 + flen) == mp_buf_str(fig));

  var bad: RzVarMap;
  rz_vars_init(&bad);
  mp_expect_i64("tpl_figure null chart", (int64)mp_raize_tpl_figure(&g_ctx, &bad, "chart", 0,
                480.0, 300.0), (int64)MP_ERR_ARG);
  mp_expect_i64("tpl_figure empty name", (int64)mp_raize_tpl_figure(&g_ctx, &bad, "", g_bar,
                480.0, 300.0), (int64)MP_ERR_ARG);
  mp_expect_i64("tpl_figure bad size", (int64)mp_raize_tpl_figure(&g_ctx, &bad, "chart", g_bar,
                480.0, -1.0), (int64)MP_ERR_ARG);
  mp_expect_i64("tpl_figure null ctx", (int64)mp_raize_tpl_figure(0, &bad, "chart", g_bar,
                480.0, 300.0), (int64)MP_ERR_ARG);
  mp_expect("failed tpl_figure binds nothing", !rz_vars_has(&bad, "chart"));
}

// ---------------------------------------------------------------------------
// Live
// ---------------------------------------------------------------------------

fn check_live() {
  // An app-chosen generation is kept.
  mp_chart_set_generation(g_live, 42);
  var st: int32 = run("GET", "/live.svg", "");
  mp_expect_i64("empty live chart renders", (int64)st, 200);
  mp_expect_i64("an app-chosen generation is kept", mp_chart_generation(g_live), 42);
  var i: int32 = 0;
  while (i < 20) {
    mp_chart_push(g_live, 0, (float64)i * 0.5, (float64)((i * 7) % 11));
    i = i + 1;
  }
  var seq: int64 = mp_chart_seq(g_live);
  var tb: uint8[64];
  var tag: string = seq_tag(42, seq, &tb[0]);
  var r0: int64 = renders(g_live);
  st = run("GET", "/live.svg", "");
  mp_expect_i64("live status", (int64)st, 200);
  mp_expect_str("live etag", hdr("ETag"), tag);
  mp_expect_i64("live one render", renders(g_live), r0 + 1);
  var want: MpBuf* = mp_buf_new(4096);
  defer mp_buf_free(want);
  mp_chart_svg(g_live, 480.0, 240.0, want);
  mp_expect("live body == mp_chart_svg", body() == mp_buf_str(want));
  r0 = renders(g_live) - 1;   // mp_chart_svg counts as one
  var k: int32 = 0;
  while (k < 5) {
    st = run("GET", "/live.svg", "");
    k = k + 1;
  }
  mp_expect_i64("live cache reused", renders(g_live), r0 + 1);
  st = run("GET", "/live.svg", tag);
  mp_expect_i64("live 304", (int64)st, 304);
  mp_expect_i64("live 304 no render", renders(g_live), r0 + 1);

  mp_chart_push(g_live, 0, 10.0, 4.0);
  var tb2: uint8[64];
  var tag2: string = seq_tag(42, mp_chart_seq(g_live), &tb2[0]);
  st = run("GET", "/live.svg", tag);
  mp_expect_i64("pushed: old tag 200", (int64)st, 200);
  mp_expect_str("pushed: new etag", hdr("ETag"), tag2);
  mp_expect_i64("pushed: one render", renders(g_live), r0 + 2);
  st = run("GET", "/live.svg", tag2);
  mp_expect_i64("new tag 304", (int64)st, 304);
  var tb3: uint8[64];
  st = run("GET", "/live.svg", seq_tag(41, mp_chart_seq(g_live), &tb3[0]));
  mp_expect_i64("same seq, other generation 200", (int64)st, 200);

  // A setter moves the tag as well.
  mp_chart_set_title(g_live, "signal (edited)");
  st = run("GET", "/live.svg", tag2);
  mp_expect_i64("title edit 200", (int64)st, 200);
  mp_expect("edited title in body", rz_str_contains(body(), "signal (edited)"));

  // The polling embed (the chart is on no channel yet), with the current frame.
  var frame: MpBuf* = mp_buf_new(4096);
  defer mp_buf_free(frame);
  mp_chart_svg(g_live, 480.0, 240.0, frame);
  var emb: MpBuf* = mp_buf_new(8192);
  defer mp_buf_free(emb);
  mp_expect("mp_html_live ok",
            mp_html_live("/live.svg", 500, "", "", mp_buf_str(frame), emb) == MP_OK);
  var r1: int64 = renders(g_live);
  st = run("GET", "/embed", "");
  mp_expect_i64("embed status", (int64)st, 200);
  mp_expect_str("embed content-type", hdr("Content-Type"), "text/html; charset=utf-8");
  mp_expect("embed == mp_html_live(current frame)", body() == mp_buf_str(emb));
  mp_expect("embed div starts with the frame",
            rz_str_contains(body(), "data-interval=\"500\"><svg "));
  mp_expect("polling embed has no socket", !rz_str_contains(body(), "data-ws"));
  mp_expect_i64("embed reuses the cached frame", renders(g_live), r1);
  st = run("GET", "/embed-bad", "");
  mp_expect_i64("embed bad interval 500", (int64)st, 500);

  run("GET", "/nothing", "");
  var vars: RzVarMap;
  rz_vars_init(&vars);
  mp_expect("tpl_embed ok", mp_raize_tpl_embed(&g_ctx, &vars, "live", g_live, 480.0, 240.0,
            "/live.svg", 500) == MP_OK);
  mp_expect("tpl_embed == embed", rz_vars_get(&vars, "live") == mp_buf_str(emb));
  mp_expect("tpl_embed interval 0", mp_raize_tpl_embed(&g_ctx, &vars, "x", g_live, 480.0,
            240.0, "/live.svg", 0) != MP_OK);
  mp_expect("tpl_embed interval above one hour", mp_raize_tpl_embed(&g_ctx, &vars, "x",
            g_live, 480.0, 240.0, "/live.svg", 3600001) != MP_OK);
  mp_expect("tpl_embed empty url", mp_raize_tpl_embed(&g_ctx, &vars, "x", g_live, 480.0,
            240.0, "", 500) != MP_OK);
  mp_expect("failed tpl_embed binds nothing", !rz_vars_has(&vars, "x"));
}

// ---------------------------------------------------------------------------
// Channel
// ---------------------------------------------------------------------------

fn def_for(chans: RzChanRouter*, topic: string) -> int32 {
  var i: int32 = 0;
  while (i < chans->ndefs) {
    if (rz_str_eq(chans->defs[i].pattern, topic)) { return i; }
    i = i + 1;
  }
  return -1;
}

fn call_join(chans: RzChanRouter*, d: int32, c: RzChanCtx*, payload: string) -> int32 {
  return chans->defs[d].join(c, payload);
}

fn call_in(chans: RzChanRouter*, d: int32, c: RzChanCtx*, event: string, payload: string) -> int32 {
  return chans->defs[d].handle_in(c, event, payload);
}

fn call_leave(chans: RzChanRouter*, d: int32, c: RzChanCtx*) {
  chans->defs[d].leave(c);
}

fn check_channel_register(app: RzApp*, other: MpChart*) {
  mp_expect_i64("notify unregistered", (int64)mp_raize_notify(g_live), (int64)MP_ERR_STATE);
  mp_expect_i64("notify null", (int64)mp_raize_notify(0), (int64)MP_ERR_ARG);
  mp_expect_i64("stats unregistered", (int64)mp_raize_stats(g_live, 0), (int64)MP_ERR_ARG);
  mp_expect_i64("unregister unregistered", (int64)mp_raize_unregister(g_live),
                (int64)MP_ERR_STATE);
  mp_expect_i64("channel null app", (int64)mp_raize_channel(0, g_live, "t", "/s"),
                (int64)MP_ERR_ARG);
  mp_expect_i64("channel null chart", (int64)mp_raize_channel(app, 0, "t", "/s"),
                (int64)MP_ERR_ARG);
  mp_expect_i64("channel empty topic", (int64)mp_raize_channel(app, g_live, "", "/s"),
                (int64)MP_ERR_ARG);
  mp_expect_i64("channel empty socket", (int64)mp_raize_channel(app, g_live, "t", ""),
                (int64)MP_ERR_ARG);
  var long: uint8[300];
  memset((rawptr)&long[0], 97, 300);
  mp_expect_i64("channel topic over 256 bytes", (int64)mp_raize_channel(app, g_live,
                str_from_bytes((cstring)&long[0], 257), "/s"), (int64)MP_ERR_ARG);
  var topic: uint8[16];
  put(&topic[0], 0, "chart:live");
  mp_expect_i64("channel ok", (int64)mp_raize_channel(app, g_live,
                str_from_bytes((cstring)&topic[0], 10), "/socket/websocket"), (int64)MP_OK);
  topic[0] = 88;   // the topic was copied
  mp_expect("channel shares the chart", g_live->lock_ctx == (rawptr)g_live);
  mp_expect_i64("channel twice", (int64)mp_raize_channel(app, g_live, "chart:b", "/s"),
                (int64)MP_ERR_STATE);
  mp_expect_i64("topic taken", (int64)mp_raize_channel(app, other, "chart:live", "/s"),
                (int64)MP_ERR_STATE);
  var n: int32 = 0;
  var decls: Rz_ChannelDecl* = rz__app_channels(app, &n);
  mp_expect_i64("one channel declared", (int64)n, 1);
  if (n == 1) { mp_expect_str("declared topic", decls[0].pattern, "chart:live"); }
  mp_expect_i64("no notices yet", notices(g_live), 0);
  // Not serving yet: the notice stays pending.
  mp_expect_i64("notify before serving", (int64)mp_raize_notify(g_live), (int64)MP_ERR_STATE);
  mp_expect_i64("nothing counted", notices(g_live), 0);
}

fn check_channel_embed() {
  var frame: MpBuf* = mp_buf_new(4096);
  var want: MpBuf* = mp_buf_new(8192);
  defer mp_buf_free(frame);
  defer mp_buf_free(want);
  mp_chart_svg(g_live, 480.0, 240.0, frame);
  mp_expect("ws embed ok", mp_html_live("/live.svg", 500, "/socket/websocket", "chart:live",
            mp_buf_str(frame), want) == MP_OK);
  var st: int32 = run("GET", "/embed", "");
  mp_expect_i64("ws embed status", (int64)st, 200);
  mp_expect("ws embed == mp_html_live(socket, topic)", body() == mp_buf_str(want));
  mp_expect("ws embed names the socket", rz_str_contains(body(), "data-ws=\"/socket/websocket\""));
  mp_expect("ws embed names the topic", rz_str_contains(body(), "data-topic=\"chart:live\""));
  run("GET", "/nothing", "");
  var vars: RzVarMap;
  rz_vars_init(&vars);
  mp_expect("ws tpl_embed ok", mp_raize_tpl_embed(&g_ctx, &vars, "live", g_live, 480.0, 240.0,
            "/live.svg", 500) == MP_OK);
  mp_expect("ws tpl_embed == embed", rz_vars_get(&vars, "live") == mp_buf_str(want));
}

fn check_channel_wire(app: RzApp*, hub: RzHub*, chans: RzChanRouter*) {
  var d: int32 = def_for(chans, "chart:live");
  mp_expect("topic defined on the router", d >= 0);
  if (d < 0) { return; }
  var reply: RzBuf* = rz_buf_new();
  defer rz_buf_free(reply);
  var c: RzChanCtx;
  c.router = chans;
  c.hub = hub;
  c.sock = 7;
  c.topic = "chart:live";
  c.join_ref = "\"1\"";
  c.state = 0;
  c.reply = reply;
  c.conn = 0;
  var jb: uint8[96];
  var want: string = tag_json(42, mp_chart_seq(g_live), &jb[0]);
  mp_expect_i64("join accepted", (int64)call_join(chans, d, &c, "{{}"), 0);
  mp_expect_str("join reply is the tag", rz_buf_str(reply), want);
  run("GET", "/live.svg", "");
  var tb: uint8[64];
  mp_expect("join tag == route etag", rz_str_contains(want, hdr("ETag")) &&
            hdr("ETag") == seq_tag(42, mp_chart_seq(g_live), &tb[0]));
  reply->len = 0;
  c.topic = "chart:gone";
  mp_expect("unknown topic refused", call_join(chans, d, &c, "{{}") != 0);
  mp_expect_str("refusal reason", rz_buf_str(reply), "{{\"reason\":\"unknown chart\"}");
  c.topic = "chart:live";
  reply->len = 0;
  mp_expect_i64("heartbeat ok", (int64)call_in(chans, d, &c, "heartbeat", "{{}"), 0);
  mp_expect_str("heartbeat reply", rz_buf_str(reply), "{{}");
  reply->len = 0;
  mp_expect("other event refused", call_in(chans, d, &c, "set", "{{}") != 0);
  mp_expect_str("other event reason", rz_buf_str(reply), "{{\"reason\":\"unknown event\"}");
  call_leave(chans, d, &c);

  // Notices: one per moved seq, coalesced across changes.
  mp_expect_i64("first notify", (int64)mp_raize_notify(g_live), (int64)MP_OK);
  mp_expect_i64("one notice", notices(g_live), 1);
  mp_expect_i64("unchanged notify", (int64)mp_raize_notify(g_live), (int64)MP_OK);
  mp_expect_i64("no notice without a change", notices(g_live), 1);
  var i: int32 = 0;
  while (i < 5) {
    mp_chart_push(g_live, 0, 11.0 + (float64)i, 3.0);
    i = i + 1;
  }
  mp_expect_i64("notify after 5 pushes", (int64)mp_raize_notify(g_live), (int64)MP_OK);
  mp_expect_i64("5 pushes, one notice", notices(g_live), 2);

  // Mailbox full: the notice stays pending and goes out once there is room.
  var filled: int32 = 0;
  while (filled < 100000 && rz_hub_post_close(hub, 0, 1000)) { filled = filled + 1; }
  mp_expect("mailbox filled", filled > 0 && filled < 100000);
  mp_chart_push(g_live, 0, 20.0, 1.0);
  mp_expect_i64("notify into a full mailbox", (int64)mp_raize_notify(g_live), (int64)MP_ERR_IO);
  mp_expect_i64("still pending", (int64)mp_raize_notify(g_live), (int64)MP_ERR_IO);
  mp_expect_i64("no notice counted", notices(g_live), 2);
  mp_expect("hub starts", rz_hub_start(hub) == 0);
  var rc: int32 = MP_ERR_IO;
  var tries: int32 = 0;
  while (rc == MP_ERR_IO && tries < 200) {
    thread_sleep_ms((uint32)10);
    rc = mp_raize_notify(g_live);
    tries = tries + 1;
  }
  mp_expect_i64("pending notice posted once drained", (int64)rc, (int64)MP_OK);
  mp_expect_i64("pending notice counted", notices(g_live), 3);
  mp_expect_i64("then nothing pending", (int64)mp_raize_notify(g_live), (int64)MP_OK);
  mp_expect_i64("still three notices", notices(g_live), 3);

  // Unregistered: joins are refused, notify and stats say so; registering again revives it.
  mp_expect_i64("unregister", (int64)mp_raize_unregister(g_live), (int64)MP_OK);
  mp_expect_i64("unregister twice", (int64)mp_raize_unregister(g_live), (int64)MP_ERR_STATE);
  mp_expect_i64("notify after unregister", (int64)mp_raize_notify(g_live), (int64)MP_ERR_STATE);
  var s: MpRaizeStats;
  mp_expect_i64("stats after unregister", (int64)mp_raize_stats(g_live, &s), (int64)MP_ERR_STATE);
  reply->len = 0;
  mp_expect("join after unregister refused", call_join(chans, d, &c, "{{}") != 0);
  mp_expect_i64("register again", (int64)mp_raize_channel(app, g_live, "chart:live",
                "/socket/websocket"), (int64)MP_OK);
  reply->len = 0;
  mp_expect_i64("join again accepted", (int64)call_join(chans, d, &c, "{{}"), 0);
  mp_expect_i64("unregister again", (int64)mp_raize_unregister(g_live), (int64)MP_OK);
}

fn check_channel() {
  var other: MpChart* = mp_chart_new(MP_LINE);
  var app: RzApp* = rz__app_new("raize_test");
  mp_expect("app + other chart", app != 0 && other != 0);
  if (app == 0 || other == 0) { return; }
  rz__app_set_current(app);
  check_channel_register(app, other);
  check_channel_embed();
  // Wire the hub and channel router as rz_run does; the hub starts later.
  var st: Rz_AppState* = app->state;
  st->hub = rz_hub_new(rz_hub_opts_default());
  if (st->hub != 0) { st->chans = rz_chan_router_new(st->hub, 0); }
  mp_expect("hub + router", st->hub != 0 && st->chans != 0);
  if (st->chans != 0) {
    var n: int32 = 0;
    var decls: Rz_ChannelDecl* = rz__app_channels(app, &n);
    var i: int32 = 0;
    while (i < n) {
      rz_chan_define(st->chans, decls[i].pattern, decls[i].join, decls[i].handle_in,
                     decls[i].leave);
      i = i + 1;
    }
    check_channel_wire(app, st->hub, st->chans);
  }
  rz__app_set_current(0);
  rz__app_free(app);
  mp_chart_free(other);
}

// ---------------------------------------------------------------------------

fn setup() -> bool {
  g_arena = rz_arena_new();
  g_resp = rz_response_new();
  g_rt = rz_router_new();
  if (g_arena == 0 || g_resp == 0 || g_rt == 0) { return false; }
  rz_router_set_path_decoded(g_rt, true);
  if (rz_router_add(g_rt, "GET", "/s.svg", &h_svg) != RZ_OK) { return false; }
  if (rz_router_add(g_rt, "GET", "/f.html", &h_fig) != RZ_OK) { return false; }
  if (rz_router_add(g_rt, "GET", "/bad.svg", &h_bad) != RZ_OK) { return false; }
  if (rz_router_add(g_rt, "GET", "/none.svg", &h_none) != RZ_OK) { return false; }
  if (rz_router_add(g_rt, "GET", "/live.svg", &h_live) != RZ_OK) { return false; }
  if (rz_router_add(g_rt, "GET", "/embed", &h_embed) != RZ_OK) { return false; }
  if (rz_router_add(g_rt, "GET", "/embed-bad", &h_embed_bad) != RZ_OK) { return false; }

  g_bar = mp_chart_new(MP_BAR);
  if (g_bar == 0) { return false; }
  mp_chart_set_title(g_bar, "Units & <sold>");
  var s: int32 = mp_chart_series(g_bar, "sales");
  mp_chart_set_value(g_bar, s, "mon", 12.0);
  mp_chart_set_value(g_bar, s, "tue", 19.0);
  mp_chart_set_value(g_bar, s, "wed", 7.0);
  mp_chart_set_value(g_bar, s, "thu", 15.0);
  g_live = mp_chart_new(MP_LINE);
  if (g_live == 0) { return false; }
  mp_chart_set_title(g_live, "signal");
  mp_chart_set_x_format(g_live, MP_FMT_TIME);
  mp_chart_keep(g_live, 256);
  mp_chart_series(g_live, "sine");
  return mp_chart_error(g_bar) == MP_OK && mp_chart_error(g_live) == MP_OK;
}

fn teardown() {
  mp_chart_free(g_bar);
  mp_chart_free(g_live);
  rz_router_free(g_rt);
  rz_response_free(g_resp);
  rz_arena_free(g_arena);
}

fn main() -> int32 {
  var live0: int64 = mp_alloc_live();
  if (!setup()) {
    println("setup failed");
    return 2;
  }
  check_static();
  check_template();
  check_live();
  check_channel();
  teardown();
  mp_expect_i64("no MistPlot allocation left", mp_alloc_live(), live0);
  return mp_summary();
}
