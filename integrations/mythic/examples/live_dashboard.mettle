// integrations/mythic/examples/live_dashboard — a MythicUI window with a live
// line chart fed by a synthetic signal, a static bar chart beside it and a
// light/dark switch that re-themes both charts.
//
// Build from the mistplot repo root:
//   mettle --build integrations/mythic/examples/live_dashboard.mettle \
//       -o build/integrations/mythic/live_dashboard
//
// Samples are pushed on ui->pass == 0 only: the frame callback can run up to
// three times per frame (settle passes), and pushing on every pass would
// triple the samples. x is the frame clock (mythic_time_us) in seconds.

import "std/mem";
import "std/math";
import "mythic/mythic";
import "mistplot/core/data";
import "mistplot/chart/spec";
import "mistplot/live/stream";
import "../mp_mythic";

const SAMPLE_DT: float64 = 0.01;     // 100 Hz synthetic signal
const WINDOW_S: float64 = 30.0;

struct App {
  dark: bool;
  paused: bool;
  lv: MpLive*;
  live: MpMythicChart*;
  bars: MpMythicChart*;
  sales: MpSeries*;
  t0: int64;
  last_x: float64;
  rng: uint32;
}

fn noise(app: App*) -> float64 {
  app->rng = app->rng * (uint32)1664525 + (uint32)1013904223;
  return (float64)(app->rng >> 8) / 16777216.0 - 0.5;
}

fn ingest(ui: MythicUi*, app: App*) {
  if (ui->pass != 0 || app->paused) { return; }
  var now: int64 = mythic_time_us(ui);
  // start with a full window of history so the chart is not empty at launch
  if (app->t0 == 0) { app->t0 = now - (int64)(WINDOW_S * 1000000.0); }
  var x: float64 = (float64)(now - app->t0) / 1000000.0;
  // after a long stall only the visible window is worth generating
  if (x - app->last_x > WINDOW_S) { app->last_x = x - WINDOW_S; }
  var t: float64 = app->last_x + SAMPLE_DT;
  while (t <= x) {
    var cpu: float64 = 50.0 + 25.0 * sin(t * 1.3) + 8.0 * sin(t * 7.1) + 3.0 * noise(app);
    var mem: float64 = 62.0 + 12.0 * sin(t * 0.21) + 0.4 * noise(app);
    mp_live_push(app->lv, 0, t, cpu);
    mp_live_push(app->lv, 1, t, mem);
    app->last_x = t;
    t = t + SAMPLE_DT;
  }
}

fn header(ui: MythicUi*, app: App*) {
  mythic_row_begin(ui, { width: mythic_grow(), align_y: MYTHIC_ALIGN_CENTER, gap: 16 });
    mythic_column_begin(ui, { gap: 2 });
      mythic_label_ex(ui, "MistPlot live dashboard", { role: MYTHIC_TYPE_HEADING });
      mythic_label_ex(ui, "Synthetic 100 Hz signal, last 30 s. Hover the chart for values.",
                      { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    mythic_end(ui);
    mythic_spacer(ui);
    mythic_switch(ui, "Pause", &app->paused);
    if (mythic_switch(ui, "Dark mode", &app->dark)) {
      if (app->dark) {
        mythic_set_theme(ui, mythic_theme_dark());
      } else {
        mythic_set_theme(ui, mythic_theme_light());
      }
    }
  mythic_end(ui);
}

fn frame(ui: MythicUi*, ud: rawptr) {
  var app: App* = (App*)ud;
  ingest(ui, app);
  var bs: MpChartSpec = mp_chart_spec(MP_CHART_BAR, app->sales, 1);
  bs.title = "Requests per region";
  bs.legend = MP_LEGEND_BOTTOM;
  bs.y_format = MP_FMT_SI;
  mythic_column_begin(ui, { width: mythic_grow(), height: mythic_grow(),
                            pad: mythic_pad(24), gap: 16 });
    header(ui, app);
    mythic_row_begin(ui, { width: mythic_grow(), height: mythic_grow(), gap: 16 });
      mythic_card_begin(ui, { width: mythic_grow(), height: mythic_grow() });
        mp_mythic_live(ui, app->live, app->lv, mythic_grow(), mythic_grow());
      mythic_end(ui);
      mythic_card_begin(ui, { width: mythic_fixed(380), height: mythic_grow() });
        mp_mythic_chart(ui, app->bars, &bs, mythic_grow(), mythic_grow());
      mythic_end(ui);
    mythic_end(ui);
  mythic_end(ui);
}

fn main() -> int32 {
  var app: App* = (App*)malloc(sizeof(App));
  memset((rawptr)app, 0, sizeof(App));
  app->rng = (uint32)12345;
  app->lv = mp_live_new(MP_CHART_LINE, 2, 8192);
  mp_live_series_name(app->lv, 0, "cpu %");
  mp_live_series_name(app->lv, 1, "mem %");
  mp_live_window(app->lv, WINDOW_S);
  var sp: MpChartSpec* = mp_live_spec(app->lv);
  sp->title = "System load";
  sp->x_format = MP_FMT_TIME;
  sp->y_fixed = true;
  sp->y_min = 0.0;
  sp->y_max = 100.0;
  sp->legend = MP_LEGEND_BOTTOM;
  mp_live_touch(app->lv);
  app->live = mp_mythic_chart_new();
  app->live->frame_ms = 16;
  app->bars = mp_mythic_chart_new();
  app->sales = mp_series_new("requests", 8);
  var vals: float64[6] = [12400.0, 9800.0, 15100.0, 7300.0, 11900.0, 4200.0];
  var i: int32 = 0;
  while (i < 6) {
    mp_series_push(app->sales, (float64)i, vals[(int64)i]);
    i = i + 1;
  }
  var rc: int32 = mythic_run({ title: "MistPlot live dashboard", width: 1120.0, height: 640.0 },
                             &frame, (rawptr)app);
  mp_mythic_chart_free(app->live);
  mp_mythic_chart_free(app->bars);
  mp_live_free(app->lv);
  mp_series_free(app->sales);
  free((rawptr)app);
  return rc;
}
