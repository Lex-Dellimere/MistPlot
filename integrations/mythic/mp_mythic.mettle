//! MistPlot charts inside MythicUI: a stateless widget for static and live charts, a scene
//! painter, the MythicUI theme as a chart theme, and HiDPI PNG export through the headless
//! platform. Depends on mythic/mythic and the MistPlot chart, frame, pick and scene modules.
//! The widget keeps no state: the chart caches its scene per target (logical box size,
//! device scale and a measurer key over MythicUI's fonts), so a frame rebuilds the scene
//! only when the chart's seq, the box size or the scale changed. Scene px are logical px;
//! painting snaps axis-aligned lines to whole device px and keeps data lines anti-aliased.

import "std/math";
import "mythic/mythic";
import "mistplot/core/error";
import "mistplot/core/color";
import "mistplot/core/geom";
import "mistplot/core/target";
import "mistplot/scene/scene";
import "mistplot/scene/path";
import "mistplot/chart/chart";
import "mistplot/chart/config";
import "mistplot/chart/frame";
import "mistplot/chart/pick";

/// Live charts (mp_chart_keep or mp_chart_window set) ask MythicUI for the next frame this
/// many milliseconds ahead. Units: ms.
export const MP_MYTHIC_FRAME_MS: int32 = 16;

const MM_FLATTEN_PX: float64 = 0.25;   // cubic flattening tolerance, logical px
const MM_TIP_SIZE: float64 = 12.0;     // hover readout text size
const MM_TIP_ROW: float64 = 18.0;
const MM_TIP_PAD: float64 = 8.0;
const MM_TIP_SW: float64 = 8.0;        // readout swatch

// ---------------------------------------------------------------- colours and theme

fn mm_argb(c: MpColor) -> uint32 {
  return ((uint32)c.a << 24) | ((uint32)c.r << 16) | ((uint32)c.g << 8) | (uint32)c.b;
}

fn mm_color(argb: uint32) -> MpColor {
  return mp_rgba((uint8)((argb >> 16) & (uint32)255), (uint8)((argb >> 8) & (uint32)255),
                 (uint8)(argb & (uint32)255), (uint8)((argb >> 24) & (uint32)255));
}

// Channel-wise mean of two colours: MythicUI has no gradient path fill.
fn mm_mean(a: MpColor, b: MpColor) -> MpColor {
  return mp_rgba((uint8)(((int32)a.r + (int32)b.r + 1) / 2), (uint8)(((int32)a.g + (int32)b.g + 1) / 2),
                 (uint8)(((int32)a.b + (int32)b.b + 1) / 2), (uint8)(((int32)a.a + (int32)b.a + 1) / 2));
}

/// The active MythicUI theme as a chart theme: background = surface, title and text =
/// primary text, ticks and subtitle = secondary text, grid = subtle border, baseline =
/// strong border; the palette is MistPlot's (Observable-10).
///
/// @param ui The MythicUI context. Valid: any; 0 gives mp_theme_light().
/// @return The theme (name "light" or "dark", following the MythicUI theme).
/// @mem ui is only read.
/// @thread The UI thread.
export fn mp_mythic_theme(ui: MythicUi*) -> MpTheme {
  var t: MpTheme = mp_theme_light();
  if (ui == 0) { return t; }
  var m: MythicTheme* = mythic_theme(ui);
  if (m == 0) { return t; }
  if (m->dark) { t = mp_theme_dark(); }
  t.bg = mm_color(m->colors.bg_surface);
  t.title = mm_color(m->colors.text_primary);
  t.text = mm_color(m->colors.text_primary);
  t.muted = mm_color(m->colors.text_secondary);
  t.grid = mm_color(m->colors.border_subtle);
  t.axis = mm_color(m->colors.border_strong);
  t.fg = t.title;
  return t;
}

// ---------------------------------------------------------------- text

struct MmMeasure {
  fonts: MythicFonts*;
  scale: float32;
}

fn mm_style(size: float64, flags: int32) -> MythicTextStyle {
  var font: int32 = MYTHIC_FONT_REGULAR;
  if ((flags & MP_NF_BOLD) != 0) { font = MYTHIC_FONT_SEMIBOLD; }
  var tf: int32 = 0;
  if ((flags & MP_NF_TABULAR) != 0) { tf = MYTHIC_TEXT_TABULAR; }
  var st: MythicTextStyle = { font: font, size: (float32)size, line_height: (float32)(size * 1.2),
                              tracking: 0.0, flags: tf };
  return st;
}

// Width in logical px of s in the style of a text node, measured at device scale.
fn mm_text_w(fonts: MythicFonts*, scale: float32, s: string, size: float64, flags: int32) -> float64 {
  if (fonts == 0 || s.length == (uint64)0 || !(size > 0.0)) { return 0.0; }
  var sc: float32 = scale;
  if (sc <= 0.0) { sc = 1.0; }
  var w: float32 = mythic_text_width(fonts, mythic_paint_text_spec(sc, mm_style(size, flags)), s);
  return (float64)(w / sc);
}

// Target measurer: MythicUI's regular font at the context's device scale.
fn mm_measure_cb(ctx: rawptr, s: string, size: float64) -> float64 {
  var m: MmMeasure* = (MmMeasure*)ctx;
  if (m == 0 || m->fonts == 0) { return (float64)s.length * size * 0.58; }
  return mm_text_w(m->fonts, m->scale, s, size, 0);
}

// The target of a box: its logical size at the painter's scale, measured with m (which
// must outlive every render with the target).
fn mm_target(m: MmMeasure*, w: float64, h: float64) -> MpTarget {
  var t: MpTarget = mp_target_hidpi(w, h, (float64)m->scale);
  var key: uint64 = mythic_hash_u64((uint64)0x6D70, (uint64)m->fonts);
  key = mythic_hash_u64(key, (uint64)(int64)mythic_iround(m->scale * 65536.0));
  mp_target_set_measure(&t, &mm_measure_cb, (rawptr)m, key);
  return t;
}

// ---------------------------------------------------------------- scene painter

fn mm_zero() -> MythicCorners {
  var z: MythicCorners = { tl: 0.0, tr: 0.0, br: 0.0, bl: 0.0 };
  return z;
}

fn mm_rect(x: float64, y: float64, w: float64, h: float64) -> MythicRect {
  var r: MythicRect = { x: (float32)x, y: (float32)y, w: (float32)w, h: (float32)h };
  return r;
}

fn mm_paint_rect(p: MythicPainter*, nd: MpNode*, ox: float64, oy: float64) {
  if (nd->fill.a != (uint8)0) {
    mythic_paint_fill(p, mm_rect(ox + nd->x, oy + nd->y, nd->w, nd->h), mm_zero(), mm_argb(nd->fill));
  }
  if (nd->stroke_w > 0.0 && nd->stroke.a != (uint8)0) {
    // MythicUI strokes inside the rect; a scene stroke is centred on the edge
    var hw: float64 = nd->stroke_w * 0.5;
    var r: MythicRect = mm_rect(ox + nd->x - hw, oy + nd->y - hw, nd->w + nd->stroke_w,
                                nd->h + nd->stroke_w);
    mythic_paint_stroke(p, r, mm_zero(), (float32)nd->stroke_w, mm_argb(nd->stroke));
  }
}

// An axis-aligned segment as a filled rect on whole device px: the stroke width rounds to
// at least one device px and the rect is centred on the (already snapped) line.
fn mm_dev_segment(p: MythicPainter*, x0: float64, y0: float64, x1: float64, y1: float64,
                  w: float64, col: uint32) {
  var s: float64 = (float64)p->scale;
  var dw: float64 = fmax(1.0, round(w * s));
  var r: MythicRect = mm_rect(0.0, 0.0, 0.0, 0.0);
  if (y0 == y1) {
    var a: float64 = round(fmin(x0, x1) * s);
    var b: float64 = round(fmax(x0, x1) * s);
    r = mm_rect(a, round(y0 * s - dw * 0.5), b - a, dw);
  } else {
    var c: float64 = round(fmin(y0, y1) * s);
    var d: float64 = round(fmax(y0, y1) * s);
    r = mm_rect(round(x0 * s - dw * 0.5), c, dw, d - c);
  }
  if (r.w <= 0.0 || r.h <= 0.0) { return; }
  var cc: uint32 = mythic_paint_color(p, col);
  if ((cc >> 24) == (uint32)0) { return; }
  mythic_dl_fill(p->dl, r, mm_zero(), cc);
}

// Strokes one run of points, split into dashes by pat (npat 0 = solid). buf has room for
// n + 2 points. The dash pattern restarts at the start of every run, as in SVG.
fn mm_stroke_run(p: MythicPainter*, a: MythicVec2*, n: int32, w: float32, col: uint32,
                 pat: float64*, npat: int32, buf: MythicVec2*) {
  if (n < 2) { return; }
  if (npat < 2 || buf == 0) {
    mythic_paint_path_stroke(p, a, n, w, col, false, 0.0);
    return;
  }
  var on: bool = true;
  var left: float64 = pat[0];
  buf[0] = a[0];
  var k: int32 = 1;
  var i: int32 = 1;
  while (i < n) {
    var x0: float64 = (float64)a[i - 1].x;
    var y0: float64 = (float64)a[i - 1].y;
    var dx: float64 = (float64)a[i].x - x0;
    var dy: float64 = (float64)a[i].y - y0;
    var seg: float64 = sqrt(dx * dx + dy * dy);
    var t: float64 = 0.0;
    while (seg - t > left) {
      t = t + left;
      var f: float64 = t / seg;
      var q: MythicVec2 = { x: (float32)(x0 + dx * f), y: (float32)(y0 + dy * f) };
      if (on) {
        buf[k] = q;
        k = k + 1;
        mythic_paint_path_stroke(p, buf, k, w, col, false, 0.0);
        k = 0;
      } else {
        buf[0] = q;
        k = 1;
      }
      on = !on;
      if (on) { left = pat[0]; } else { left = pat[1]; }
    }
    left = left - (seg - t);
    if (on) {
      buf[k] = a[i];
      k = k + 1;
    }
    i = i + 1;
  }
  if (on && k >= 2) { mythic_paint_path_stroke(p, buf, k, w, col, false, 0.0); }
}

// Clips a polygon to x >= xc (keep_ge) or x <= xc into out (room for 2n points).
fn mm_clip_x(a: MythicVec2*, n: int32, xc: float32, keep_ge: bool, out: MythicVec2*) -> int32 {
  var m: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    var u: MythicVec2 = a[i];
    var v: MythicVec2 = a[(i + 1) % n];
    var uin: bool = u.x >= xc;
    var vin: bool = v.x >= xc;
    if (!keep_ge) { uin = u.x <= xc; vin = v.x <= xc; }
    if (uin) {
      out[m] = u;
      m = m + 1;
    }
    if (uin != vin) {
      var f: float32 = (xc - u.x) / (v.x - u.x);
      out[m].x = xc;
      out[m].y = u.y + (v.y - u.y) * f;
      m = m + 1;
    }
    i = i + 1;
  }
  return m;
}

// mythic_paint_path_fill, one piece per raster tile column: MythicUI's path fill clamps
// edges that leave a tile sideways (which bends them), so a polygon crossing a tile
// column boundary is cut at the boundaries first.
fn mm_fill_poly(p: MythicPainter*, a: MythicVec2*, n: int32, col: uint32) {
  if (n < 3) { return; }
  var s: float32 = p->scale;
  var tile: float32 = (float32)MYTHIC_TILE;
  var lo: float32 = a[0].x;
  var hi: float32 = a[0].x;
  var i: int32 = 1;
  while (i < n) {
    if (a[i].x < lo) { lo = a[i].x; }
    if (a[i].x > hi) { hi = a[i].x; }
    i = i + 1;
  }
  var k0: int32 = (int32)mythic_floorf(lo * s / tile);
  var k1: int32 = (int32)mythic_floorf(hi * s / tile);
  if (k0 == k1 || k1 - k0 > 4096) {
    mythic_paint_path_fill(p, a, n, col);
    return;
  }
  var tmp: MythicVec2* = (MythicVec2*)mythic_arena_alloc(p->arena, (int64)(2 * n + 4) * 8);
  var out: MythicVec2* = (MythicVec2*)mythic_arena_alloc(p->arena, (int64)(4 * n + 8) * 8);
  if (tmp == 0 || out == 0) {
    mythic_paint_path_fill(p, a, n, col);
    return;
  }
  var k: int32 = k0;
  while (k <= k1) {
    var m: int32 = mm_clip_x(a, n, (float32)k * tile / s, true, tmp);
    if (m >= 3) {
      m = mm_clip_x(tmp, m, (float32)(k + 1) * tile / s, false, out);
      if (m >= 3) { mythic_paint_path_fill(p, out, m, col); }
    }
    k = k + 1;
  }
}

// Fills (fill = true) or strokes a LINE, POLY or PATH node: its points are flattened
// into the frame arena, offset to the box, and each subpath is painted on its own.
fn mm_paint_runs(p: MythicPainter*, s: MpScene*, nd: MpNode*, ox: float64, oy: float64,
                 fill: bool, col: uint32) {
  if (p->arena == 0) { return; }
  var it: MpPathIter;
  var x: float64 = 0.0;
  var y: float64 = 0.0;
  var n: int32 = 0;
  if (mp_path_iter(s, nd, &it, MM_FLATTEN_PX) != MP_OK) { return; }
  while (mp_path_next(&it, &x, &y) != 0) { n = n + 1; }
  if (n < 2) { return; }
  var pts: MythicVec2* = (MythicVec2*)mythic_arena_alloc(p->arena, (int64)n * 8);
  if (pts == 0) { return; }
  var pat: float64[2];
  var npat: int32 = 0;
  var buf: MythicVec2* = (MythicVec2*)0;
  if (!fill) {
    npat = mp_dash_pattern(nd->dash, nd->stroke_w, &pat[0]);
    if (npat == 2) {
      buf = (MythicVec2*)mythic_arena_alloc(p->arena, (int64)(n + 2) * 8);
      if (buf == 0) { npat = 0; }
    }
  }
  mp_path_iter(s, nd, &it, MM_FLATTEN_PX);
  var start: int32 = 0;
  var k: int32 = 0;
  var cmd: int32 = mp_path_next(&it, &x, &y);
  while (cmd != 0 && k < n) {
    if (cmd == MP_PATH_MOVE && k > start) {
      if (fill) { mm_fill_poly(p, &pts[start], k - start, col); }
      else { mm_stroke_run(p, &pts[start], k - start, (float32)nd->stroke_w, col, &pat[0], npat, buf); }
      start = k;
    }
    pts[k].x = (float32)(ox + x);
    pts[k].y = (float32)(oy + y);
    k = k + 1;
    cmd = mp_path_next(&it, &x, &y);
  }
  if (k > start) {
    if (fill) { mm_fill_poly(p, &pts[start], k - start, col); }
    else { mm_stroke_run(p, &pts[start], k - start, (float32)nd->stroke_w, col, &pat[0], npat, buf); }
  }
}

fn mm_paint_line(p: MythicPainter*, s: MpScene*, nd: MpNode*, ox: float64, oy: float64) {
  if (!(nd->stroke_w > 0.0) || nd->stroke.a == (uint8)0) { return; }
  var q: float64* = mp_scene_node_pts(s, nd);
  if (q == 0 || nd->pts_len < 4) { return; }
  var axis: bool = q[0] == q[2] || q[1] == q[3];
  if (axis && nd->dash == MP_DASH_SOLID) {
    mm_dev_segment(p, ox + q[0], oy + q[1], ox + q[2], oy + q[3], nd->stroke_w, mm_argb(nd->stroke));
    return;
  }
  mm_paint_runs(p, s, nd, ox, oy, false, mm_argb(nd->stroke));
}

fn mm_paint_shape(p: MythicPainter*, s: MpScene*, nd: MpNode*, ox: float64, oy: float64) {
  var grad: bool = (nd->flags & MP_NF_GRADIENT) != 0;
  var fc: MpColor = nd->fill;
  if (grad) { fc = mm_mean(nd->fill, nd->fill2); }
  if (nd->kind == MP_NODE_PATH && fc.a != (uint8)0) {
    mm_paint_runs(p, s, nd, ox, oy, true, mm_argb(fc));
  }
  if (nd->stroke_w > 0.0 && nd->stroke.a != (uint8)0) {
    mm_paint_runs(p, s, nd, ox, oy, false, mm_argb(nd->stroke));
  }
}

// A closed outline of n points from the frame arena, stroked centred like an SVG ring.
fn mm_ring(p: MythicPainter*, pts: MythicVec2*, n: int32, w: float64, col: MpColor) {
  if (!(w > 0.0) || col.a == (uint8)0) { return; }
  mythic_paint_path_stroke(p, pts, n, (float32)w, mm_argb(col), true, 0.0);
}

fn mm_paint_marker(p: MythicPainter*, nd: MpNode*, ox: float64, oy: float64) {
  var r: float64 = nd->r;
  if (!(r > 0.0) || p->arena == 0) { return; }
  var cx: float64 = ox + nd->x;
  var cy: float64 = oy + nd->y;
  if (nd->marker == MP_MARK_CIRCLE) {
    var c: MythicVec2 = { x: (float32)cx, y: (float32)cy };
    if (nd->fill.a != (uint8)0) { mythic_paint_circle(p, c, (float32)r, mm_argb(nd->fill)); }
    var n: int32 = 32;
    if (r > 16.0) { n = 64; }
    var ap: MythicVec2* = (MythicVec2*)mythic_arena_alloc(p->arena, (int64)(n + 1) * 8);
    if (ap == 0) { return; }
    mythic_path_arc(ap, n, c.x, c.y, (float32)r, 0.0, MYTHIC_TAU);
    mm_ring(p, ap, n, nd->stroke_w, nd->stroke);
    return;
  }
  var q: MythicVec2* = (MythicVec2*)mythic_arena_alloc(p->arena, 32);
  if (q == 0) { return; }
  if (nd->marker == MP_MARK_SQUARE) {
    if (nd->fill.a != (uint8)0) {
      mythic_paint_fill_exact(p, mm_rect(cx - r, cy - r, r * 2.0, r * 2.0), mm_zero(), mm_argb(nd->fill));
    }
    q[0].x = (float32)(cx - r); q[0].y = (float32)(cy - r);
    q[1].x = (float32)(cx + r); q[1].y = (float32)(cy - r);
    q[2].x = (float32)(cx + r); q[2].y = (float32)(cy + r);
    q[3].x = (float32)(cx - r); q[3].y = (float32)(cy + r);
  } else if (nd->marker == MP_MARK_DIAMOND) {
    q[0].x = (float32)cx; q[0].y = (float32)(cy - r);
    q[1].x = (float32)(cx + r); q[1].y = (float32)cy;
    q[2].x = (float32)cx; q[2].y = (float32)(cy + r);
    q[3].x = (float32)(cx - r); q[3].y = (float32)cy;
    if (nd->fill.a != (uint8)0) { mm_fill_poly(p, q, 4, mm_argb(nd->fill)); }
  } else {
    return;
  }
  mm_ring(p, q, 4, nd->stroke_w, nd->stroke);
}

// Text with its pen at x (aligned START / CENTER / END) and its baseline at logical y,
// rounded to a whole device px.
fn mm_text_at(p: MythicPainter*, t: string, size: float64, flags: int32, align: int32,
              x: float64, baseline: float64, col: uint32) {
  if (t.length == (uint64)0 || p->fonts == 0 || !(size > 0.0)) { return; }
  var lx: float64 = x;
  if (align != MP_ALIGN_START) {
    var w: float64 = mm_text_w(p->fonts, p->scale, t, size, flags);
    if (align == MP_ALIGN_CENTER) { lx = x - w * 0.5; } else { lx = x - w; }
  }
  var bdev: float32 = mythic_roundf((float32)baseline * p->scale);
  mythic_paint_text_baseline(p, t, mm_style(size, flags), (float32)lx, bdev, col);
}

fn mm_paint_text(p: MythicPainter*, s: MpScene*, nd: MpNode*, ox: float64, oy: float64) {
  if (nd->fill.a == (uint8)0) { return; }
  mm_text_at(p, mp_scene_node_text(s, nd), nd->size, nd->flags, nd->align, ox + nd->x,
             oy + nd->y, mm_argb(nd->fill));
}

fn mm_paint_node(p: MythicPainter*, s: MpScene*, nd: MpNode*, ox: float64, oy: float64) {
  if (nd->kind == MP_NODE_RECT) { mm_paint_rect(p, nd, ox, oy); }
  else if (nd->kind == MP_NODE_LINE) { mm_paint_line(p, s, nd, ox, oy); }
  else if (nd->kind == MP_NODE_POLY || nd->kind == MP_NODE_PATH) { mm_paint_shape(p, s, nd, ox, oy); }
  else if (nd->kind == MP_NODE_MARKER) { mm_paint_marker(p, nd, ox, oy); }
  else if (nd->kind == MP_NODE_TEXT) { mm_paint_text(p, s, nd, ox, oy); }
}

/// Paints every node of a scene with its origin at r's top-left, clipped to r.
/// Axis-aligned solid lines become filled rects on whole device px; polylines and paths
/// are flattened and stroked (dashes split by mp_dash_pattern); a gradient area fill is
/// painted solid with the mean of its two colours; text is MythicUI's regular font
/// (semibold when bold, tabular digits when tabular) with its baseline on a device px.
/// Unknown node kinds are skipped.
///
/// @param p The painter of a MythicUI paint callback. Valid: any; 0 paints nothing.
/// @param s The scene. Units: scene px = logical px. Valid: any; 0 paints nothing.
/// @param r The box. Units: logical px. Valid: any; an empty box paints nothing.
/// @mem s is only read; flattened points live in the painter's frame arena.
/// @thread The UI thread, inside a paint callback; nothing may change s meanwhile.
/// @cost O(nodes + flattened points).
export fn mp_mythic_paint_scene(p: MythicPainter*, s: MpScene*, r: MythicRect) {
  if (p == 0 || s == 0 || r.w <= 0.0 || r.h <= 0.0) { return; }
  mythic_dl_push_clip(p->dl, mythic_paint_dev_rect(p, r), 0.0);
  var ox: float64 = (float64)r.x;
  var oy: float64 = (float64)r.y;
  var n: int64 = mp_scene_count(s);
  var i: int64 = 0;
  while (i < n) {
    var nd: MpNode* = mp_scene_node(s, i);
    if (nd != 0) { mm_paint_node(p, s, nd, ox, oy); }
    i = i + 1;
  }
  mythic_dl_pop_clip(p->dl);
}

// ---------------------------------------------------------------- hover

// Guide at the pointer, a dot on each series' picked sample (not on bars) and a readout
// box: the x of the picked sample nearest the pointer, then swatch, name and y per
// series. Called from the paint callback with the chart locked and its frame built.
fn mm_hover(ui: MythicUi*, p: MythicPainter*, c: MpChart*, r: MythicRect) {
  if (!c->hover || !ui->in.mouse_inside) { return; }
  var info: MpChartInfo;
  if (mp_chart_info(c, &info) != MP_OK || !info.valid) { return; }
  var plot: MpRect = info.plot;
  var ox: float64 = (float64)r.x;
  var oy: float64 = (float64)r.y;
  var mx: float64 = (float64)ui->in.mouse.x - ox;
  var my: float64 = (float64)ui->in.mouse.y - oy;
  if (mx < plot.x || mx > plot.x + plot.w || my < plot.y || my > plot.y + plot.h) { return; }
  var th: MythicTheme* = mythic_theme(ui);
  mythic_dl_push_clip(p->dl, mythic_paint_dev_rect(p, r), 0.0);
  mythic_paint_fill(p, mm_rect(ox + mx - 0.5, oy + plot.y, 1.0, plot.h), mm_zero(),
                    th->colors.text_tertiary);

  var vx: float64[32];
  var vy: float64[32];
  var has: bool[32];
  var n: int32 = mp_chart_series_count(c);
  if (n > MP_MAX_SERIES) { n = MP_MAX_SERIES; }
  var any: bool = false;
  var hx: float64 = 0.0;
  var bestd: float64 = 0.0;
  var bg: uint32 = mm_argb(c->theme.bg);
  var i: int32 = 0;
  while (i < n) {
    var pt: MpPickPoint;
    has[(int64)i] = mp_chart_pick(c, i, mx, &pt);
    if (has[(int64)i]) {
      vx[(int64)i] = pt.x;
      vy[(int64)i] = pt.y;
      var d: float64 = fabs(pt.px - mx);
      if (!any || d < bestd) { bestd = d; hx = pt.x; }
      any = true;
      if (info.kind != MP_BAR) {
        var cc: MythicVec2 = { x: (float32)(ox + pt.px), y: (float32)(oy + pt.py) };
        mythic_paint_circle(p, cc, 5.0, bg);
        mythic_paint_circle(p, cc, 3.5, mm_argb(mp_series_color(c, i)));
      }
    }
    i = i + 1;
  }
  if (!any) {
    mythic_dl_pop_clip(p->dl);
    return;
  }

  var hb: uint8[64];
  var vb: uint8[64];
  var w: float64 = mm_text_w(p->fonts, p->scale, mp_chart_readout_x(c, hx, &hb[0], 64), MM_TIP_SIZE,
                             MP_NF_TABULAR);
  var rows: int32 = 1;
  i = 0;
  while (i < n) {
    if (has[(int64)i]) {
      var rw: float64 = MM_TIP_SW + 6.0 +
        mm_text_w(p->fonts, p->scale, c->series[(int64)i].name, MM_TIP_SIZE, 0) + 12.0 +
        mm_text_w(p->fonts, p->scale, mp_chart_readout_y(c, vy[(int64)i], &vb[0], 64), MM_TIP_SIZE,
                  MP_NF_TABULAR);
      if (rw > w) { w = rw; }
      rows = rows + 1;
    }
    i = i + 1;
  }
  var bw: float64 = w + MM_TIP_PAD * 2.0;
  var bh: float64 = (float64)rows * MM_TIP_ROW + MM_TIP_PAD * 2.0 - 4.0;
  var bx: float64 = mx + 12.0;
  if (bx + bw > plot.x + plot.w) { bx = mx - 12.0 - bw; }
  if (bx < 0.0) { bx = 0.0; }
  var by: float64 = plot.y + 8.0;
  var box: MythicRect = mm_rect(ox + bx, oy + by, bw, bh);
  var rad: MythicCorners = mythic_radius(th->radius.md);
  if (th->elevation.e2.count > 0) { mythic_paint_shadow(p, box, rad, th->elevation.e2.s[0]); }
  mythic_paint_fill(p, box, rad, th->colors.bg_surface_raised);
  mythic_paint_stroke(p, box, rad, 1.0, th->colors.border_default);

  var tx: float64 = ox + bx + MM_TIP_PAD;
  var ty: float64 = oy + by + MM_TIP_PAD - 2.0;
  var lift: float64 = 3.0 + MM_TIP_SIZE * 0.8;   // row top to baseline
  mm_text_at(p, mp_chart_readout_x(c, hx, &hb[0], 64), MM_TIP_SIZE, MP_NF_TABULAR, MP_ALIGN_START,
             tx, ty + lift, th->colors.text_secondary);
  var row: int32 = 1;
  i = 0;
  while (i < n) {
    if (has[(int64)i]) {
      var top: float64 = ty + (float64)row * MM_TIP_ROW;
      var sw: MythicRect = mm_rect(tx, top + (MM_TIP_ROW - MM_TIP_SW) * 0.5, MM_TIP_SW, MM_TIP_SW);
      mythic_paint_fill(p, sw, mythic_radius(2.0), mm_argb(mp_series_color(c, i)));
      mm_text_at(p, c->series[(int64)i].name, MM_TIP_SIZE, 0, MP_ALIGN_START,
                 tx + MM_TIP_SW + 6.0, top + lift, th->colors.text_primary);
      mm_text_at(p, mp_chart_readout_y(c, vy[(int64)i], &vb[0], 64), MM_TIP_SIZE, MP_NF_TABULAR,
                 MP_ALIGN_END, ox + bx + bw - MM_TIP_PAD, top + lift, th->colors.text_primary);
      row = row + 1;
    }
    i = i + 1;
  }
  mythic_dl_pop_clip(p->dl);
}

// ---------------------------------------------------------------- widget

fn mm_chart_paint_cb(ui: MythicUi*, p: MythicPainter*, r: MythicRect, ud: rawptr) {
  var c: MpChart* = (MpChart*)ud;
  if (c == 0 || p == 0 || r.w < 1.0 || r.h < 1.0) { return; }
  var m: MmMeasure = { fonts: p->fonts, scale: p->scale };
  var t: MpTarget = mm_target(&m, (float64)r.w, (float64)r.h);
  mp_chart_lock(c);
  var s: MpScene* = mp_chart_scene(c, &t);
  if (s != 0) {
    mp_mythic_paint_scene(p, s, r);
    mm_hover(ui, p, c, r);
  }
  mp_chart_unlock(c);
}

fn mm_live(c: MpChart*) -> bool {
  mp_chart_lock(c);
  var live: bool = c->keep > 0 || c->span > 0.0;
  mp_chart_unlock(c);
  return live;
}

/// Reserves a box and paints chart c in it at the box's final size and the window's
/// device scale, with MythicUI's fonts, the MythicUI theme (unless mp_chart_set_theme set
/// one) and, while mp_chart_set_hover is on, a guide and value readout under the pointer.
/// The scene is rebuilt only when c's seq, the box size or the scale changed. For a live
/// chart (mp_chart_keep or mp_chart_window set) it requests the next frame
/// MP_MYTHIC_FRAME_MS ahead. Call it on every pass; push samples on ui->pass == 0 only.
///
/// @param ui The MythicUI context. Valid: non-zero; 0 does nothing.
/// @param c The chart. Valid: any; 0 reserves an empty box.
/// @param width Box width. Valid: any MythicSize (mythic_fixed, mythic_grow, ...).
/// @param height Box height. Valid: any MythicSize.
/// @mem c is borrowed by the frame's paint callback and must stay alive until the frame
///   ends (free it only outside the frame callback). Nothing else is retained. Showing one
///   chart in two boxes of different sizes rebuilds its scene twice per frame.
/// @thread The UI thread. Other threads may push to c after mp_chart_share(c): the paint
///   holds mp_chart_lock(c) while it builds and paints the frame.
/// @cost O(1) when nothing changed; a rebuild costs as mp_chart_scene.
export fn mp_mythic_chart(ui: MythicUi*, c: MpChart*, width: MythicSize, height: MythicSize) {
  if (ui == 0) { return; }
  mythic_box_begin(ui, { width: width, height: height, clip: true });
  mythic_end(ui);
  if (c == 0) { return; }
  var th: MpTheme = mp_mythic_theme(ui);
  mp_chart_set_host_theme(c, th);
  mythic_node_paint(ui, &mm_chart_paint_cb, (rawptr)c);
  if (mm_live(c)) { mythic_request_frame_in(ui, MP_MYTHIC_FRAME_MS); }
}

// ---------------------------------------------------------------- PNG export

fn mm_png_frame_cb(ui: MythicUi*, ud: rawptr) {
  mythic_column_begin(ui, { width: mythic_grow(), height: mythic_grow() });
  mp_mythic_chart(ui, (MpChart*)ud, mythic_grow(), mythic_grow());
  mythic_end(ui);
}

fn mm_dim_ok(v: float64, scale: float64) -> bool {
  return v >= 1.0 && v <= 16384.0 && v * scale <= 16384.0;
}

/// Renders chart c through MythicUI's headless platform at w x h logical px and scale
/// device px per logical px, and writes the framebuffer (round(w * scale) x
/// round(h * scale) px) to a PNG file. The chart gets the light MythicUI theme unless it
/// has an explicit theme, and no hover.
///
/// @param c The chart. Valid: non-zero.
/// @param w Width. Units: logical px. Valid: 1 .. 16384, and w * scale <= 16384.
/// @param h Height. Units: logical px. Valid: 1 .. 16384, and h * scale <= 16384.
/// @param scale Device px per logical px (e.g. 1, 1.5, 2). Valid: finite, in (0, 8].
/// @param path PNG file path. Valid: non-empty.
/// @return MP_OK, or an error code.
/// @error MP_ERR_ARG c is 0, path is empty or a size or the scale is out of range; nothing
///   is written.
/// @error MP_ERR_ALLOC the headless app or the frame could not be allocated (a frame
///   failure is also the chart's sticky error); nothing is written.
/// @error MP_ERR_STATE no frame was produced; nothing is written.
/// @error MP_ERR_IO the PNG could not be written.
/// @mem Creates and destroys a headless MythicUI app; nothing is retained. Applies the
///   MythicUI host theme to c, which bumps its seq when the theme changes.
/// @thread One thread at a time, outside every MythicUI frame and paint callback (MythicUI
///   keeps a process-wide text cache); other threads may push to c after mp_chart_share(c).
/// @cost One frame at the given size plus PNG encoding.
export fn mp_mythic_save_png(c: MpChart*, w: float64, h: float64, scale: float64, path: string) -> int32 {
  if (c == 0 || path.length == (uint64)0) { return MP_ERR_ARG; }
  if (!(scale > 0.0) || scale > 8.0 || !mm_dim_ok(w, scale) || !mm_dim_ok(h, scale)) {
    return MP_ERR_ARG;
  }
  var app: MythicApp* = mythic_app_create_headless({ title: "mistplot", width: (float32)w,
                                                     height: (float32)h }, (float32)scale);
  if (app == 0) { return MP_ERR_ALLOC; }
  mythic_app_step(app, &mm_png_frame_cb, (rawptr)c, false);
  var rc: int32 = MP_OK;
  if (mythic_app_frames(app) < 1) { rc = MP_ERR_STATE; }
  if (rc == MP_OK) {
    // the frame painted from the chart's cache; building it again with the same target is a
    // cache hit that reports whether the build succeeded
    var ui: MythicUi* = mythic_app_ui(app);
    var m: MmMeasure = { fonts: ui->fonts, scale: ui->scale };
    var t: MpTarget = mm_target(&m, w, h);
    mp_chart_lock(c);
    rc = mp_frame_scene(c, &t);
    mp_chart_unlock(c);
  }
  if (rc == MP_OK && !mythic_app_save_png(app, path)) { rc = MP_ERR_IO; }
  mythic_app_destroy(app);
  return rc;
}
