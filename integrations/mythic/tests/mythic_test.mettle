// integrations/mythic/tests/mythic_test — headless MythicUI checks for the
// MistPlot integration. Run from the repo root; writes
// build/integrations/mythic/test_*.png.
//
// Layout (logical px, scale 1, window 940 x 900, pad 20, gap 20):
//   row 1: static line chart (20, 20, 440, 280), live line chart (480, 20, 440, 280)
//   row 2: clip probe (20, 320, 120, 80), static bar chart (160, 320, 440, 260)
//   row 3: smooth area chart (20, 600, 440, 260), scatter with an explicit light theme
//          (480, 600, 440, 260)
// Pixels are read back from the headless framebuffer (0xAARRGGBB).

import "std/io";
import "std/mem";
import "std/math";
import "mythic/mythic";
import "mistplot/test/harness";
import "mistplot/mistplot";
import "mistplot/scene/scene";
import "../mp_mythic";

struct T {
  st: MpChart*;          // static line: alpha (smooth), beta (dashed, circle markers)
  lv: MpChart*;          // live line: cpu, mem
  bars: MpChart*;        // static bars
  area: MpChart*;        // smooth area
  sc: MpChart*;          // scatter: circle, square, diamond; explicit light theme
  probe: MpScene*;       // scene painted by the clip probe
  pending: int32;        // samples to push on the next pass 0
  pushed: int64;
  dark_req: int32;       // 1 = switch to dark on next pass 0, 2 = light
}

fn ingest(ui: MythicUi*, t: T*) {
  if (ui->pass != 0) { return; }
  if (t->dark_req == 1) { mythic_set_theme(ui, mythic_theme_dark()); }
  if (t->dark_req == 2) { mythic_set_theme(ui, mythic_theme_light()); }
  t->dark_req = 0;
  // deterministic x (0.05 s apart) so the pixels do not depend on frame timing
  var k: int32 = 0;
  while (k < t->pending) {
    var x: float64 = (float64)t->pushed * 0.05;
    mp_chart_push(t->lv, 0, x, 50.0 + 30.0 * sin(x * 0.9));
    mp_chart_push(t->lv, 1, x, 40.0 + 20.0 * cos(x * 0.5));
    t->pushed = t->pushed + 1;
    k = k + 1;
  }
  t->pending = 0;
}

fn mp_mythic_test_probe_cb(ui: MythicUi*, p: MythicPainter*, r: MythicRect, ud: rawptr) {
  var t: T* = (T*)ud;
  mp_mythic_paint_scene(p, t->probe, r);
}

fn frame(ui: MythicUi*, ud: rawptr) {
  var t: T* = (T*)ud;
  ingest(ui, t);
  mythic_column_begin(ui, { pad: mythic_pad(20), gap: 20 });
    mythic_row_begin(ui, { gap: 20 });
      mp_mythic_chart(ui, t->st, mythic_fixed(440), mythic_fixed(280));
      mp_mythic_chart(ui, t->lv, mythic_fixed(440), mythic_fixed(280));
    mythic_end(ui);
    mythic_row_begin(ui, { gap: 20 });
      mythic_box_begin(ui, { width: mythic_fixed(120), height: mythic_fixed(80) });
      mythic_end(ui);
      mythic_node_paint(ui, &mp_mythic_test_probe_cb, ud);
      mp_mythic_chart(ui, t->bars, mythic_fixed(440), mythic_fixed(260));
    mythic_end(ui);
    mythic_row_begin(ui, { gap: 20 });
      mp_mythic_chart(ui, t->area, mythic_fixed(440), mythic_fixed(260));
      mp_mythic_chart(ui, t->sc, mythic_fixed(440), mythic_fixed(260));
    mythic_end(ui);
  mythic_end(ui);
}

fn px_at(app: MythicApp*, x: int32, y: int32) -> uint32 {
  var fb: MythicFramebuffer = mythic_app_framebuffer(app);
  if (x < 0 || y < 0 || x >= fb.w || y >= fb.h) { return (uint32)0; }
  return fb.px[(int64)y * (int64)fb.stride + (int64)x];
}

fn rect(x: float32, y: float32, w: float32, h: float32) -> MythicRect {
  var r: MythicRect = { x: x, y: y, w: w, h: h };
  return r;
}

fn count_color(app: MythicApp*, r: MythicRect, c: uint32) -> int64 {
  var n: int64 = 0;
  var y: int32 = (int32)r.y;
  while (y < (int32)(r.y + r.h)) {
    var x: int32 = (int32)r.x;
    while (x < (int32)(r.x + r.w)) {
      if (px_at(app, x, y) == c) { n = n + 1; }
      x = x + 1;
    }
    y = y + 1;
  }
  return n;
}

fn chan_near(a: uint32, b: uint32, sh: uint32, tol: int32) -> bool {
  var d: int32 = (int32)((a >> sh) & (uint32)255) - (int32)((b >> sh) & (uint32)255);
  return d <= tol && d >= 0 - tol;
}

// Pixels in r within tol of c on every colour channel.
fn count_near(app: MythicApp*, r: MythicRect, c: uint32, tol: int32) -> int64 {
  var n: int64 = 0;
  var y: int32 = (int32)r.y;
  while (y < (int32)(r.y + r.h)) {
    var x: int32 = (int32)r.x;
    while (x < (int32)(r.x + r.w)) {
      var v: uint32 = px_at(app, x, y);
      if (chan_near(v, c, (uint32)16, tol) && chan_near(v, c, (uint32)8, tol) &&
          chan_near(v, c, (uint32)0, tol)) {
        n = n + 1;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return n;
}

// Pixels in the 12 px ring around r (excluding r) that differ from `bg`.
fn ring_dirty(app: MythicApp*, r: MythicRect, bg: uint32) -> int64 {
  var n: int64 = 0;
  var x0: int32 = (int32)r.x; var y0: int32 = (int32)r.y;
  var x1: int32 = (int32)(r.x + r.w); var y1: int32 = (int32)(r.y + r.h);
  var y: int32 = y0 - 12;
  while (y < y1 + 12) {
    var x: int32 = x0 - 12;
    while (x < x1 + 12) {
      var inside: bool = x >= x0 && x < x1 && y >= y0 && y < y1;
      if (!inside && px_at(app, x, y) != bg) { n = n + 1; }
      x = x + 1;
    }
    y = y + 1;
  }
  return n;
}

fn step(app: MythicApp*, t: T*, n: int32) {
  var i: int32 = 0;
  while (i < n) {
    mythic_headless_advance_us(mythic_app_platform(app), 16667);
    mythic_app_step(app, &frame, (rawptr)t, false);
    i = i + 1;
  }
}

fn out_path(name: string) -> string {
  return "build/integrations/mythic/{name}.png";
}

fn save(app: MythicApp*, name: string) {
  var path: string = out_path(name);
  mp_expect("png {name}", mythic_app_save_png(app, path));
  println("wrote {path}");
  free((rawptr)path.chars);
}

fn argb(c: MpColor) -> uint32 {
  return ((uint32)c.a << 24) | ((uint32)c.r << 16) | ((uint32)c.g << 8) | (uint32)c.b;
}

fn builds(c: MpChart*) -> int64 {
  var s: MpChartStats;
  mp_chart_stats(c, &s);
  return s.scene_builds;
}

// Counts pixels in the column at device x, rows [y0, y1), equal to c.
fn col_count(app: MythicApp*, x: int32, y0: int32, y1: int32, c: uint32) -> int64 {
  var n: int64 = 0;
  var y: int32 = y0;
  while (y < y1) {
    if (px_at(app, x, y) == c) { n = n + 1; }
    y = y + 1;
  }
  return n;
}

fn frame2x(ui: MythicUi*, ud: rawptr) {
  var t: T* = (T*)ud;
  mythic_column_begin(ui, { pad: mythic_pad(20), width: mythic_grow(), height: mythic_grow() });
    mp_mythic_chart(ui, t->st, mythic_grow(), mythic_grow());
  mythic_end(ui);
}

// HiDPI: the static chart on a scale-2 headless window (device px = 2 x logical).
fn run_2x(t: T*) {
  var app: MythicApp* = mythic_app_create_headless(
    { title: "mp_mythic_test_2x", width: 480.0, height: 320.0 }, 2.0);
  mp_expect("2x app", app != 0);
  if (app == 0) { return; }
  var i: int32 = 0;
  while (i < 3) {
    mythic_headless_advance_us(mythic_app_platform(app), 16667);
    mythic_app_step(app, &frame2x, (rawptr)t, false);
    i = i + 1;
  }
  var ui: MythicUi* = mythic_app_ui(app);
  var th: MythicTheme* = mythic_theme(ui);
  var info: MpChartInfo;
  mp_chart_info(t->st, &info);
  mp_expect("2x frame at scale 2", info.scale == 2.0);
  mp_expect("2x frame logical size", info.width == 440.0 && info.height == 280.0);
  mp_expect("2x bg pixel", px_at(app, 46, 46) == th->colors.bg_surface);
  var dr: MythicRect = rect(40.0, 40.0, 880.0, 560.0);
  var n0: int64 = count_color(app, dr, argb(mp_series_color(t->st, 0)));
  println("2x: series0 px {n0}");
  mp_expect("2x series 0 pixels", n0 > 1200);
  mp_expect_i64("2x nothing outside", ring_dirty(app, dr, th->colors.bg_window), 0);
  // the plot's top edge is snapped: the grid row under it is whole device px
  mp_expect("2x plot snapped", info.plot.y * 2.0 == floor(info.plot.y * 2.0));
  mp_expect_i64("static chart requests no frames", ui->next_frame_us, 0);
  save(app, "test_static_2x");
  mythic_app_destroy(app);
}

fn png_dims(path: string, w: int64*, h: int64*) -> bool {
  var b: uint8[32];
  var z: uint8[256];
  var i: int64 = 0;
  while (i < (int64)path.length && i < 255) {
    z[i] = path.chars[i];
    i = i + 1;
  }
  z[i] = (uint8)0;
  var fp: cstring = fopen((cstring)&z[0], "rb");
  if (fp == 0) { return false; }
  var n: int64 = fread((cstring)&b[0], 1, 24, fp);
  fclose(fp);
  if (n != 24 || b[1] != (uint8)80 || b[2] != (uint8)78 || b[3] != (uint8)71) { return false; }
  *w = ((int64)b[16] << 24) | ((int64)b[17] << 16) | ((int64)b[18] << 8) | (int64)b[19];
  *h = ((int64)b[20] << 24) | ((int64)b[21] << 16) | ((int64)b[22] << 8) | (int64)b[23];
  return true;
}

fn check_png(t: T*) {
  var p1: string = out_path("test_png_1x");
  var p2: string = out_path("test_png_2x");
  mp_expect_i64("save_png 1x", (int64)mp_mythic_save_png(t->st, 640.0, 400.0, 1.0, p1), (int64)MP_OK);
  mp_expect_i64("save_png 2x", (int64)mp_mythic_save_png(t->area, 640.0, 400.0, 2.0, p2), (int64)MP_OK);
  var w: int64 = 0;
  var h: int64 = 0;
  mp_expect("png 1x readable", png_dims(p1, &w, &h));
  mp_expect("png 1x is 640 x 400", w == 640 && h == 400);
  mp_expect("png 2x readable", png_dims(p2, &w, &h));
  mp_expect("png 2x is 1280 x 800", w == 1280 && h == 800);
  var info: MpChartInfo;
  mp_chart_info(t->area, &info);
  mp_expect("png 2x frame scale", info.scale == 2.0 && info.width == 640.0);
  println("wrote {p1}");
  println("wrote {p2}");
  mp_expect_i64("save_png no chart", (int64)mp_mythic_save_png((MpChart*)0, 640.0, 400.0, 1.0, p1),
                (int64)MP_ERR_ARG);
  mp_expect_i64("save_png bad scale", (int64)mp_mythic_save_png(t->st, 640.0, 400.0, 0.0, p1),
                (int64)MP_ERR_ARG);
  mp_expect_i64("save_png bad size", (int64)mp_mythic_save_png(t->st, 0.5, 400.0, 1.0, p1),
                (int64)MP_ERR_ARG);
  mp_expect_i64("save_png empty path", (int64)mp_mythic_save_png(t->st, 640.0, 400.0, 1.0, ""),
                (int64)MP_ERR_ARG);
  mp_expect_i64("save_png bad dir",
                (int64)mp_mythic_save_png(t->st, 64.0, 40.0, 1.0, "build/no/such/dir/x.png"),
                (int64)MP_ERR_IO);
  free((rawptr)p1.chars);
  free((rawptr)p2.chars);
}

fn setup(t: T*) {
  t->st = mp_chart_new(MP_LINE);
  mp_chart_set_title(t->st, "Static line");
  mp_chart_set_x_label(t->st, "x");
  mp_chart_set_y_label(t->st, "value");
  var a: int32 = mp_chart_series(t->st, "alpha");
  var b: int32 = mp_chart_series(t->st, "beta");
  mp_series_set_smooth(t->st, a, true);
  mp_series_set_dash(t->st, b, MP_DASH_DASHED);
  mp_series_set_marker(t->st, b, MP_MARK_CIRCLE, 3.0);
  var i: int32 = 0;
  while (i < 40) {
    var x: float64 = (float64)i;
    mp_chart_push(t->st, a, x, 20.0 + 15.0 * sin(x * 0.3) + x);
    mp_chart_push(t->st, b, x, 30.0 + 10.0 * cos(x * 0.25));
    i = i + 1;
  }

  t->lv = mp_chart_new(MP_LINE);
  mp_chart_series(t->lv, "cpu");
  mp_chart_series(t->lv, "mem");
  mp_chart_keep(t->lv, 4096);
  mp_chart_window(t->lv, 10.0);
  mp_chart_set_title(t->lv, "Live");
  mp_chart_set_x_format(t->lv, MP_FMT_TIME);
  mp_chart_set_y_range(t->lv, 0.0, 100.0);

  t->bars = mp_chart_new(MP_BAR);
  mp_chart_set_title(t->bars, "Static bars");
  mp_chart_set_legend(t->bars, MP_LEGEND_BOTTOM);
  var s: int32 = mp_chart_series(t->bars, "sales");
  var names: string[7] = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];
  i = 0;
  while (i < 7) {
    mp_chart_set_value(t->bars, s, names[(int64)i], 3.0 + (float64)((i * 5) % 7));
    i = i + 1;
  }

  t->area = mp_chart_new(MP_AREA);
  mp_chart_set_title(t->area, "Smooth area");
  mp_chart_set_y_range(t->area, 0.0, 100.0);
  var ar: int32 = mp_chart_series(t->area, "load");
  mp_series_set_smooth(t->area, ar, true);
  i = 0;
  while (i < 30) {
    var x2: float64 = (float64)i;
    mp_chart_push(t->area, ar, x2, 55.0 + 20.0 * sin(x2 * 0.35));
    i = i + 1;
  }

  t->sc = mp_chart_new(MP_SCATTER);
  mp_chart_set_title(t->sc, "Scatter, explicit light theme");
  mp_chart_set_theme(t->sc, mp_theme_light());
  var shapes: int32[3] = [MP_MARK_CIRCLE, MP_MARK_SQUARE, MP_MARK_DIAMOND];
  var k: int32 = 0;
  while (k < 3) {
    var si: int32 = mp_chart_series(t->sc, "s{k}");
    mp_series_set_marker(t->sc, si, shapes[(int64)k], 6.0);
    i = 0;
    while (i < 12) {
      var x3: float64 = (float64)i;
      mp_chart_push(t->sc, si, x3, (float64)(k * 10) + 5.0 + 3.0 * sin(x3 + (float64)k));
      i = i + 1;
    }
    k = k + 1;
  }

  // clip probe: a rect and a line far larger than the 120x80 box
  t->probe = mp_scene_new();
  mp_scene_rect(t->probe, mp_rect(-60.0, -60.0, 400.0, 400.0), mp_rgb(200, 30, 40),
                mp_rgba(0, 0, 0, 0), 0.0, MP_CLS_BG);
  mp_scene_line(t->probe, -80.0, 40.0, 300.0, 40.0, mp_rgb(0, 0, 255), 4.0, MP_CLS_AXIS);
  // a diamond across the raster tile boundary at window x 64 (probe x 44)
  mp_scene_marker(t->probe, 46.3, 20.0, 6.0, MP_MARK_DIAMOND, mp_rgb(0, 160, 0),
                  mp_rgba(0, 0, 0, 0), 0.0, MP_CLS_SERIES);
}

export fn main() -> int32 {
  var t: T* = (T*)malloc(sizeof(T));
  memset((rawptr)t, 0, sizeof(T));
  setup(t);
  t->pending = 200;

  var app: MythicApp* = mythic_app_create_headless(
    { title: "mp_mythic_test", width: 940.0, height: 900.0 }, 1.0);
  mp_expect("app", app != 0);
  if (app == 0) { return mp_summary(); }
  var ui: MythicUi* = mythic_app_ui(app);
  step(app, t, 3);
  var th: MythicTheme* = mythic_theme(ui);

  // ---- static chart
  var r: MythicRect = rect(20.0, 20.0, 440.0, 280.0);
  var info: MpChartInfo;
  mp_chart_info(t->st, &info);
  mp_expect("static frame at the box size", info.width == 440.0 && info.height == 280.0);
  mp_expect_i64("static built once", builds(t->st), 1);
  mp_expect_i64("static no error", (int64)mp_chart_error(t->st), 0);
  mp_expect("bg pixel = theme surface", px_at(app, 23, 23) == th->colors.bg_surface);
  mp_expect("window bg outside", px_at(app, 10, 10) == th->colors.bg_window);
  var c0: uint32 = argb(mp_series_color(t->st, 0));
  var c1: uint32 = argb(mp_series_color(t->st, 1));
  var n0: int64 = count_color(app, r, c0);
  var n1: int64 = count_color(app, r, c1);
  println("static: series0 px {n0}, series1 px {n1}");
  mp_expect("series 0 pixels on the smooth line", n0 > 300);
  mp_expect("series 1 pixels on the dashed line", n1 > 150);
  mp_expect_i64("nothing outside static chart", ring_dirty(app, r, th->colors.bg_window), 0);
  // the y grid lines are whole device px rows: one row of grid colour across the plot
  var grid: uint32 = th->colors.border_subtle;
  var gx: int32 = (int32)(r.x + (float32)(info.plot.x + info.plot.w * 0.5));
  var grid_px: int64 = col_count(app, gx, (int32)(r.y + (float32)info.plot.y),
                                 (int32)(r.y + (float32)(info.plot.y + info.plot.h)), grid);
  println("static: grid px in the middle column {grid_px}");
  mp_expect("grid rows are crisp", grid_px >= 3);

  // ---- clip probe
  var pr: MythicRect = rect(20.0, 320.0, 120.0, 80.0);
  var probe_px: int64 = 120 * 80 - count_color(app, pr, th->colors.bg_window);
  mp_expect_i64("probe fills its box", probe_px, 120 * 80);
  mp_expect("diamond painted", count_color(app, pr, 0xFF00A000) > 30);
  // the column right of the raster tile boundary is filled (no seam)
  mp_expect("diamond has no seam at the tile edge", col_count(app, 64, 336, 345, 0xFF00A000) >= 5);
  mp_expect_i64("probe line is 4 px rows", count_color(app, pr, 0xFF0000FF), 120 * 4);
  mp_expect_i64("probe clipped to its box", ring_dirty(app, pr, th->colors.bg_window), 0);

  // ---- bar chart
  var br: MythicRect = rect(160.0, 320.0, 440.0, 260.0);
  mp_expect("bar pixels", count_color(app, br, argb(mp_series_color(t->bars, 0))) > 2000);
  mp_expect_i64("nothing outside bar chart", ring_dirty(app, br, th->colors.bg_window), 0);

  // ---- area chart: inside the area the fill is a light tint of series 0
  var arr: MythicRect = rect(20.0, 600.0, 440.0, 260.0);
  var ai: MpChartInfo;
  mp_chart_info(t->area, &ai);
  var apx: uint32 = px_at(app, (int32)(arr.x + (float32)(ai.plot.x + ai.plot.w * 0.5)),
                          (int32)(arr.y + (float32)(ai.plot.y + ai.plot.h * 0.85)));
  println("area: fill pixel {apx}");
  mp_expect("area filled", apx != th->colors.bg_surface);
  mp_expect("area fill is a tint of series 0", (apx & (uint32)255) > ((apx >> 16) & (uint32)255));
  mp_expect("area line pixels", count_color(app, arr, argb(mp_series_color(t->area, 0))) > 300);
  mp_expect_i64("nothing outside area chart", ring_dirty(app, arr, th->colors.bg_window), 0);

  // ---- scatter: every marker shape paints its 0.8-alpha fill over the light background
  var scr: MythicRect = rect(480.0, 600.0, 440.0, 260.0);
  mp_expect("explicit theme wins", px_at(app, 483, 603) == 0xFFFFFFFF);
  var k: int32 = 0;
  while (k < 3) {
    var col: uint32 = argb(mp_series_color(t->sc, k));
    var want: uint32 = mythic_color_over(0xFFFFFFFF, (col & (uint32)0x00FFFFFF) | (uint32)0xCC000000);
    var nm: int64 = count_near(app, scr, want, 3);
    println("scatter: series {k} marker px {nm}");
    mp_expect("scatter markers of series {k}", nm > 12 * 40);
    k = k + 1;
  }

  // ---- live chart
  var lr: MythicRect = rect(480.0, 20.0, 440.0, 280.0);
  mp_expect_i64("live built once", builds(t->lv), 1);
  mp_expect_i64("live no error", (int64)mp_chart_error(t->lv), 0);
  mp_expect("live series 0 pixels", count_color(app, lr, argb(mp_series_color(t->lv, 0))) > 300);
  mp_expect("live series 1 pixels", count_color(app, lr, argb(mp_series_color(t->lv, 1))) > 300);
  mp_expect_i64("nothing outside live chart", ring_dirty(app, lr, th->colors.bg_window), 0);
  mp_expect("live requests frames", ui->next_frame_us > 0);
  save(app, "test_light");

  // ---- unchanged seq: frames keep coming (live requests them), no rebuild
  var lb0: int64 = builds(t->lv);
  var sb0: int64 = builds(t->st);
  var f0: int64 = mythic_app_frames(app);
  step(app, t, 5);
  mp_expect("frames ran", mythic_app_frames(app) - f0 >= 5);
  mp_expect_i64("live not rebuilt without push", builds(t->lv), lb0);
  mp_expect_i64("static not rebuilt", builds(t->st), sb0);

  // ---- push: exactly one rebuild
  var seq0: int64 = mp_chart_seq(t->lv);
  t->pending = 20;
  step(app, t, 1);
  mp_expect("seq moved", mp_chart_seq(t->lv) > seq0);
  mp_expect_i64("live rebuilt after push", builds(t->lv), lb0 + 1);
  step(app, t, 2);
  mp_expect_i64("and only once", builds(t->lv), lb0 + 1);

  // ---- hover: mouse at 30% x, 80% y of the live plot
  var linfo: MpChartInfo;
  mp_chart_info(t->lv, &linfo);
  var pl: MpRect = linfo.plot;
  mp_expect("live plot found", pl.w > 100.0 && pl.h > 100.0);
  var mx: float32 = lr.x + (float32)pl.x + (float32)(pl.w * 0.3);
  var my: float32 = lr.y + (float32)pl.y + (float32)(pl.h * 0.8);
  mx = mythic_floorf(mx) + 0.5;
  var hx: int32 = (int32)mx;
  var y0: int32 = (int32)(lr.y + (float32)pl.y) + 1;
  var y1: int32 = (int32)(lr.y + (float32)(pl.y + pl.h)) - 1;
  var tert: uint32 = th->colors.text_tertiary;
  var guide_before: int64 = col_count(app, hx, y0, y1, tert);
  var ev: MythicEvent = { kind: MYTHIC_EV_MOUSE_MOVE, x: mx * ui->scale, y: my * ui->scale };
  mythic_headless_push(mythic_app_platform(app), ev);
  step(app, t, 1);
  var guide_after: int64 = col_count(app, hx, y0, y1, tert);
  print("hover: guide px before {guide_before}, after {guide_after}, ");
  println("column {hx}, rows {y0}..{y1}");
  mp_expect("guide column painted", guide_after > (int64)(y1 - y0) / 2);
  mp_expect("guide not there before", guide_before < 10);
  // the readout box's 1 px border is the only border_default-coloured thing in the chart
  mp_expect("readout box border present", count_color(app, lr, th->colors.border_default) > 100);
  // the dot on series 0 sits on the sample mp_chart_pick finds under the pointer
  var pt: MpPickPoint;
  mp_expect("pick under the pointer", mp_chart_pick(t->lv, 0, (float64)(mx - lr.x), &pt));
  var want_x: float64 = linfo.x0 + (linfo.x1 - linfo.x0) * 0.3;
  mp_expect_near("picked sample is nearest the pointer", pt.x, want_x, 0.06);
  var dot: uint32 = px_at(app, (int32)(lr.x + (float32)pt.px), (int32)(lr.y + (float32)pt.py));
  mp_expect("hover dot in series 0 colour", dot == argb(mp_series_color(t->lv, 0)));
  mp_expect_i64("hover did not rebuild", builds(t->lv), lb0 + 1);
  mp_expect_i64("nothing outside live chart (hover)", ring_dirty(app, lr, th->colors.bg_window), 0);
  save(app, "test_hover");

  // ---- dark theme: the host-themed charts rebuild and follow, the explicit one does not
  t->dark_req = 1;
  var sbd: int64 = builds(t->st);
  var scb: int64 = builds(t->sc);
  step(app, t, 2);
  th = mythic_theme(ui);
  mp_expect("dark theme active", th->dark);
  mp_expect("static rebuilt on theme", builds(t->st) > sbd);
  mp_expect_i64("explicit theme chart not rebuilt", builds(t->sc), scb);
  mp_expect("dark bg pixel", px_at(app, 23, 23) == th->colors.bg_surface);
  mp_expect("dark window bg", px_at(app, 10, 10) == th->colors.bg_window);
  mp_expect("explicit light theme kept", px_at(app, 483, 603) == 0xFFFFFFFF);
  mp_expect_i64("nothing outside static chart (dark)", ring_dirty(app, r, th->colors.bg_window), 0);
  mp_expect("dark series 0 pixels", count_color(app, r, c0) > 300);
  save(app, "test_dark");
  mythic_app_destroy(app);

  run_2x(t);
  check_png(t);
  mp_chart_free(t->st);
  mp_chart_free(t->lv);
  mp_chart_free(t->bars);
  mp_chart_free(t->area);
  mp_chart_free(t->sc);
  mp_scene_free(t->probe);
  free((rawptr)t);
  return mp_summary();
}
