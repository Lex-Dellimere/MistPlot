// integrations/meodb/examples/meo_live_chart: a live MistPlot chart that follows a MeoDB
// table and redraws only on committed data.
//
// A writer thread inserts one reading per sensor into a WAL-mode MeoDB table and commits
// every ~200 ms; every few seconds it also deletes readings older than the retention.
// The main thread polls an MpMeoWatch over the database's change feed. The table is
// watched through a column mapping (x = t, y = deg, series = sensor), so committed
// inserts go straight into the chart, and a delete reloads it with a range scan on the
// indexed t column. Once a second the chart is written to an SVG file and drawn in the
// terminal (Braille), with the subtitle "updated hh:mm:ss · commit N".
//
//   readings(id INTEGER PRIMARY KEY, sensor INTEGER NOT NULL, t REAL NOT NULL, deg REAL)
//   index readings_t on t
//
// Threads: the writer owns every write; MeoDb's own lock serialises it with the watch's
// reload scan, and in WAL mode commits never wait for readers. Only the main thread
// touches the chart, so it is not shared (call mp_chart_share before rendering it on
// another thread, e.g. from RaizeWeb workers).
//
// Usage (from the mistplot repo root):
//   meo_live_chart [--run-for S] [--db PATH] [--svg PATH] [--first-svg PATH]
//                  [--retain S] [--quiet]
//   --run-for S     run S seconds (default 10), then stop the writer, join it, poll and
//                   render one last time, and exit
//   --db PATH       database file (default build/integrations/meodb/live.db), recreated
//   --svg PATH      the SVG rewritten every second (default build/integrations/meodb/live.svg)
//   --first-svg P   a copy of the first second's SVG (default .../live.first.svg)
//   --retain S      the writer deletes readings older than S seconds (default 20)
//   --quiet         print the terminal chart only once, at the end
//
// Exit codes: 0 ok, 1 setup failed, 2 the writer, a poll or a render failed.

import "std/io";
import "std/mem";
import "std/math";
import "std/conv";
import "std/thread";
import "meodb/src/meodb";
import "meodb/src/platform/file";
import "meodb/src/platform/file_linux";
import "meodb/src/platform/clock_linux";
import "meodb/src/feed/feed";
import "mistplot/mistplot";
import "../mp_meo";

const DEMO_SENSORS: int32 = 3;
const DEMO_COMMIT_MS: uint32 = 200;
const DEMO_POLL_MS: uint32 = 50;
const DEMO_PURGE_EVERY: int32 = 5;      // commits between retention deletes
const DEMO_TERM_COLS: int32 = 100;
const DEMO_TERM_ROWS: int32 = 28;

struct Demo {
  db: MeoDb*;
  feed: MeoFeed*;
  w: MpMeoWatch*;
  c: MpChart*;
  table_id: uint32;
  t0_us: int64;         // wall clock at start (x = seconds since)
  retain_s: float64;
  stop: int32;          // atomic: writer should stop
  writer_err: int32;
  commits: int32;       // writer's committed transactions
  purges: int32;        // retention deletes that removed rows
}

// --- writer thread ---------------------------------------------------------

fn demo_xorshift(s: uint32*) -> uint32 {
  var x: uint32 = *s;
  x = x ^ (x << (uint32)13);
  x = x ^ (x >> (uint32)17);
  x = x ^ (x << (uint32)5);
  *s = x;
  return x;
}

// One reading in degrees: 20 + 4*sensor, a sine with a 6 s period (phase-shifted per
// sensor), plus +-0.5 degree noise.
fn demo_reading(sensor: int32, t: float64, rng: uint32*) -> float64 {
  var u: float64 = (float64)demo_xorshift(rng) / 4294967296.0;
  return 20.0 + 4.0 * (float64)sensor +
    3.0 * sin(t * 6.283185307179586 / 6.0 + (float64)sensor * 1.3) + (u - 0.5);
}

fn demo_insert(db: MeoDb*, sensor: int32, t: float64, deg: float64) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_insert(db, "readings", &q);
  if (rc != MEO_OK) { return rc; }
  meo_q_into(q, "sensor");
  meo_q_into(q, "t");
  meo_q_into(q, "deg");
  var v: MeoValue;
  meo_value_set_int(&v, (int64)sensor);
  meo_q_value(q, &v);
  meo_value_set_real(&v, t);
  meo_q_value(q, &v);
  meo_value_set_real(&v, deg);
  meo_q_value(q, &v);
  rc = meo_q_step(q);
  meo_q_free(q);
  if (rc == MEO_DONE) { return MEO_OK; }
  return rc;
}

// DELETE FROM readings WHERE t < before; the number of rows removed, or a negative code.
fn demo_purge(db: MeoDb*, before: float64) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_delete(db, "readings", &q);
  if (rc != MEO_OK) { return rc; }
  var v: MeoValue;
  meo_value_set_real(&v, before);
  meo_q_where(q, "t", MEO_Q_LT, &v);
  rc = meo_q_step(q);
  var n: int32 = meo_q_changes(q);
  meo_q_free(q);
  if (rc != MEO_DONE) { return rc; }
  return n;
}

fn demo_writer(arg: cstring) -> uint32 {
  var d: Demo* = (Demo*)arg;
  var rng: uint32 = (uint32)2463534242;
  while (atomic_compare_exchange_i32(&d->stop, 0, 0) == 0) {
    var t: float64 = (float64)(meo_clock_realtime_us() - d->t0_us) / 1000000.0;
    var rc: int32 = meo_db_begin(d->db, MEO_TX_DEFAULT);
    var s: int32 = 0;
    while (rc == MEO_OK && s < DEMO_SENSORS) {
      rc = demo_insert(d->db, s, t, demo_reading(s, t, &rng));
      s = s + 1;
    }
    if (rc == MEO_OK) {
      rc = meo_db_commit(d->db);
    } else {
      meo_db_rollback(d->db);
    }
    if (rc != MEO_OK) {
      d->writer_err = rc;
      break;
    }
    d->commits = d->commits + 1;
    if (d->commits % DEMO_PURGE_EVERY == 0) {
      var n: int32 = demo_purge(d->db, t - d->retain_s);   // autocommit
      if (n < 0) {
        d->writer_err = n;
        break;
      }
      if (n > 0) { d->purges = d->purges + 1; }
    }
    thread_sleep_ms(DEMO_COMMIT_MS);
  }
  return 0;
}

// --- setup -----------------------------------------------------------------

fn demo_remove(path: string) {
  meo_file_unlink(path);
  var j: string = path + "-journal";
  meo_file_unlink(j);
  free(j.chars);
  var wl: string = path + "-wal";
  meo_file_unlink(wl);
  free(wl.chars);
}

fn demo_schema(db: MeoDb*) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_create(db, "readings", &q);
  if (rc != MEO_OK) { return rc; }
  meo_q_column_def(q, "id", MEO_T_INT, MEO_COL_PK);
  meo_q_column_def(q, "sensor", MEO_T_INT, MEO_COL_NOT_NULL);
  meo_q_column_def(q, "t", MEO_T_REAL, MEO_COL_NOT_NULL);
  meo_q_column_def(q, "deg", MEO_T_REAL, 0);
  rc = meo_q_step(q);
  meo_q_free(q);
  if (rc != MEO_DONE) { return rc; }
  var qi: MeoQuery* = 0;
  rc = meo_q_create_index(db, "readings", "readings_t", &qi);
  if (rc != MEO_OK) { return rc; }
  meo_q_index_column(qi, "t");
  rc = meo_q_step(qi);
  meo_q_free(qi);
  if (rc != MEO_DONE) { return rc; }
  return MEO_OK;
}

fn demo_chart() -> MpChart* {
  var c: MpChart* = mp_chart_new(MP_LINE);
  if (c == 0) { return 0; }
  mp_chart_set_title(c, "Sensor readings (MeoDB)");
  mp_chart_set_x_label(c, "since start");
  mp_chart_set_y_label(c, "deg C");
  mp_chart_set_x_format(c, MP_FMT_TIME);
  mp_chart_set_y_range(c, 15.0, 33.0);
  mp_chart_keep(c, 4096);
  mp_chart_window(c, 30.0);
  mp_chart_series(c, "sensor 0");
  mp_chart_series(c, "sensor 1");
  mp_chart_series(c, "sensor 2");
  if (mp_chart_error(c) != MP_OK) {
    mp_chart_free(c);
    return 0;
  }
  return c;
}

fn demo_arg_is(a: cstring, s: string) -> bool {
  return str_from_cstr(a) == s;
}

fn demo_print_term(d: Demo*, out: MpBuf*) -> int32 {
  var rc: int32 = mp_chart_term(d->c, DEMO_TERM_COLS, DEMO_TERM_ROWS,
    MP_TERM_BRAILLE | MP_TERM_PLAIN, out);
  if (rc == MP_OK) { print(mp_buf_str(out)); }
  return rc;
}

// Frees whatever was set up; every field may still be 0.
fn demo_free(d: Demo*) {
  if (d == 0) { return; }
  if (d->w != 0) { mp_meo_watch_free(d->w); }
  if (d->db != 0) { meo_db_close(d->db); }
  if (d->feed != 0) { meo_feed_free(d->feed); }
  if (d->c != 0) { mp_chart_free(d->c); }
  free(d);
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var run_for: int32 = 10;
  var db_path: string = "build/integrations/meodb/live.db";
  var svg: string = "build/integrations/meodb/live.svg";
  var first_svg: string = "build/integrations/meodb/live.first.svg";
  var retain: int64 = 20;
  var quiet: bool = false;
  var i: int32 = 1;
  while (i < argc) {
    var more: bool = i + 1 < argc;
    if (demo_arg_is(argv[i], "--quiet")) {
      quiet = true;
    } else if (more && demo_arg_is(argv[i], "--run-for")) {
      var v: int64 = str_to_i64_or(str_from_cstr(argv[i + 1]), 10);
      if (v > 0 && v < 86400) { run_for = (int32)v; }
      i = i + 1;
    } else if (more && demo_arg_is(argv[i], "--retain")) {
      var r: int64 = str_to_i64_or(str_from_cstr(argv[i + 1]), 20);
      if (r > 0 && r < 86400) { retain = r; }
      i = i + 1;
    } else if (more && demo_arg_is(argv[i], "--db")) {
      db_path = str_from_cstr(argv[i + 1]);
      i = i + 1;
    } else if (more && demo_arg_is(argv[i], "--svg")) {
      svg = str_from_cstr(argv[i + 1]);
      i = i + 1;
    } else if (more && demo_arg_is(argv[i], "--first-svg")) {
      first_svg = str_from_cstr(argv[i + 1]);
      i = i + 1;
    }
    i = i + 1;
  }

  var d: Demo* = new Demo;
  if (d == 0) { return 1; }
  memset((rawptr)d, 0, sizeof(Demo));
  d->retain_s = (float64)retain;
  demo_remove(db_path);
  var rc: int32 = meo_db_open(db_path,
    MEO_OPEN_CREATE | MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_WAL, 0, &d->db);
  if (rc != MEO_OK || demo_schema(d->db) != MEO_OK) {
    println("cannot create the database ({rc})");
    demo_free(d);
    return 1;
  }
  d->feed = meo_feed_new(4096);
  d->c = demo_chart();
  if (d->feed == 0 || d->c == 0 || meo_feed_attach(d->db->pager, d->feed) != MEO_OK) {
    println("setup failed");
    demo_free(d);
    return 1;
  }
  d->w = mp_meo_watch_new(d->feed);
  d->table_id = (uint32)mp_meo_table_id(d->db, "readings");
  if (d->w == 0 ||
      mp_meo_watch_xy(d->w, d->db, "readings", "t", "deg", "sensor", d->c) != MP_OK) {
    println("watch failed");
    demo_free(d);
    return 1;
  }
  d->t0_us = meo_clock_realtime_us();
  var tbuf: MpBuf* = mp_buf_new(16384);
  var writer: int64 = CreateThread(0, 0, &demo_writer, (cstring)d, 0, 0);
  if (writer == 0 || tbuf == 0) {
    println("writer thread failed");
    mp_buf_free(tbuf);
    demo_free(d);
    return 1;
  }

  var fail: int32 = 0;
  var ticks_per_s: int32 = (int32)(1000 / (int32)DEMO_POLL_MS);
  var total: int32 = run_for * ticks_per_s;
  var tick: int32 = 0;
  var frames: int32 = 0;
  while (tick < total) {
    thread_sleep_ms(DEMO_POLL_MS);
    if (mp_meo_poll(d->w) < 0) { fail = 2; }
    tick = tick + 1;
    if (tick % ticks_per_s == 0) {
      mp_meo_set_subtitle(d->w, d->table_id, d->c);
      if (mp_chart_save_svg(d->c, 640.0, 400.0, svg) != MP_OK) { fail = 2; }
      if (frames == 0 && mp_chart_save_svg(d->c, 640.0, 400.0, first_svg) != MP_OK) {
        fail = 2;
      }
      frames = frames + 1;
      if (!quiet) {
        println("--- second {frames} ---");
        if (demo_print_term(d, tbuf) != MP_OK) { fail = 2; }
      }
    }
  }

  atomic_exchange_i32(&d->stop, 1);
  thread_join_infinite(writer);
  thread_close(writer);
  if (mp_meo_poll(d->w) < 0) { fail = 2; }
  mp_meo_set_subtitle(d->w, d->table_id, d->c);
  if (mp_chart_save_svg(d->c, 640.0, 400.0, svg) != MP_OK) { fail = 2; }
  if (demo_print_term(d, tbuf) != MP_OK) { fail = 2; }

  var st: MpMeoTableStats;
  mp_meo_table_stats(d->w, d->table_id, &st);
  var ws: MpMeoWatchStats;
  mp_meo_watch_stats(d->w, &ws);
  if (d->writer_err != 0 || st.meo_error != MEO_OK) { fail = 2; }
  var rows: int64 = mp_chart_len(d->c, 0) + mp_chart_len(d->c, 1) + mp_chart_len(d->c, 2);
  var pager_seq: uint64 = meo_pager_commit_seq(d->db->pager);
  println("subtitle: {d->c->subtitle}");
  print("commits={d->commits} purges={d->purges} pager_commit_seq={(int64)pager_seq} ");
  print("samples={rows} fast={st.fast_count} reloads={st.reload_count} deletes={st.delete_count} ");
  print("polls={ws.polls} events={ws.events} gaps={ws.gaps} ");
  println("last_commit={(int64)st.last_commit_seq} seq={mp_chart_seq(d->c)} exit={fail}");

  mp_buf_free(tbuf);
  demo_free(d);
  return fail;
}
